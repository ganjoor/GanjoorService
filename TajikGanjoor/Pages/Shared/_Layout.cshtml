<!DOCTYPE html>
<html lang="tg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#6b3f1d" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tajik-ganjoor.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TajikGanjoor.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="tg-breadcrumb">
                @Html.Raw(ViewData["BreadCrumpUrls"])
            </div>
            <div class="flex-fill"></div>
            <form class="d-flex" action="/" method="get" id="searchhorm">
                <input type="search" class="form-control" placeholder="ҷустуҷӯ" aria-label="ҷустуҷӯ" name="s" id="s" value="@Model.Query">
            </form>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        @if (!string.IsNullOrEmpty(ViewData["PreviousUrl"]?.ToString()) || !string.IsNullOrEmpty(ViewData["NextUrl"]?.ToString()))
        {
            <nav class="tg-poem-nav">
                @if (!string.IsNullOrEmpty(ViewData["PreviousUrl"]?.ToString()))
                {
                    <a class="tg-poem-nav-link tg-poem-nav-prev" href="@ViewData["PreviousUrl"]" title="@ViewData["PreviousTitle"]">
                        <span class="tg-poem-nav-arrow">←</span>
                        <span class="tg-poem-nav-text">
                            <span class="tg-poem-nav-caption">қаблӣ</span>
                            <span class="tg-poem-nav-title">@ViewData["PreviousTitle"]</span>
                        </span>
                    </a>
                }
                else
                {
                    <span></span>
                }
                @if (!string.IsNullOrEmpty(ViewData["NextUrl"]?.ToString()))
                {
                    <a class="tg-poem-nav-link tg-poem-nav-next" href="@ViewData["NextUrl"]" title="@ViewData["NextTitle"]">
                        <span class="tg-poem-nav-text">
                            <span class="tg-poem-nav-caption">баъдӣ</span>
                            <span class="tg-poem-nav-title">@ViewData["NextTitle"]</span>
                        </span>
                        <span class="tg-poem-nav-arrow">→</span>
                    </a>
                }
            </nav>
        }
    </div>

    <footer class="border-top footer text-muted">
        <span>Ба неруии <a href="http://persian-tajik.ir/FarsiTotajiki.aspx" target="_blank">пиршяни тоҷик</a></span>
        <span><a href="@ViewData["GoogleTranslateLink"]" target="_blank">Дар ганҷури форсӣ</a></span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)


    @if (ViewData["TrackingScript"] != null && !string.IsNullOrEmpty(ViewData["TrackingScript"].ToString()))
    {
        @Html.Raw(ViewData["TrackingScript"])
    }

</body>
</html>