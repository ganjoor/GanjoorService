@page
@model GanjooRazor.Areas.Admin.Pages.ReviewPersonRelationEditsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using DNTPersianUtils.Core
@using RMuseum.Models.Ganjoor
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "بازبینی پیشنهادهای نسبت‌های خویشاوندی";

    string RelationTypeName(PersonRelationType t)
    {
        switch (t)
        {
            case PersonRelationType.Parent: return "پدر/مادر و فرزند";
            case PersonRelationType.Sibling: return "خواهر/برادر";
            case PersonRelationType.Spouse: return "همسر";
            case PersonRelationType.Ancestor: return "نیا و نواده";
            default: return t.ToString();
        }
    }

    string AffiliationTypeName(PersonAffiliationType t)
    {
        switch (t)
        {
            case PersonAffiliationType.Minister: return "وزیر/کارگزار";
            case PersonAffiliationType.Advisor: return "مشاور";
            case PersonAffiliationType.Courtier: return "درباری/همراه";
            case PersonAffiliationType.Patron: return "حامی";
            case PersonAffiliationType.Ally: return "متحد";
            case PersonAffiliationType.Rival: return "رقیب";
            case PersonAffiliationType.Servant: return "خدمتگزار";
            case PersonAffiliationType.Companion: return "همدم";
            case PersonAffiliationType.Successor: return "جانشین";
            case PersonAffiliationType.Panegyrized: return "مدح‌گو";
            case PersonAffiliationType.Satirized: return "هجوگو";
            case PersonAffiliationType.MilitaryCommander: return "سردار";
            case PersonAffiliationType.Champion: return "پهلوان";
            case PersonAffiliationType.Contemporary: return "هم‌عصر";
            case PersonAffiliationType.Killer: return "قاتل";
            case PersonAffiliationType.Other: return "نوع دیگر";
            default: return t.ToString();
        }
    }

    // Modify only: highlight a row whose current and suggested text differ (unchanged rows recede)
    string RowClass(bool isModify, string oldText, string newText)
    {
        if (!isModify) { return ""; }
        return (oldText ?? "").Trim() != (newText ?? "").Trim() ? "up-diff-row" : "up-same-row";
    }

    string ActionName(PersonRelationSuggestionAction a)
    {
        switch (a)
        {
            case PersonRelationSuggestionAction.Add: return "افزودن نسبت جدید";
            case PersonRelationSuggestionAction.Modify: return "ویرایش نسبت موجود";
            case PersonRelationSuggestionAction.Remove: return "حذف نسبت موجود";
            case PersonRelationSuggestionAction.AddEvidence: return "افزودن مستند (به نسبت یا وابستگی)";
            case PersonRelationSuggestionAction.RemoveEvidence: return "حذف مستند (از نسبت یا وابستگی)";
            default: return a.ToString();
        }
    }
}

<div class="up-page-header">
    <h1>@ViewData["Title"]</h1>
</div>

@if (!string.IsNullOrEmpty(Model.FatalError))
{
    <div class="up-alert up-alert--danger">@Model.FatalError</div>
}
else if (Model.Suggestion == null)
{
    <partial name="_EmptyState" model="@("پیشنهاد ویرایشی وجود ندارد.")" />
}
else
{
    var s = Model.Suggestion;
    bool isModify = s.Action == PersonRelationSuggestionAction.Modify;

    <p>
        <span class="up-badge">@ActionName(s.Action)</span>
        <span class="up-badge">@(s.Kind == PersonRelationSuggestionKind.Affiliation ? "وابستگی غیرخویشاوندی" : "نسبت خویشاوندی")</span>
    </p>

    <table>
        <tr>
            <td>پیشنهاد دهنده:</td>
            <td>
                <a href="/user/edits/?allusers=1&userid=@s.UserId" target="_blank">@(s.User != null ? s.User.NickName : s.UserId.ToString())</a>
                — @s.Date.ToFriendlyPersianDateTextify()
            </td>
        </tr>
        @if (!string.IsNullOrEmpty(s.SuggestionNote))
        {
            <tr>
                <td>یادداشت پیشنهاددهنده:</td>
                <td>@s.SuggestionNote</td>
            </tr>
        }
    </table>

    @if (s.Action == PersonRelationSuggestionAction.Remove)
    {
        <div class="up-alert up-alert--danger">
            <strong>این پیشنهاد درخواست حذف نسبت زیر است:</strong>
        </div>
    }

    <table class="up-table">
        <thead>
            <tr>
                <th></th>
                <th>@(s.Action == PersonRelationSuggestionAction.Remove || s.Action == PersonRelationSuggestionAction.Modify || s.Action == PersonRelationSuggestionAction.AddEvidence || s.Action == PersonRelationSuggestionAction.RemoveEvidence ? "مقدار فعلی" : "پیشنهاد")</th>
                @if (s.Action == PersonRelationSuggestionAction.Modify)
                {
                    <th>پیشنهاد</th>
                }
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>طرف اول</td>
                <td>
                    <a role="button" href="javascript:void(0)" onclick="PersonWindow.open(@s.Person1Id)" class="up-btn up-btn--ghost up-btn--sm">@(s.Person1 != null ? s.Person1.Name : s.Person1Id.ToString())</a>
                    @* a bare name/id is not enough to tell two same-named people apart (e.g. the
                       Shahnameh's several پشنگ‌ها) - this family-tree shortcut lets the moderator
                       confirm it is the exact person the suggester meant, same as the 🌳 shortcut
                       already offered to the suggester themselves when picking this person. *@
                    <a role="button" href="javascript:void(0)" onclick="FamilyTreeWindow.open(@s.Person1Id)" class="up-icon-btn" title="مشاهدهٔ شجره‌نامهٔ این شخصیت" aria-label="مشاهدهٔ شجره‌نامهٔ این شخصیت">🌳</a>
                </td>
                @if (s.Action == PersonRelationSuggestionAction.Modify)
                {
                    var newFirstId = s.ReverseDirection ? s.Person2Id : s.Person1Id;
                    var newFirstName = s.ReverseDirection ? (s.Person2 != null ? s.Person2.Name : s.Person2Id.ToString()) : (s.Person1 != null ? s.Person1.Name : s.Person1Id.ToString());
                    <td>
                        <a role="button" href="javascript:void(0)" onclick="PersonWindow.open(@newFirstId)" class="up-btn up-btn--ghost up-btn--sm">@newFirstName</a>
                        <a role="button" href="javascript:void(0)" onclick="FamilyTreeWindow.open(@newFirstId)" class="up-icon-btn" title="مشاهدهٔ شجره‌نامهٔ این شخصیت" aria-label="مشاهدهٔ شجره‌نامهٔ این شخصیت">🌳</a>
                        @if (s.ReverseDirection) { <span class="up-diff-badge">جهت برعکس می‌شود</span> }
                    </td>
                }
            </tr>
            <tr>
                <td>طرف دوم</td>
                <td>
                    <a role="button" href="javascript:void(0)" onclick="PersonWindow.open(@s.Person2Id)" class="up-btn up-btn--ghost up-btn--sm">@(s.Person2 != null ? s.Person2.Name : s.Person2Id.ToString())</a>
                    <a role="button" href="javascript:void(0)" onclick="FamilyTreeWindow.open(@s.Person2Id)" class="up-icon-btn" title="مشاهدهٔ شجره‌نامهٔ این شخصیت" aria-label="مشاهدهٔ شجره‌نامهٔ این شخصیت">🌳</a>
                </td>
                @if (s.Action == PersonRelationSuggestionAction.Modify)
                {
                    var newSecondId = s.ReverseDirection ? s.Person1Id : s.Person2Id;
                    var newSecondName = s.ReverseDirection ? (s.Person1 != null ? s.Person1.Name : s.Person1Id.ToString()) : (s.Person2 != null ? s.Person2.Name : s.Person2Id.ToString());
                    <td>
                        <a role="button" href="javascript:void(0)" onclick="PersonWindow.open(@newSecondId)" class="up-btn up-btn--ghost up-btn--sm">@newSecondName</a>
                        <a role="button" href="javascript:void(0)" onclick="FamilyTreeWindow.open(@newSecondId)" class="up-icon-btn" title="مشاهدهٔ شجره‌نامهٔ این شخصیت" aria-label="مشاهدهٔ شجره‌نامهٔ این شخصیت">🌳</a>
                        @if (s.ReverseDirection) { <span class="up-diff-badge">جهت برعکس می‌شود</span> }
                    </td>
                }
            </tr>
            @if (s.Kind == PersonRelationSuggestionKind.Affiliation)
            {
                var affOld = s.Action == PersonRelationSuggestionAction.Modify && s.ExistingAffiliation != null ? AffiliationTypeName(s.ExistingAffiliation.AffiliationType) : AffiliationTypeName(s.SuggestedAffiliationType ?? PersonAffiliationType.Other);
                var affNew = AffiliationTypeName(s.SuggestedAffiliationType ?? PersonAffiliationType.Other);
                <tr class="@RowClass(isModify, affOld, affNew)">
                    <td>نوع وابستگی @if (isModify && affOld != affNew) { <span class="up-diff-badge">تغییر کرد</span> }</td>
                    <td>@affOld</td>
                    @if (s.Action == PersonRelationSuggestionAction.Modify)
                    {
                        <td>@affNew</td>
                    }
                </tr>
            }
            else
            {
                var relOld = s.Action == PersonRelationSuggestionAction.Modify && s.ExistingRelation != null ? RelationTypeName(s.ExistingRelation.RelationType) : RelationTypeName(s.SuggestedRelationType);
                var relNew = RelationTypeName(s.SuggestedRelationType);
                var degOld = (s.Action == PersonRelationSuggestionAction.Modify && s.ExistingRelation != null ? s.ExistingRelation.DegreeHint : s.SuggestedDegreeHint)?.ToString().ToPersianNumbers();
                var degNew = s.SuggestedDegreeHint?.ToString().ToPersianNumbers();
                <tr class="@RowClass(isModify, relOld, relNew)">
                    <td>نوع نسبت @if (isModify && relOld != relNew) { <span class="up-diff-badge">تغییر کرد</span> }</td>
                    <td>@relOld</td>
                    @if (s.Action == PersonRelationSuggestionAction.Modify)
                    {
                        <td>@relNew</td>
                    }
                </tr>
                <tr class="@RowClass(isModify, degOld, degNew)">
                    <td>درجه (در نیا/نواده) @if (isModify && (degOld ?? "") != (degNew ?? "")) { <span class="up-diff-badge">تغییر کرد</span> }</td>
                    <td>@degOld</td>
                    @if (s.Action == PersonRelationSuggestionAction.Modify)
                    {
                        <td>@degNew</td>
                    }
                </tr>
            }
            @{
                var noteOld = isModify
                    ? (s.Kind == PersonRelationSuggestionKind.Affiliation ? s.ExistingAffiliation?.Note : s.ExistingRelation?.Note)
                    : s.SuggestedNote;
                bool noteChanged = isModify && (noteOld ?? "").Trim() != (s.SuggestedNote ?? "").Trim();
            }
            <tr class="@RowClass(isModify, noteOld, s.SuggestedNote)" data-diff="@(noteChanged ? "1" : null)">
                <td>یادداشت @if (noteChanged) { <span class="up-diff-badge">تغییر کرد</span> }</td>
                <td class="diff-old-cell"><small>@noteOld</small></td>
                @if (isModify)
                {
                    <td class="diff-new-cell"><small>@s.SuggestedNote</small></td>
                }
            </tr>
        </tbody>
    </table>

    @if (!string.IsNullOrEmpty(s.EvidenceCoupletText) || s.EvidencePoemId != null)
    {
        <div class="up-card">
            <strong>@(s.Action == PersonRelationSuggestionAction.RemoveEvidence ? "مستندی که قرار است حذف شود:" : "مستند پیشنهادی (بیتی که این " + (s.Kind == PersonRelationSuggestionKind.Affiliation ? "وابستگی" : "نسبت") + " را بیان می‌کند):")</strong>
            <p>@s.EvidenceCoupletText</p>
            @if (s.EvidencePoemId != null)
            {
                <a href="/?p=@s.EvidencePoemId#bn@((s.EvidenceCoupletIndex ?? 0) + 1)" target="_blank" class="up-btn up-btn--ghost up-btn--sm">مشاهدهٔ شعر (بیت @(((s.EvidenceCoupletIndex ?? 0) + 1).ToPersianNumbers()))</a>
            }
        </div>
    }

    <script src="/js/textdiff.js"></script>

    <div class="spacer">&nbsp;</div>

    <table>
        <tr>
            <td>
                <label><input type="radio" name="review_result" id="review_result_Approved" value="Approved" checked="checked" /> تأیید</label>
                &nbsp;
                <label><input type="radio" name="review_result" id="review_result_Rejected" value="Rejected" /> رد</label>
            </td>
        </tr>
        <tr>
            <td>
                یادداشت برای پیشنهاددهنده:<br />
                <textarea id="review_note" rows="3" cols="60"></textarea>
            </td>
        </tr>
        <tr>
            <td>
                <a role="button" id="moderatepersonrelationedit" class="up-btn up-btn--success up-btn--block" onclick="moderatePersonRelationEditSuggestion(@s.Id)">بررسی</a>
            </td>
            <td>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" name="next" id="next" class="up-btn up-btn--ghost up-btn--block">بعدی</button>
                </form>
            </td>
        </tr>
    </table>

    <p><small>@((Model.Skip + 1).ToPersianNumbers()) از @Model.TotalCount.ToPersianNumbers()</small></p>

    <script>
        function moderatePersonRelationEditSuggestion(id) {
            $('#moderatepersonrelationedit').hide();

            var url = '?handler=Moderate';

            var pms = {};
            pms.id = id;
            pms.result = $('input[name=review_result]:checked').val();
            pms.reviewNote = $('#review_note').val();

            $.ajax({
                type: "POST",
                url: url,
                data: JSON.stringify(pms),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function () {
                    location.reload(true);
                },
                error: function (e) {
                    upShowError(e.responseText || 'خطا رخ داد.');
                    $('#moderatepersonrelationedit').show();
                }
            });
        }
    </script>
}

<p><a href="/User/RelationsWithoutEvidence">فهرست نسبت‌های خویشاوندی بدون مستند</a> | <a href="/User/RelationsWithoutEvidence?affiliations=true">فهرست وابستگی‌های بدون مستند</a></p>
