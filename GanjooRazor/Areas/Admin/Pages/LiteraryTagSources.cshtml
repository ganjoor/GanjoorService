@page
@model GanjooRazor.Areas.Admin.Pages.LiteraryTagSourcesModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "منبع آرایه‌های واردشده";
}

<div class="up-page-header">
    <h1>@ViewData["Title"]</h1>
</div>

@if (!string.IsNullOrEmpty(Model.LastMessage))
{
    <div class="up-alert up-alert--info">@Model.LastMessage</div>
}

<div class="up-card">
    <p class="up-hint">هر آرایه‌ای که از یک پیکره یا کتاب وارد شود با «شناسه» منبعش (همان مقدار <span dir="ltr">OriginRef</span> در فایل درون‌ریزی) شناخته می‌شود. اینجا اطلاعات نمایشی منبع را ثبت کنید تا خوانندگان با کلیک روی نشان منبع کنار هر آرایه ببینند.</p>
    <div class="up-form-actions">
        <a role="button" class="up-btn up-btn--ghost" onclick="lsAdd(null)">➕ منبع تازه</a>
        <a role="button" class="up-btn up-btn--ghost" onclick="lsAdd(lsCorpusTemplate)">قالب پیکرهٔ فارسی</a>
    </div>
</div>

<div id="ls-new"></div>
<div id="ls-list"></div>

<script>
    var lsSources = @Html.Raw(Model.SourcesJson);
    var lsCorpusTemplate = {"key": "persian-literary-corpus-1.0.0 (MIT)", "name": "پیکره", "title": "A Corpus of Persian Literary Text (نسخهٔ ۱٫۰٫۰، ۱۱ مه ۲۰۲۳)", "authors": "Shahab Raji\nMalihe Alikhani (University of Pittsburgh)\nGerard de Melo (University of Potsdam)\nMatthew Stone (Rutgers University)", "url": "https://doi.org/10.5281/zenodo.7923612", "description": "بخشی از آرایه‌های ادبی ثبت‌شده برای غزل‌های حافظ در گنجور از حاشیه‌نویسی‌های بلاغی «پیکرهٔ متن ادبی فارسی» وارد شده است (تشبیه، استعاره، کنایه، مجاز، ایهام و جناس).\n\nبرچسب‌های آزاد پیکره به ساختار آرایه‌های گنجور (آرایه، جایگاه‌ها، مفهوم‌ها و جای واژه‌ها در مصرع) تبدیل شده‌اند. این تبدیل کار گنجور است و ممکن است خطا داشته باشد؛ هر کاربر می‌تواند از ویرایشگر شعر اصلاح پیشنهاد دهد.", "license": "MIT", "licenseText": "Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the \"Software\"), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE."};

    function lsEsc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }

    function lsForm(s, idPrefix) {
        var id = s ? s.id : 0;
        var h = '<div class="up-card" id="' + idPrefix + id + '" data-id="' + id + '">';
        h += '<div class="up-field"><label>شناسه (OriginRef)</label><input type="text" class="ls-key" dir="ltr" value="' + lsEsc(s && s.key) + '" /></div>';
        h += '<div class="up-field"><label>نام کوتاه (روی نشان)</label><input type="text" class="ls-name" value="' + lsEsc(s && s.name) + '" /></div>';
        h += '<div class="up-field"><label>عنوان کامل</label><input type="text" class="ls-title" value="' + lsEsc(s && s.title) + '" /></div>';
        h += '<div class="up-field"><label>پدیدآورندگان (هر کدام در یک سطر)</label><textarea class="ls-authors" rows="3">' + lsEsc(s && s.authors) + '</textarea></div>';
        h += '<div class="up-field"><label>نشانی (مثلاً DOI)</label><input type="text" class="ls-url" dir="ltr" value="' + lsEsc(s && s.url) + '" /></div>';
        h += '<div class="up-field"><label>توضیح (بندها را با یک سطر خالی جدا کنید)</label><textarea class="ls-desc" rows="5">' + lsEsc(s && s.description) + '</textarea></div>';
        h += '<div class="up-field"><label>مجوز</label><input type="text" class="ls-license" dir="ltr" value="' + lsEsc(s && s.license) + '" /></div>';
        h += '<div class="up-field"><label>متن مجوز</label><textarea class="ls-ltext" rows="6" dir="ltr">' + lsEsc(s && s.licenseText) + '</textarea></div>';
        h += '<div class="up-form-actions"><a role="button" class="up-btn up-btn--success" onclick="lsSave(\'' + idPrefix + id + '\')">💾 ذخیره</a>';
        if (id) { h += ' <a role="button" class="up-btn up-btn--danger" onclick="lsDelete(' + id + ')">حذف</a>'; }
        h += '</div></div>';
        return h;
    }

    function lsRender() {
        var h = '';
        if (lsSources.length === 0) { h = '<p class="up-hint">هنوز منبعی ثبت نشده است.</p>'; }
        for (var i = 0; i < lsSources.length; i++) {
            var s = lsSources[i];
            h += '<details class="up-card"><summary><b>' + lsEsc(s.name) + '</b> <span class="up-hint" dir="ltr">' + lsEsc(s.key) + '</span></summary>' + lsForm(s, 'ls') + '</details>';
        }
        $('#ls-list').html(h);
    }

    function lsAdd(t) { $('#ls-new').html(lsForm(t ? $.extend({ id: 0 }, t) : null, 'lsn')); }

    function lsSave(cardId) {
        var c = $('#' + cardId);
        var src = {
            id: parseInt(c.attr('data-id'), 10) || 0,
            key: c.find('.ls-key').val(), name: c.find('.ls-name').val(), title: c.find('.ls-title').val(),
            authors: c.find('.ls-authors').val(), url: c.find('.ls-url').val(), description: c.find('.ls-desc').val(),
            license: c.find('.ls-license').val(), licenseText: c.find('.ls-ltext').val()
        };
        $.ajax({
            type: 'POST', url: '?handler=Save', data: JSON.stringify(src),
            contentType: 'application/json; charset=utf-8', dataType: 'json',
            success: function () { upToast('ذخیره شد.'); location.reload(true); },
            error: function (e) { upShowError(e.responseText || String(e)); }
        });
    }

    async function lsDelete(id) {
        var ok = await upConfirm('این منبع حذف شود؟ برچسب‌های آن می‌مانند ولی نشان منبع را از دست می‌دهند.');
        if (!ok) { return; }
        $.ajax({
            type: 'POST', url: '?handler=Delete&id=' + id,
            success: function () { location.reload(true); },
            error: function (e) { upShowError(e.responseText || String(e)); }
        });
    }

    lsRender();
</script>
