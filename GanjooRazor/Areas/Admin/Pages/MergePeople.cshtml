@page
@model GanjooRazor.Areas.Admin.Pages.MergePeopleModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "ادغام و تقسیم نامبردگان و نام‌های دیگر";
}

<div class="up-page-header">
    <h1>@ViewData["Title"]</h1>
</div>

@if (!string.IsNullOrEmpty(Model.LastMessage))
{
    <div class="up-alert up-alert--danger">@Model.LastMessage</div>
}

<datalist id="people-list">
    @foreach (var person in Model.People)
    {
        <option value="@person.Name (@person.Id)"></option>
    }
</datalist>

<script>
    function parsePersonId(text) {
        var m = /\((\d+)\)\s*$/.exec(text || '');
        if (m) return parseInt(m[1]);
        var n = parseInt(text);
        return isNaN(n) ? 0 : n;
    }

    // 👁 / 🌳 icons next to every person lookup, for whoever is currently chosen in it
    function refreshPersonIcons(input) {
        var box = document.querySelector('.person-icons[data-for="' + input.id + '"]');
        if (!box) return;
        var id = parsePersonId(input.value);
        box.innerHTML = id
            ? '<a href="javascript:void(0)" onclick="PersonWindow.open(' + id + ')" class="up-icon-btn" title="مشاهدهٔ اطلاعات این شخصیت" aria-label="مشاهدهٔ اطلاعات این شخصیت">👁</a> ' +
              '<a href="javascript:void(0)" onclick="FamilyTreeWindow.open(' + id + ')" class="up-icon-btn" title="مشاهدهٔ شجره‌نامهٔ این شخصیت" aria-label="مشاهدهٔ شجره‌نامهٔ این شخصیت">🌳</a>'
            : '';
    }
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.person-icons').forEach(function (box) {
            var input = document.getElementById(box.getAttribute('data-for'));
            if (!input) return;
            input.addEventListener('input', function () { refreshPersonIcons(input); });
            input.addEventListener('change', function () { refreshPersonIcons(input); });
        });
    });

    var aliasesOf = {
@foreach (var person in Model.People.Where(p => !string.IsNullOrEmpty(p.Aliases)))
{
        <text>        @person.Id: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(person.Aliases)),
</text>
}
    };

    async function mergePeople() {
        var sourceId = parsePersonId(document.getElementById('merge-source').value);
        var targetId = parsePersonId(document.getElementById('merge-target').value);
        if (!sourceId || !targetId || sourceId == targetId) {
            upToast('هر دو شخصیت را از فهرست انتخاب کنید (و یکی نباشند).', 'error');
            return;
        }
        var ok = await upConfirm('شخصیت «' + document.getElementById('merge-source').value + '» در «' + document.getElementById('merge-target').value + '» ادغام و حذف می‌شود. این کار قابل بازگشت نیست. ادامه می‌دهید؟');
        if (!ok) return;
        $.ajax({
            type: "POST",
            url: '?handler=Merge',
            data: { sourceId: sourceId, targetId: targetId },
            error: function (e) {
                upToast(e.responseText || 'خطا رخ داد.', 'error');
            },
            success: function (report) {
                document.getElementById('merge-report').innerText = report;
                document.getElementById('merge-source').value = '';
                upToast('انجام شد!', 'success');
            },
        });
    }

    async function splitPerson(dryRun) {
        var personId = parsePersonId(document.getElementById('split-person').value);
        var fromPoemId = parseInt(document.getElementById('split-from-poem').value);
        var fromCouplet = parseInt(document.getElementById('split-from-couplet').value);
        var toPoemText = document.getElementById('split-to-poem').value.trim();
        var toCoupletText = document.getElementById('split-to-couplet').value.trim();
        if (!personId || isNaN(fromPoemId)) {
            upToast('شخصیت را از فهرست انتخاب کنید و شمارهٔ شعر آغاز را بنویسید.', 'error');
            return;
        }
        if (!dryRun) {
            var ok = await upConfirm('شخصیت «' + document.getElementById('split-person').value + '» تقسیم می‌شود و بخشی از برچسب‌ها و نسبت‌هایش به یک شخصیت تازه می‌رود. پیشنهاد می‌شود پیش از این «بررسی بدون تغییر» را اجرا کرده باشید. ادامه می‌دهید؟');
            if (!ok) return;
        }
        var data = {
            personId: personId,
            newName: document.getElementById('split-new-name').value,
            newDescription: document.getElementById('split-new-description').value,
            fromPoemId: fromPoemId,
            fromCoupletIndex: isNaN(fromCouplet) ? 0 : fromCouplet,
            dryRun: dryRun
        };
        if (toPoemText) data.toPoemId = parseInt(toPoemText);
        if (toCoupletText) data.toCoupletIndex = parseInt(toCoupletText);
        $.ajax({
            type: "POST",
            url: '?handler=Split',
            data: data,
            error: function (e) {
                upToast(e.responseText || 'خطا رخ داد.', 'error');
            },
            success: function (report) {
                document.getElementById('split-report').innerText = report;
                upToast(dryRun ? 'بررسی انجام شد؛ چیزی تغییر نکرد.' : 'انجام شد!', 'success');
            },
        });
    }

    function loadAliases() {
        var id = parsePersonId(document.getElementById('alias-person').value);
        document.getElementById('alias-text').value = (id && aliasesOf[id]) ? aliasesOf[id] : '';
    }

    function saveAliases() {
        var id = parsePersonId(document.getElementById('alias-person').value);
        if (!id) {
            upToast('شخصیت را از فهرست انتخاب کنید.', 'error');
            return;
        }
        $.ajax({
            type: "POST",
            url: '?handler=Aliases',
            data: { id: id, aliases: document.getElementById('alias-text').value },
            error: function (e) {
                upToast(e.responseText || 'خطا رخ داد.', 'error');
            },
            success: function (aliases) {
                aliasesOf[id] = aliases;
                document.getElementById('alias-text').value = aliases;
                upToast('ذخیره شد.', 'success');
            },
        });
    }
</script>

<h2>ادغام دو شخصیت تکراری</h2>
<p>همهٔ برچسب‌های شعر، روابط، مستندها و پیشنهادهای در انتظار شخصیت «تکراری» به شخصیت «ماندگار» منتقل می‌شود، نام شخصیت تکراری به نام‌های دیگر شخصیت ماندگار افزوده می‌شود و شخصیت تکراری حذف می‌گردد.</p>
<table>
    <tr>
        <td><span class="inputlabel">شخصیت تکراری (حذف می‌شود)</span></td>
        <td><input type="text" id="merge-source" list="people-list" size="40" autocomplete="off" /> <span class="person-icons" data-for="merge-source"></span></td>
    </tr>
    <tr>
        <td><span class="inputlabel">شخصیت ماندگار</span></td>
        <td><input type="text" id="merge-target" list="people-list" size="40" autocomplete="off" /> <span class="person-icons" data-for="merge-target"></span></td>
    </tr>
    <tr>
        <td colspan="2"><p><a role="button" onclick="mergePeople()" class="up-btn up-btn--danger up-btn--sm">ادغام</a></p></td>
    </tr>
</table>
<p id="merge-report"></p>

<h2>تقسیم یک شخصیت به دو نفر همنام</h2>
<p>وقتی یک شخصیت در واقع دو نفر با یک نام است (مثلاً چند «شاپور» در شاهنامه)، شخصیتی تازه ساخته می‌شود و برچسب‌ها، نسبت‌ها و وابستگی‌های او از «شعر و بیت آغاز» تا «شعر و بیت پایان» (در همان کتاب) به شخصیت تازه می‌رود. اگر پایان را خالی بگذارید تا پایان کتاب است. نسبتی که مستند آن در هر دو بخش است برای شخصیت تازه کپی می‌شود و نسبت بدون مستند نزد شخصیت اصلی می‌ماند. ابتدا «بررسی بدون تغییر» را اجرا کنید.</p>
<table>
    <tr>
        <td><span class="inputlabel">شخصیت</span></td>
        <td><input type="text" id="split-person" list="people-list" size="40" autocomplete="off" /> <span class="person-icons" data-for="split-person"></span></td>
    </tr>
    <tr>
        <td><span class="inputlabel">نام شخصیت تازه (خالی = همان نام)</span></td>
        <td><input type="text" id="split-new-name" size="40" autocomplete="off" /></td>
    </tr>
    <tr>
        <td><span class="inputlabel">توضیح شخصیت تازه</span></td>
        <td><input type="text" id="split-new-description" size="60" autocomplete="off" /></td>
    </tr>
    <tr>
        <td><span class="inputlabel">آغاز: شمارهٔ شعر و شمارهٔ بیت</span></td>
        <td><input type="number" id="split-from-poem" style="width:8em" /> <input type="number" id="split-from-couplet" value="0" min="0" style="width:6em" /></td>
    </tr>
    <tr>
        <td><span class="inputlabel">پایان (اختیاری): شمارهٔ شعر و شمارهٔ بیت</span></td>
        <td><input type="number" id="split-to-poem" style="width:8em" /> <input type="number" id="split-to-couplet" min="0" style="width:6em" /></td>
    </tr>
    <tr>
        <td colspan="2"><p>
            <a role="button" onclick="splitPerson(true)" class="up-btn up-btn--ghost up-btn--sm">بررسی بدون تغییر</a>
            <a role="button" onclick="splitPerson(false)" class="up-btn up-btn--danger up-btn--sm">تقسیم</a>
        </p></td>
    </tr>
</table>
<p id="split-report"></p>

<h2>نام‌های دیگر یک شخصیت</h2>
<p>نام‌ها، لقب‌ها و املاهای دیگر را با «،» از هم جدا کنید (مثلاً برای رستم: تهمتن، رستم دستان، پور زال). کار هوش مصنوعی از این نام‌ها برای تشخیص شخصیت استفاده می‌کند.</p>
<table>
    <tr>
        <td><span class="inputlabel">شخصیت</span></td>
        <td><input type="text" id="alias-person" list="people-list" size="40" autocomplete="off" onchange="loadAliases()" /> <span class="person-icons" data-for="alias-person"></span></td>
    </tr>
    <tr>
        <td><span class="inputlabel">نام‌های دیگر</span></td>
        <td><textarea id="alias-text" rows="3" cols="60"></textarea></td>
    </tr>
    <tr>
        <td colspan="2"><p><a role="button" onclick="saveAliases()" class="up-btn up-btn--ghost up-btn--sm">ذخیره</a></p></td>
    </tr>
</table>
