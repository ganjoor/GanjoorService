                    <span class="up-badge up-badge--danger">اضافه دارد</span>
                }
                else
                {
                    <text>اضافه ندارد</text>
                }
            </td>
        </tr>
        <tr>
            <td colspan="2">
                @if (Model.Correction.VerseOrderText.Any(v => v.OriginalText != v.Text))
                {
