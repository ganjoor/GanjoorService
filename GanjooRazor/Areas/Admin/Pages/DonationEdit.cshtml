@page
@model GanjooRazor.Areas.Admin.Pages.DonationEditModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "ویرایش کمک مالی";
}

<h1>@ViewData["Title"]</h1>

<p>
    @Model.LastMessage
</p>

@if (Model.Donation != null)
{
    <form method="post">
        @Html.AntiForgeryToken()

        <table>
            <tr>
                <td>تاریخ:</td>
                <td><input type="date" asp-for="Donation.Date" /> </td>
            </tr>
            <tr>
                <td>اهدا کننده:</td>
                <td><input size="50" asp-for="Donation.Description" /> </td>
            </tr>
            <tr>
                <td>محل هزینه / مصرف:</td>
                <td>
                    <textarea rows="3" cols="60" id="expDesc" asp-for="Donation.ExpenditureDesc"></textarea>
                    <br />
                    <a role="button" class="up-btn up-btn--ghost" onclick="document.getElementById('expDesc').value='این اعتبار مصرف شده است.'">علامت‌گذاری به عنوان مصرف‌شده</a>
                    <a role="button" class="up-btn up-btn--ghost" onclick="document.getElementById('expDesc').value=''">پاک کردن (هنوز هزینه نشده)</a>
                    <p class="up-hint">متن این فیلد در ستون «محل هزینه» صفحهٔ /donate نمایش داده می‌شود؛ اگر خالی باشد «هنوز هزینه نشده.» نوشته می‌شود.</p>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <input type="submit" value="ویرایش" />
                </td>
            </tr>
        </table>

    </form>
}



