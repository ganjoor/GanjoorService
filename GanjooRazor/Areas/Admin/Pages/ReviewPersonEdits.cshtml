@page
@model GanjooRazor.Areas.Admin.Pages.ReviewPersonEditsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using DNTPersianUtils.Core
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "بازبینی پیشنهادهای ویرایش نامبردگان";
}

<div class="up-page-header">
    <h1>@ViewData["Title"]</h1>
</div>

@if (!string.IsNullOrEmpty(Model.FatalError))
{
    <div class="up-alert up-alert--danger">@Model.FatalError</div>
}
else if (Model.Suggestion == null)
{
    <partial name="_EmptyState" model="@("پیشنهاد ویرایشی وجود ندارد.")" />
}
else
{
    var s = Model.Suggestion;
    var p = s.Person;

    <p>
        <a role="button" href="javascript:void(0)" onclick="PersonWindow.open(@p.Id)" class="up-btn up-btn--ghost up-btn--sm">@p.Name</a>
        <a role="button" href="javascript:void(0)" onclick="FamilyTreeWindow.open(@p.Id)" class="up-icon-btn" title="مشاهدهٔ شجره‌نامهٔ این شخصیت" aria-label="مشاهدهٔ شجره‌نامهٔ این شخصیت">🌳</a>
    </p>

    <table>
        <tr>
            <td>پیشنهاد دهنده:</td>
            <td>
                <a href="/user/edits/?allusers=1&userid=@s.UserId" target="_blank">@(s.User != null ? s.User.NickName : s.UserId.ToString())</a>
                — @s.Date.ToFriendlyPersianDateTextify()
            </td>
        </tr>
        @if (!string.IsNullOrEmpty(s.SuggestionNote))
        {
            <tr>
                <td>یادداشت پیشنهاددهنده:</td>
                <td>@s.SuggestionNote</td>
            </tr>
        }
    </table>

    @if (s.SuggestedForDeletion)
    {
        <div class="up-alert up-alert--danger">
            <strong>این پیشنهاد درخواست حذف کامل نامبردۀ «@p.Name» است.</strong>
            در صورت تأیید، این نامبرده و همهٔ نسبت‌های خویشاوندی/وابستگی‌های آن حذف خواهد شد و هرگونه پیشنهاد در حال بررسی مرتبط با آن‌ها به طور خودکار رد می‌شود. فیلدهای زیر در این حالت نادیده گرفته می‌شوند.
        </div>
    }
    else
    {
        // (label, current, suggested, show a word-level diff for the text of this row)
            var diffRows = new List<(string Label, string Old, string New, bool WordDiff)>
            {
                ("نام", p.Name, s.SuggestedName, true),
                ("نشانی ویکی‌پدیا", p.WikiUrl, s.SuggestedWikiUrl, true),
                ("سال تولد (قمری)", p.BirthYearInLHijri == 0 ? "" : p.BirthYearInLHijri.ToPersianNumbers(), s.SuggestedBirthYearInLHijri == 0 ? "" : s.SuggestedBirthYearInLHijri.ToPersianNumbers(), false),
                ("تاریخ تولد مستند است", p.ValidBirthDate ? "بله" : "خیر", s.SuggestedValidBirthDate ? "بله" : "خیر", false),
                ("زادگاه", Model.LocationName(p.BirthLocationId), s.SuggestedBirthLocation != null ? s.SuggestedBirthLocation.Name : "", false),
                ("سال وفات (قمری)", p.DeathYearInLHijri == 0 ? "" : p.DeathYearInLHijri.ToPersianNumbers(), s.SuggestedDeathYearInLHijri == 0 ? "" : s.SuggestedDeathYearInLHijri.ToPersianNumbers(), false),
                ("تاریخ وفات مستند است", p.ValidDeathDate ? "بله" : "خیر", s.SuggestedValidDeathDate ? "بله" : "خیر", false),
                ("آرامگاه", Model.LocationName(p.DeathLocationId), s.SuggestedDeathLocation != null ? s.SuggestedDeathLocation.Name : "", false),
                ("عنوان تبارنامه", p.FamilyTreeCaption, s.SuggestedFamilyTreeCaption, true),
                ("درجهٔ اهمیت", Model.ImportanceLabel(p.Importance), Model.ImportanceLabel(s.SuggestedImportance), false),
                ("جنسیت", Model.GenderLabel(p.Gender), Model.GenderLabel(s.SuggestedGender), false),
                ("توضیحات", p.Description, s.SuggestedDescription, true),
            };
            int changedCount = diffRows.Count(r => (r.Old ?? "").Trim() != (r.New ?? "").Trim());
        <p class="up-hint">@(changedCount == 0 ? "هیچ فیلدی تغییر نکرده است." : $"{changedCount.ToPersianNumbers()} فیلد تغییر کرده است (ردیف‌های تغییرکرده رنگی‌اند).")</p>
        <table class="up-table">
            <thead>
                <tr>
                    <th>فیلد</th>
                    <th>مقدار فعلی</th>
                    <th>پیشنهاد</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in diffRows)
                {
                    bool changed = (r.Old ?? "").Trim() != (r.New ?? "").Trim();
                    <tr class="@(changed ? "up-diff-row" : "up-same-row")" data-diff="@(changed && r.WordDiff ? "1" : null)">
                        <td>@r.Label @if (changed) { <span class="up-diff-badge">تغییر کرد</span> }</td>
                        <td class="diff-old-cell">@r.Old</td>
                        <td class="diff-new-cell">@r.New</td>
                    </tr>
                }
            </tbody>
        </table>
        <script src="/js/textdiff.js"></script>
    }

    <div class="spacer">&nbsp;</div>

    <table>
        <tr>
            <td>
                <label><input type="radio" name="review_result" id="review_result_Approved" value="Approved" checked="checked" /> تأیید</label>
                &nbsp;
                <label><input type="radio" name="review_result" id="review_result_Rejected" value="Rejected" /> رد</label>
            </td>
        </tr>
        <tr>
            <td>
                یادداشت برای پیشنهاددهنده:<br />
                <textarea id="review_note" rows="3" cols="60"></textarea>
            </td>
        </tr>
        <tr>
            <td>
                <a role="button" id="moderatepersonedit" class="up-btn up-btn--success up-btn--block" onclick="moderatePersonEditSuggestion(@s.Id)">بررسی</a>
            </td>
            <td>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" name="next" id="next" class="up-btn up-btn--ghost up-btn--block">بعدی</button>
                </form>
            </td>
        </tr>
    </table>

    <p><small>@((Model.Skip + 1).ToPersianNumbers()) از @Model.TotalCount.ToPersianNumbers()</small></p>

    <script>
        function moderatePersonEditSuggestion(id) {
            $('#moderatepersonedit').hide();

            var url = '?handler=Moderate';

            var pms = {};
            pms.id = id;
            pms.result = $('input[name=review_result]:checked').val();
            pms.reviewNote = $('#review_note').val();

            $.ajax({
                type: "POST",
                url: url,
                data: JSON.stringify(pms),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function () {
                    location.reload(true);
                },
                error: function (e) {
                    upShowError(e.responseText || 'خطا رخ داد.');
                    $('#moderatepersonedit').show();
                }
            });
        }
    </script>
}

<p><a href="/Admin/MergePeople">ادغام نامبردگان تکراری و نام‌های دیگر</a></p>
