@page
@model GanjooRazor.Areas.User.Pages.VerseAddPageModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using DNTPersianUtils.Core
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa-IR" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>پیشنهاد اضافه شدن مصرع‌های جا افتاده</title>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <link href="/css/p8.css?version=87" rel="stylesheet" type="text/css" />
    <link href="/css/user-panel.css?version=1" rel="stylesheet" type="text/css" />
</head>
<body>
    <div id="fa" class="up-shell" style="max-width:640px;margin:0 auto;padding:var(--up-space-4);">
        <div id="hdr" class="up-text-center" style="margin-bottom:var(--up-space-4);">
            <a href="/" title="گنجور"><img src="/image/gdap.png" alt="گنجور" style="width:auto;margin:auto;" /></a>
        </div>
        @if (!string.IsNullOrEmpty(Model.LastError))
        {
            <div class="up-alert up-alert--danger up-text-center">@Model.LastError</div>
        }
        else if (!Model.LoggedIn)
        {
            <div class="up-alert up-alert--warning up-text-center">
                <p>برای ثبت خطا در خوانش‌ها لازم است ابتدا با نام کاربری خود وارد گنجور شوید.</p>
                <p><a href=@Html.Raw($"/login/?redirect=/User/SuggestNewVerses?id={Model.PageInformation.Id}") class="up-btn up-btn--primary">ورود به گنجور</a></p>
            </div>
        }
        else
        {
            <div class="up-page-header">
                <h1 style="font-size:1.2rem;">پیشنهاد اضافه شدن مصرع‌های جا افتاده</h1>
            </div>
            @if (Model.PostSuccess)
            {
                <div class="up-alert up-alert--success">درخواست شما ثبت شد. این درخواست در فرصت مناسب بررسی و در صورت تناسب با معیارهای اضافه شدن مصرع‌های جا افتاده، این متن به‌روزرسانی خواهد شد.</div>
            }
            else
            {
                <div class="up-alert up-alert--warning">لطفاً تنها در صورتی که مصرع‌های پیشنهادی مربوط به نسخهٔ دیگری است که مرجع گنجور نیست آنها را در قالب حاشیه ثبت فرمایید.</div>

                <div class="up-card">
                    <form method="post" class="up-form">
                        <div class="up-field">
                            <label asp-for="NewVerses.VOrder">مصرع‌ها قبل از کدام مصرع می‌بایست درج شوند</label>
                            <select asp-for="NewVerses.VOrder">
                                @if (Model.PageInformation.Poem.Verses.Length == 0)
                                {
                                    <option value="1">*</option>
                                }
                                else
                                {
                                    foreach (var verse in Model.PageInformation.Poem.Verses)
                                    {
                                        <option value="@verse.VOrder">@($"{(verse.CoupletIndex + 1).ToPersianNumbers()} - {verse.Text}")</option>
                                    }
                                    <option value="@(1 + Model.PageInformation.Poem.Verses.Last().VOrder)">* بعد از مصرع آخر</option>
                                }
                            </select>
                        </div>

                        <div class="up-field">
                            <label asp-for="NewVerses.Lines">مصرع‌های جا افتاده (هر مصرع یک خط)</label>
                            <textarea rows="4" asp-for="NewVerses.Lines"></textarea>
                        </div>

                        <input type="hidden" asp-for="NewVerses.PoemId" />

                        <div class="up-form-actions">
                            <button type="submit" name="submit" id="submit" class="up-btn up-btn--success up-btn--block">ثبت</button>
                        </div>
                    </form>
                </div>
            }
        }
    </div>
</body>
</html>
