            {
                <tr>
                    <td colspan="2">خلاصهٔ پیشنهادی من</td>
                </tr>
                <tr>
                    <td>
                        <p class="red-color" id="summary-lastedit-original">@Model.MyLastEdit.OriginalPoemSummary</p>
                    </td>
                    <td>
                        <p class="green-color" id="summary-lastedit-edited">@Model.MyLastEdit.PoemSummary</p>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <p id="summary-lastedit-compare">@Model.MyLastEdit.OriginalPoemSummary</p>
