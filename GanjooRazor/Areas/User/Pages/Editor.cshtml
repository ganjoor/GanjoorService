                                </td>
                                <td>
                                    <p class="green-color" id="verse@verse.Id-lastedit-edited">@verse.Text</p>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <p id="verse@verse.Id-lastedit-compare">@verse.OriginalText</p>
