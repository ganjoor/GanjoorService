@page
@model GanjooRazor.Areas.User.Pages.EditorModel
@using DNTPersianUtils.Core
@{
    Layout = "_UserPanelLayout";
    ViewData["Title"] = "ویرایشگر";
    await GanjooRazor.Utils.GanjoorSessionChecker.ApplyPermissionsToViewData(Request, Response, ViewData);
}
<div class="up-page-header">
    <h1>@ViewData["Title"]</h1>
</div>
<script>
    $(document).ready(function () {
        $('[contenteditable]').keypress(function (e) { return e.which != 13; });
    });
</script>
<script>

    function resetVersePositions(verseCount) {
        for (var i = 1; i <= verseCount; i++) {
            var newVersePosition = 'versepostion-' + i.toString();
            document.getElementById(newVersePosition).value = i % 2 == 1 ? 'Right' : 'Left';
        }
        upToast('انجام شد.');
    }

    function tarkib3VersePositions(verseCount) {
        var index = 1;
        for (var i = 1; i <= verseCount; i++) {
            var newVersePosition = 'versepostion-' + i.toString();
            document.getElementById(newVersePosition).value = index == 1 ? 'Right' : index == 2 ? 'Left' : 'CenteredVerse1';
            index++;
            if(index == 4){
                index = 1;
            }
        }
        upToast('انجام شد.');
    }

    function tarkib4VersePositions(verseCount) {
        var index = 1;
        for (var i = 1; i <= verseCount; i++) {
            var newVersePosition = 'versepostion-' + i.toString();
            document.getElementById(newVersePosition).value = index == 1 ? 'Right' : index == 2 ? 'Left' : index == 3 ? 'CenteredVerse1' : 'CenteredVerse2';
            index++;
            if(index == 5){
                index = 1;
            }
        }
        upToast('انجام شد.');
    }

    function tarkib5VersePositions(verseCount) {
        var index = 1;
        for (var i = 1; i <= verseCount; i++) {
            var newVersePosition = 'versepostion-' + i.toString();
            document.getElementById(newVersePosition).value = index == 1 || index == 3 ? 'Right' : index == 2 || index == 4 ? 'Left' : 'CenteredVerse1';
            index++;
            if(index == 6){
                index = 1;
            }
        }
        upToast('انجام شد.');
    }

    function tarkib6VersePositions(verseCount) {
        var index = 1;
        for (var i = 1; i <= verseCount; i++) {
            var newVersePosition = 'versepostion-' + i.toString();
            document.getElementById(newVersePosition).value = index == 1 || index == 3 ? 'Right' : index == 2 || index == 4 ? 'Left' : index == 5 ? 'CenteredVerse1' : 'CenteredVerse2';
            index++;
            if(index == 7){
                index = 1;
            }
        }
        upToast('انجام شد.');
    }

    function tarkib7VersePositions(verseCount) {
        var index = 1;
        for (var i = 1; i <= verseCount; i++) {
            var newVersePosition = 'versepostion-' + i.toString();
            document.getElementById(newVersePosition).value = index == 1 || index == 3 || index == 5 ? 'Right' : index == 2 || index == 4 || index == 6 ? 'Left' : 'CenteredVerse1';
            index++;
            if(index == 8){
                index = 1;
            }
        }
        upToast('انجام شد.');
    }

    function tarkib8VersePositions(verseCount) {
        var index = 1;
        for (var i = 1; i <= verseCount; i++) {
            var newVersePosition = 'versepostion-' + i.toString();
            document.getElementById(newVersePosition).value = index == 1 || index == 3 || index == 5 ? 'Right' : index == 2 || index == 4 || index == 6 ? 'Left' : index == 7 ? 'CenteredVerse1' : 'CenteredVerse2';
            index++;
            if(index == 9){
                index = 1;
            }
        }
        upToast('انجام شد.');
    }

    function toggleMarkedForDelete(vOrder) {
        var checkbox = document.getElementById('marked-for-delete-' + vOrder.toString());
        var verseText = document.getElementById('id-' + vOrder.toString());
        if (!checkbox || !verseText) return;
        if (checkbox.checked) {
            verseText.classList.add('up-editable--marked-for-delete');
        } else {
            verseText.classList.remove('up-editable--marked-for-delete');
        }
    }




    // ---------- geo/date tag AND person (شخصیت) tag suggestions ----------
    // Both kinds are staged client-side (until the main save) in this ONE combined array, and both
    // are sent to the server as one flat GanjoorPoemGeoDateTagCorrection[] (pcs.geoDateTags) - that
    // part of the data model is shared, on purpose (see the doc comment on
    // GanjoorPoemGeoDateTagCorrection.SuggestedPersonGraphJson). But a geo/date tag and a person tag
    // mean unrelated things to a reader ("this couplet refers to this place/time" vs "this couplet
    // refers to this person"), so the UI never mixes them in one row: every staged/loaded item here
    // carries a client-only "_uiKind" field ('geo' or 'person', added by _getSuggestionUiKind for
    // anything that doesn't already have it - e.g. a draft loaded from the server) that the two
    // render functions (renderPendingGeoDateTags / renderPendingPersonTags) filter on, and the two
    // "add a tag" cards each read/write only their own half of the form.
    var geoDateTagSuggestions = @Html.Raw(Model.MyLastEditGeoDateTagsJson);
    var geoDateTagCoupletTexts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Couplets.ToDictionary(c => c.Item1.ToString(), c => c.Item2)));
    // full existing-location catalog ({id, name, latitude, longitude}[]), used to warn about a
    // new-location suggestion that's actually already catalogued - see _confirmNewLocationSuggestion
    var allGeoLocations = @Html.Raw(Model.AllLocationsJson);
    // full existing-people catalog ({id, name, birthYearInLHijri, deathYearInLHijri}[]), used both
    // to pick an existing person for a tag and as the "other side" of a new person's relatives
    var allGeoPeople = @Html.Raw(Model.AllPeopleJson);
    // {id, personId}[] for this poem's already-approved geo/date/person tags - used only to work out
    // the _uiKind of a "delete this existing tag" suggestion loaded from a saved-but-unsubmitted
    // draft, which otherwise carries nothing but the id being deleted
    var allExistingGeoDateTags = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        (Model.PoemGeoDateTags ?? Array.Empty<RMuseum.Models.Ganjoor.PoemGeoDateTag>()).Select(t => new { id = t.Id, personId = t.PersonId })));

    // Works out whether a staged/loaded suggestion is a geo/date tag or a person (شخصیت) tag, for the
    // two render functions to filter on. New items always set _uiKind themselves when pushed; this
    // is only needed for items loaded from Model.MyLastEditGeoDateTagsJson (an unsubmitted draft
    // from a previous visit), which predate the split and never carry it.
    function _getSuggestionUiKind(s) {
        if (s._uiKind) return s._uiKind;
        if (s.markForDelete) {
            var existing = allExistingGeoDateTags.filter(function (t) { return t.id === s.existingTagId; })[0];
            return (existing && existing.personId) ? 'person' : 'geo';
        }
        return (s.personId != null || s.suggestedPersonGraphJson) ? 'person' : 'geo';
    }

    $(document).ready(function () {
        renderPendingGeoDateTags();
        renderPendingPersonTags();
        setupLocationAutocomplete(
            document.getElementById('geotag-location-search'),
            document.getElementById('geotag-location-select'),
            document.getElementById('geotag-location-results'),
            allGeoLocations,
            function (loc) {
                // picking an existing location (or clearing the field) means whatever was
                // typed into the "new location" panel no longer applies to this suggestion
                var widget = document.getElementById('new-location-widget');
                if (loc != null && widget.style.display !== 'none') {
                    toggleNewLocationWidget();
                }
            },
            function (typedText) {
                var widget = document.getElementById('new-location-widget');
                if (widget.style.display === 'none' || widget.style.display === '') {
                    toggleNewLocationWidget();
                }
                document.getElementById('geotag-new-location-name').value = typedText;
            }
        );
        var directAddLocationSearch = document.getElementById('location-search');
        if (directAddLocationSearch != null) {
            // admin-only direct-add row (bypasses the suggestion/moderation flow entirely) -
            // no "new location" concept here, so an unmatched search just has nothing to pick
            setupLocationAutocomplete(
                directAddLocationSearch,
                document.getElementById('location'),
                document.getElementById('location-results'),
                allGeoLocations,
                null,
                function (typedText) {
                    upToast('این مکان در فهرست نیست. برای افزودن مکان جدید از «مکان‌ها» در پایین این جدول استفاده کنید.', 'error');
                }
            );
        }
        setupPersonAutocomplete(
            document.getElementById('geotag-person-search'),
            document.getElementById('geotag-person-select'),
            document.getElementById('geotag-person-results'),
            allGeoPeople,
            function (person) {
                // picking an existing person (or clearing the field) means whatever was
                // typed into the "new person" panel no longer applies to this suggestion
                var widget = document.getElementById('new-person-widget');
                if (person != null && widget.style.display !== 'none') {
                    toggleNewPersonWidget();
                }
            },
            function (typedText) {
                var widget = document.getElementById('new-person-widget');
                if (widget.style.display === 'none' || widget.style.display === '') {
                    toggleNewPersonWidget();
                }
                document.getElementById('geotag-new-person-name').value = typedText;
            }
        );
    });
    var geoDateTagMap = null;
    var geoDateTagMarker = null;
    var personRelativeRowCounter = 0; // ever-increasing, so removed rows never clash with new ones

    function toggleNewPersonWidget() {
        var widget = document.getElementById('new-person-widget');
        var isHidden = widget.style.display === 'none' || widget.style.display === '';
        widget.style.display = isHidden ? 'block' : 'none';
    }

    // adds one "relative or affiliation" row to the new-person panel. The other side of the
    // relation must already exist (see the hint text above the button) - nesting another
    // brand-new person inside this one's relatives is a rare-enough case that it's left for a
    // later pass; the backend already supports it via relatedPeople, just not from this form yet.
    function addPersonRelativeRow() {
        var idx = personRelativeRowCounter++;
        var row = document.createElement('div');
        row.id = 'person-relative-row-' + idx;
        row.className = 'up-card';
        row.style.marginTop = '8px';
        row.innerHTML =
            '<div class="up-field-row">' +
                '<div class="up-field">' +
                    '<label>نوع رابطه</label>' +
                    '<select id="person-relative-kind-' + idx + '" onchange="togglePersonRelativeKind(' + idx + ')">' +
                        '<option value="family">خویشاوندی</option>' +
                        '<option value="affiliation">غیرخویشاوندی (مثل وزارت، مشاورت)</option>' +
                    '</select>' +
                '</div>' +
                '<div class="up-field" id="person-relative-familytype-wrap-' + idx + '">' +
                    '<label>نوع خویشاوندی</label>' +
                    '<select id="person-relative-familytype-' + idx + '" onchange="togglePersonRelativeDegreeHint(' + idx + ')">' +
                        '<option value="Parent">پدر/مادر ↔ فرزند</option>' +
                        '<option value="Sibling">خواهر/برادر</option>' +
                        '<option value="Spouse">همسر</option>' +
                        '<option value="Ancestor">نیا ↔ نواده (با فاصلهٔ نسل نامعلوم یا مشخص)</option>' +
                    '</select>' +
                '</div>' +
                '<div class="up-field" id="person-relative-affiliationtype-wrap-' + idx + '" style="display:none;">' +
                    '<label>نوع وابستگی</label>' +
                    '<select id="person-relative-affiliationtype-' + idx + '" onchange="updatePersonRelativeHint(' + idx + ')">' +
                        '<option value="Minister">وزیر</option>' +
                        '<option value="Advisor">مشاور</option>' +
                        '<option value="Courtier">درباری</option>' +
                        '<option value="Patron">حامی</option>' +
                        '<option value="Ally">متحد</option>' +
                        '<option value="Rival">رقیب</option>' +
                        '<option value="Panegyrized">مدح‌گو (طرف اول، طرف دوم را مدح کرده)</option>' +
                        '<option value="Satirized">هجوگو (طرف اول، طرف دوم را هجو کرده)</option>' +
                        '<option value="Other">سایر</option>' +
                    '</select>' +
                '</div>' +
                '<div class="up-field" id="person-relative-degreehint-wrap-' + idx + '" style="display:none;">' +
                    '<label>تعداد نسل (اختیاری، فقط اگر دقیقاً معلوم است)</label>' +
                    '<input type="text" id="person-relative-degreehint-' + idx + '" placeholder="مثلاً ۲ برای پدربزرگ/مادربزرگ" />' +
                '</div>' +
            '</div>' +
            '<div class="up-field-row" id="person-relative-direction-wrap-' + idx + '">' +
                '<div class="up-field">' +
                    '<label>جهت رابطه</label>' +
                    // "otherFirst" (the already-existing person is the parent side) is listed first
                    // and pre-selected, since a row starts out on the "family" kind and the usual
                    // workflow there is building a tree top-down - the ancestor/senior side already
                    // exists, and this new person being created is their child. Defaulting to
                    // "newFirst" instead silently assumed the opposite and was an easy, hard-to-notice
                    // way to enter a relation backwards (e.g. recording a son as his own father's
                    // parent). Non-family affiliations default the other way around - see
                    // togglePersonRelativeKind(), which flips this select's value on kind change.
                    '<select id="person-relative-direction-' + idx + '" onchange="updatePersonRelativeHint(' + idx + ')">' +
                        '<option value="otherFirst" selected="selected">نامبردۀ دیگر، طرف اول رابطه است (مثلاً پدر/وزیر این نامبردۀ جدید)</option>' +
                        '<option value="newFirst">این نامبردۀ جدید، طرف اول رابطه است (مثلاً پدر/وزیر طرف دوم)</option>' +
                    '</select>' +
                '</div>' +
            '</div>' +
            '<div class="up-field-row">' +
                '<div class="up-field">' +
                    '<label>نامبردۀ دیگر (باید از قبل در فهرست موجود باشد)</label>' +
                    '<div class="up-autocomplete-wrap">' +
                        '<input type="text" id="person-relative-person-search-' + idx + '" autocomplete="off" placeholder="نام نامبرده را تایپ کنید..." oninput="updatePersonRelativeHint(' + idx + ')" />' +
                        '<input type="hidden" id="person-relative-person-id-' + idx + '" />' +
                        '<div id="person-relative-person-results-' + idx + '" class="up-autocomplete-results" style="display:none;"></div>' +
                    '</div>' +
                '</div>' +
                '<div class="up-field">' +
                    '<label>یادداشت (اختیاری)</label>' +
                    '<input type="text" id="person-relative-note-' + idx + '" />' +
                '</div>' +
                '<a role="button" class="up-btn up-btn--sm up-btn--ghost" onclick="removePersonRelativeRow(' + idx + ')">✕ حذف این رابطه</a>' +
            '</div>' +
            // live "x پدر/مادر y است."-style readback of whatever is currently selected, so the
            // user can confirm the direction is right before submitting, instead of having to
            // mentally translate the kind/type/direction combo themselves every time
            '<p class="up-hint" id="person-relative-hint-' + idx + '"></p>';
        document.getElementById('geotag-person-relatives-list').appendChild(row);

        setupPersonAutocomplete(
            document.getElementById('person-relative-person-search-' + idx),
            document.getElementById('person-relative-person-id-' + idx),
            document.getElementById('person-relative-person-results-' + idx),
            allGeoPeople,
            function () {
                updatePersonRelativeHint(idx);
            },
            function (typedText) {
                upToast('این نامبرده در فهرست نیست. طرف دیگر یک رابطه باید از قبل تعریف‌شده باشد؛ برای دو نامبردۀ تازه، ابتدا این فرم را برای یکی از آن‌ها به‌صورت جدا تکمیل و ثبت کنید.', 'error');
            }
        );

        updatePersonRelativeHint(idx);
    }

    function removePersonRelativeRow(idx) {
        var row = document.getElementById('person-relative-row-' + idx);
        if (row) row.remove();
    }

    function togglePersonRelativeKind(idx) {
        var kind = $('#person-relative-kind-' + idx).val();
        var isFamily = kind === 'family';
        $('#person-relative-familytype-wrap-' + idx).toggle(isFamily);
        $('#person-relative-affiliationtype-wrap-' + idx).toggle(!isFamily);
        togglePersonRelativeDegreeHint(idx);
        // Family relations default to "the already-existing person is the first/senior side" - the
        // usual top-down tree-building flow, where the parent is already in the system and this new
        // person is their child. Non-family affiliations run the other way around in the common case:
        // the already-existing person is typically the senior/more prominent figure (a king, a
        // patron) already in the system, and the new person being added is the one standing in the
        // subordinate affiliation role toward them (their minister, their advisor) - so for
        // affiliations the new person should default to being the first side instead.
        $('#person-relative-direction-' + idx).val(isFamily ? 'otherFirst' : 'newFirst');
        updatePersonRelativeHint(idx);
    }

    function togglePersonRelativeDegreeHint(idx) {
        var kind = $('#person-relative-kind-' + idx).val();
        var isAncestor = kind === 'family' && $('#person-relative-familytype-' + idx).val() === 'Ancestor';
        $('#person-relative-degreehint-wrap-' + idx).toggle(isAncestor);
        updatePersonRelativeHint(idx);
    }

    // one sentence-building function per relation type (family kind) / affiliation type, so the
    // "جهت رابطه" readback hint below each row can show something like "x پدر/مادر y است." using
    // whichever two names are currently in play - matches the wording used elsewhere for the same
    // types (PersonWindow's role words, ReviewPersonRelationEdits' labels)
    var PERSON_RELATIVE_HINT_TEMPLATES = {
        family: {
            Parent: function (p1, p2) { return p1 + ' پدر/مادر ' + p2 + ' است.'; },
            Sibling: function (p1, p2) { return p1 + ' و ' + p2 + ' خواهر/برادر هم هستند.'; },
            Spouse: function (p1, p2) { return p1 + ' و ' + p2 + ' همسر هم هستند.'; },
            Ancestor: function (p1, p2) { return p1 + ' نیای ' + p2 + ' است.'; }
        },
        affiliation: {
            Minister: function (p1, p2) { return p1 + ' وزیر ' + p2 + ' است.'; },
            Advisor: function (p1, p2) { return p1 + ' مشاور ' + p2 + ' است.'; },
            Courtier: function (p1, p2) { return p1 + ' درباری ' + p2 + ' است.'; },
            Servant: function (p1, p2) { return p1 + ' خدمتگزار ' + p2 + ' است.'; },
            Patron: function (p1, p2) { return p1 + ' حامی ' + p2 + ' است.'; },
            Successor: function (p1, p2) { return p1 + ' جانشین ' + p2 + ' است.'; },
            Panegyrized: function (p1, p2) { return p1 + ' ' + p2 + ' را مدح کرده است.'; },
            Satirized: function (p1, p2) { return p1 + ' ' + p2 + ' را هجو کرده است.'; },
            Ally: function (p1, p2) { return p1 + ' و ' + p2 + ' متحد هم هستند.'; },
            Rival: function (p1, p2) { return p1 + ' و ' + p2 + ' رقیب هم هستند.'; },
            Companion: function (p1, p2) { return p1 + ' و ' + p2 + ' همراه هم هستند.'; },
            Other: function (p1, p2) { return p1 + ' با ' + p2 + ' نسبتی دارد (طبق یادداشت).'; }
        }
    };

    function updatePersonRelativeHint(idx) {
        var hintEl = document.getElementById('person-relative-hint-' + idx);
        if (!hintEl) return;
        var kind = $('#person-relative-kind-' + idx).val();
        var type = kind === 'family'
            ? $('#person-relative-familytype-' + idx).val()
            : $('#person-relative-affiliationtype-' + idx).val();
        var direction = $('#person-relative-direction-' + idx).val();
        var otherName = ($('#person-relative-person-search-' + idx).val() || '').trim() || 'نامبردۀ دیگر';
        var newName = ($('#geotag-new-person-name').val() || '').trim() || 'این نامبردۀ جدید';
        var person1Name = direction === 'otherFirst' ? otherName : newName;
        var person2Name = direction === 'otherFirst' ? newName : otherName;
        var build = (PERSON_RELATIVE_HINT_TEMPLATES[kind] || {})[type];
        hintEl.textContent = build ? build(person1Name, person2Name) : '';
    }

    // the new person's own name field is shared by every relative row, so typing into it has to
    // refresh all of them, not just whichever row happens to be focused
    function updateAllPersonRelativeHints() {
        $('[id^="person-relative-hint-"]').each(function () {
            updatePersonRelativeHint(this.id.replace('person-relative-hint-', ''));
        });
    }

    function toggleNewLocationWidget() {
        var widget = document.getElementById('new-location-widget');
        var isHidden = widget.style.display === 'none' || widget.style.display === '';
        widget.style.display = isHidden ? 'block' : 'none';
        // the map is a secondary way to set the coordinates (typing them in from Wikipedia/GeoHack,
        // per the hint text, is the primary one) but it's shown right away, not behind another
        // click, since a hidden-behind-a-link map is easy to miss entirely
        if (isHidden && geoDateTagMap == null) {
            geoDateTagMap = L.map('geotag-map').setView([32.4279, 53.6880], 5); // Iran-centered default
            L.tileLayer.provider('OpenStreetMap').addTo(geoDateTagMap);
            geoDateTagMap.on('click', function (e) {
                if (geoDateTagMarker != null) {
                    geoDateTagMap.removeLayer(geoDateTagMarker);
                }
                geoDateTagMarker = L.marker(e.latlng).addTo(geoDateTagMap);
                document.getElementById('geotag-new-location-lat').value = e.latlng.lat;
                document.getElementById('geotag-new-location-lng').value = e.latlng.lng;
            });
        }
        if (isHidden && geoDateTagMap != null) {
            // the map was created while its container was display:none (or is just being
            // re-shown), so Leaflet needs a nudge to recalculate its size once it's visible
            setTimeout(function () { geoDateTagMap.invalidateSize(); }, 100);
        }
    }

    // moves the embedded map (and its marker) to the typed-in lat/lng, so the user can check they
    // copied the right numbers before adding the suggestion, without leaving the page - this used
    // to open Google Maps in a new tab, but that made the two ways of setting a location (typing
    // coordinates vs. clicking the map) feel disconnected: clicking the map updated the fields, but
    // typing into the fields never showed up on the map. now both directions go through the same map.
    function viewNewLocationOnMap() {
        var latStr = document.getElementById('geotag-new-location-lat').value;
        var lngStr = document.getElementById('geotag-new-location-lng').value;
        if (!latStr || !lngStr) {
            upToast('ابتدا عرض و طول جغرافیایی را وارد کنید.', 'error');
            return;
        }
        var lat = parseFloat(latStr);
        var lng = parseFloat(lngStr);
        if (isNaN(lat) || isNaN(lng) || lat < -90 || lat > 90 || lng < -180 || lng > 180) {
            upToast('عرض جغرافیایی باید بین ۹۰- تا ۹۰ و طول جغرافیایی باید بین ۱۸۰- تا ۱۸۰ باشد.', 'error');
            return;
        }

        // the map is normally created when the "new location" widget is opened, but guard here
        // too in case this ever gets wired to a control outside that widget
        if (geoDateTagMap == null) {
            geoDateTagMap = L.map('geotag-map').setView([lat, lng], 5);
            L.tileLayer.provider('OpenStreetMap').addTo(geoDateTagMap);
            geoDateTagMap.on('click', function (e) {
                if (geoDateTagMarker != null) {
                    geoDateTagMap.removeLayer(geoDateTagMarker);
                }
                geoDateTagMarker = L.marker(e.latlng).addTo(geoDateTagMap);
                document.getElementById('geotag-new-location-lat').value = e.latlng.lat;
                document.getElementById('geotag-new-location-lng').value = e.latlng.lng;
            });
        }
        else {
            geoDateTagMap.invalidateSize();
        }

        if (geoDateTagMarker != null) {
            geoDateTagMap.removeLayer(geoDateTagMarker);
        }
        geoDateTagMarker = L.marker([lat, lng]).addTo(geoDateTagMap);
        geoDateTagMap.setView([lat, lng], 12);
    }

    // great-circle distance in km - just for catching obviously-duplicate locations, not
    // geodesy-grade precision
    function _geoDistanceKm(lat1, lng1, lat2, lng2) {
        var R = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLng = (lng2 - lng1) * Math.PI / 180;
        var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLng / 2) * Math.sin(dLng / 2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    // For a brand-new location suggestion, checks it against the full existing-location catalog
    // (allGeoLocations) before it's staged. Two cases:
    //  - near-identical coordinates to an existing location: almost certainly the same real place,
    //    typed in again instead of picked from the dropdown - blocked outright, no point asking.
    //  - same name as an existing location but meaningfully different coordinates: could be a real
    //    second place that happens to share a name, or could be a coordinate mistake - asks the
    //    user to explicitly confirm rather than guessing either way.
    // Returns true if the tag should be added as-is.
    async function _confirmNewLocationSuggestion(tag) {
        if (!tag || tag.locationId != null || !tag.suggestedLocationName) {
            return true; // an existing/selected location, or no location at all - nothing to check
        }

        var NEAR_DUPLICATE_KM = 5; // close enough that it's almost certainly the same real place
        var trimmedName = tag.suggestedLocationName.trim();

        for (var i = 0; i < allGeoLocations.length; i++) {
            var existing = allGeoLocations[i];
            var distanceKm = _geoDistanceKm(tag.suggestedLatitude, tag.suggestedLongitude, existing.latitude, existing.longitude);
            if (distanceKm <= NEAR_DUPLICATE_KM) {
                upToast('این مکان با نام «' + existing.name + '» و مختصات بسیار نزدیک از قبل ثبت شده است. لطفاً به‌جای پیشنهاد مکان جدید، همان را از فهرست «مکان» انتخاب کنید.', 'error');
                return false;
            }
        }

        var sameNameOtherPlaces = allGeoLocations.filter(function (existing) {
            return existing.name && existing.name.trim().toLowerCase() === trimmedName.toLowerCase();
        });
        if (sameNameOtherPlaces.length > 0) {
            var distances = sameNameOtherPlaces.map(function (existing) {
                return Math.round(_geoDistanceKm(tag.suggestedLatitude, tag.suggestedLongitude, existing.latitude, existing.longitude));
            });
            var ok = await upConfirm(
                'مکانی با نام «' + trimmedName + '» از قبل با مختصات دیگری در فهرست ثبت شده است (فاصله حدود ' + distances.join('، ') + ' کیلومتر). ' +
                'آیا مطمئنید این مکان دیگری با همین نام است و اشتباهی در مختصات پیش نیامده؟',
                { okText: 'بله، مکان دیگری است', cancelText: 'انصراف' }
            );
            if (!ok) {
                return false;
            }
        }

        return true;
    }

    // Builds the SuggestedPersonGraphJson payload (see GanjoorPoemGeoDateTagCorrection's doc
    // comment for the exact shape) from the "new person" panel and its relatives-list rows.
    // Returns null (with an error toast) if the panel is open but something required is missing;
    // the caller is expected to have already checked the panel is actually meant to be used.
    function buildPersonGraphJson() {
        var name = ($('#geotag-new-person-name').val() || '').trim();
        if (name == '') {
            upToast('لطفاً نام نامبردۀ جدید را وارد کنید.', 'error');
            return null;
        }

        // birth/death year, "date is documented" and birth/death location are left out of this
        // form for now (no real usage of them yet elsewhere) - the shape below still carries all
        // of PersonGraphNode's fields, just with those ones always null/false, same as any other
        // field this form doesn't offer a control for.
        var person = {
            localKey: 'new',
            existingPersonId: null,
            name: name,
            description: $('#geotag-new-person-description').val() || null,
            wikiUrl: $('#geotag-new-person-wikiurl').val() || null,
            birthYearInLHijri: null,
            deathYearInLHijri: null,
            validBirthDate: false,
            validDeathDate: false,
            birthLocationId: null,
            deathLocationId: null,
            familyTreeCaption: $('#geotag-new-person-familytreecaption').val() || null,
            importance: $('#geotag-new-person-importance').val(),
            gender: $('#geotag-new-person-gender').val()
        };

        var relatedPeople = [];
        var relatedPeopleByPersonId = {}; // existingPersonId -> localKey, so a person picked in two rows isn't duplicated
        var relations = [];

        var rows = $('#geotag-person-relatives-list > div');
        for (var r = 0; r < rows.length; r++) {
            var idx = rows[r].id.replace('person-relative-row-', '');
            var otherPersonId = $('#person-relative-person-id-' + idx).val();
            if (!otherPersonId) {
                upToast('برای یکی از روابط افزوده‌شده، نامبردۀ دیگر انتخاب نشده است.', 'error');
                return null;
            }
            otherPersonId = parseInt(otherPersonId);

            var otherLocalKey = relatedPeopleByPersonId[otherPersonId];
            if (!otherLocalKey) {
                otherLocalKey = 'existing_' + otherPersonId;
                relatedPeopleByPersonId[otherPersonId] = otherLocalKey;
                relatedPeople.push({ localKey: otherLocalKey, existingPersonId: otherPersonId });
            }

            var kind = $('#person-relative-kind-' + idx).val();
            var direction = $('#person-relative-direction-' + idx).val();
            var person1 = direction === 'otherFirst' ? otherLocalKey : 'new';
            var person2 = direction === 'otherFirst' ? 'new' : otherLocalKey;
            var note = $('#person-relative-note-' + idx).val() || null;

            if (kind === 'affiliation') {
                relations.push({
                    kind: 'affiliation',
                    person1: person1,
                    person2: person2,
                    affiliationType: $('#person-relative-affiliationtype-' + idx).val(),
                    note: note
                });
            } else {
                var relationType = $('#person-relative-familytype-' + idx).val();
                var degreeHintStr = $('#person-relative-degreehint-' + idx).val();
                relations.push({
                    kind: 'family',
                    person1: person1,
                    person2: person2,
                    relationType: relationType,
                    degreeHint: (relationType === 'Ancestor' && degreeHintStr) ? parseInt(degreeHintStr) : null,
                    note: note
                });
            }
        }

        return JSON.stringify({ person: person, relatedPeople: relatedPeople, relations: relations });
    }

    function renderPendingGeoDateTags() {
        var container = document.getElementById('pending-geotag-suggestions');
        var rows = [];
        for (var i = 0; i < geoDateTagSuggestions.length; i++) {
            if (_getSuggestionUiKind(geoDateTagSuggestions[i]) === 'geo') rows.push(i);
        }
        if (rows.length == 0) {
            container.innerHTML = '';
            return;
        }
        var html = '<table><tr><th>وضعیت</th><th>بیت</th><th>مکان</th><th>سال</th><th>ماه</th><th>روز</th><th>#</th></tr>';
        for (var r = 0; r < rows.length; r++) {
            var i = rows[r];
            var s = geoDateTagSuggestions[i];
            var status = s.markForDelete ? '🗑️ درخواست حذف' : '➕ پیشنهاد جدید';
            var coupletText = (s.coupletIndex != null && geoDateTagCoupletTexts[s.coupletIndex]) ? geoDateTagCoupletTexts[s.coupletIndex] : '— کل شعر —';
            var locationText = s.markForDelete ? '' : (s.locationId ? ((allGeoLocations.filter(function (l) { return l.id === s.locationId; })[0] || {}).name || ('مکان #' + s.locationId)) : (s.suggestedLocationName || ''));
            html += '<tr><td>' + status + '</td><td>' + coupletText + '</td><td>' + locationText + '</td><td>' + (s.lunarYear || '') + '</td><td>' + (s.lunarMonth || '') + '</td><td>' + (s.lunarDay || '') + '</td>' +
                '<td><a role="button" class="up-btn up-btn--sm up-btn--ghost" onclick="removeGeoDateTagSuggestion(' + i + ')">✕ حذف از فهرست</a></td></tr>';
        }
        html += '</table>';
        container.innerHTML = html;
    }

    // same purpose/shape as renderPendingGeoDateTags above, but for the person(شخصیت) tag section -
    // kept as a fully separate function (rather than one function with a "kind" switch inside) so
    // each half of the split UI is easy to read/change on its own
    function renderPendingPersonTags() {
        var container = document.getElementById('pending-persontag-suggestions');
        var rows = [];
        for (var i = 0; i < geoDateTagSuggestions.length; i++) {
            if (_getSuggestionUiKind(geoDateTagSuggestions[i]) === 'person') rows.push(i);
        }
        if (rows.length == 0) {
            container.innerHTML = '';
            return;
        }
        var html = '<table><tr><th>وضعیت</th><th>بیت</th><th>نامبرده</th><th>#</th></tr>';
        for (var r = 0; r < rows.length; r++) {
            var i = rows[r];
            var s = geoDateTagSuggestions[i];
            var status = s.markForDelete ? '🗑️ درخواست حذف' : '➕ پیشنهاد جدید';
            var coupletText = (s.coupletIndex != null && geoDateTagCoupletTexts[s.coupletIndex]) ? geoDateTagCoupletTexts[s.coupletIndex] : '— کل شعر —';
            var personText = '';
            if (!s.markForDelete) {
                if (s.personId) {
                    personText = (allGeoPeople.filter(function (p) { return p.id === s.personId; })[0] || {}).name || ('نامبرده #' + s.personId);
                } else if (s.suggestedPersonGraphJson) {
                    try {
                        var parsedGraph = JSON.parse(s.suggestedPersonGraphJson);
                        personText = 'نامبردۀ جدید: ' + (parsedGraph.person ? parsedGraph.person.name : '');
                    } catch (e) {
                        personText = 'نامبردۀ جدید';
                    }
                }
            }
            html += '<tr><td>' + status + '</td><td>' + coupletText + '</td><td>' + personText + '</td>' +
                '<td><a role="button" class="up-btn up-btn--sm up-btn--ghost" onclick="removeGeoDateTagSuggestion(' + i + ')">✕ حذف از فهرست</a></td></tr>';
        }
        html += '</table>';
        container.innerHTML = html;
    }

    // the pending-suggestions table sits above the "add a new tag" card, so after adding/removing
    // a row from it the change happens off-screen if the user is scrolled down to the form - jump
    // them to the table so they can see what just happened
    function scrollToPendingGeoDateTags() {
        var container = document.getElementById('pending-geotag-suggestions');
        if (container && container.innerHTML.trim() != '') {
            container.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }

    function scrollToPendingPersonTags() {
        var container = document.getElementById('pending-persontag-suggestions');
        if (container && container.innerHTML.trim() != '') {
            container.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }

    // shared by both sections - the two pending suggestions live in one combined array (see the
    // comment above geoDateTagSuggestions), so removing by index and re-rendering both tables is
    // simpler and just as cheap as tracking which table a given index belongs to
    function removeGeoDateTagSuggestion(index) {
        geoDateTagSuggestions.splice(index, 1);
        renderPendingGeoDateTags();
        renderPendingPersonTags();
    }

    function requestDeleteExistingGeoDateTag(existingTagId, el) {
        geoDateTagSuggestions.push({
            markForDelete: true,
            existingTagId: existingTagId,
            _uiKind: 'geo'
        });
        $(el).closest('tr').hide();
        renderPendingGeoDateTags();
        scrollToPendingGeoDateTags();
    }

    // person-tag counterpart of requestDeleteExistingGeoDateTag above
    function requestDeleteExistingPersonTag(existingTagId, el) {
        geoDateTagSuggestions.push({
            markForDelete: true,
            existingTagId: existingTagId,
            _uiKind: 'person'
        });
        $(el).closest('tr').hide();
        renderPendingPersonTags();
        scrollToPendingPersonTags();
    }

    // Reads the "add a new geo/date tag" form (location + date only - see readPersonTagFromForm
    // below for the separate شخصیت form). Returns a tag object if it has meaningful content, or
    // null if the form is empty (with an optional error toast for the case where the user
    // explicitly asked to add an empty entry vs. silently having nothing to pick up on save).
    function readGeoDateTagFromForm(showErrorIfEmpty) {
        var coupletIndex = $('#geotag-couplet-select').val();
        var locationId = $('#geotag-location-select').val();
        var newLocationName = $('#geotag-new-location-name').val();
        var newLocationLat = $('#geotag-new-location-lat').val();
        var newLocationLng = $('#geotag-new-location-lng').val();
        var year = $('#geotag-year').val();
        var month = $('#geotag-month').val();
        var day = $('#geotag-day').val();

        var hasLocation = (locationId && locationId != '') || (newLocationName && newLocationLat && newLocationLng);
        var hasDate = year && year != '';

        if (!hasLocation && !hasDate) {
            if (showErrorIfEmpty) {
                upToast('لطفاً حداقل یک مکان یا تاریخ وارد کنید.', 'error');
            }
            return null;
        }

        // coordinates are typed in by hand now (copied from Wikipedia/GeoHack), so a stray typo
        // is more likely than when they came from a map click - catch obviously-wrong values here
        if ((!locationId || locationId == '') && newLocationName) {
            var latNum = parseFloat(newLocationLat);
            var lngNum = parseFloat(newLocationLng);
            if (isNaN(latNum) || isNaN(lngNum) || latNum < -90 || latNum > 90 || lngNum < -180 || lngNum > 180) {
                upToast('عرض جغرافیایی باید بین ۹۰- تا ۹۰ و طول جغرافیایی باید بین ۱۸۰- تا ۱۸۰ باشد. مقدار وارد شده را با «مشاهده روی نقشه» بررسی کنید.', 'error');
                return null;
            }
        }

        return {
            markForDelete: false,
            coupletIndex: (coupletIndex && coupletIndex != '') ? parseInt(coupletIndex) : null,
            locationId: (locationId && locationId != '') ? parseInt(locationId) : null,
            suggestedLocationName: (!locationId || locationId == '') ? (newLocationName || null) : null,
            suggestedLatitude: (!locationId || locationId == '') && newLocationLat ? parseFloat(newLocationLat) : null,
            suggestedLongitude: (!locationId || locationId == '') && newLocationLng ? parseFloat(newLocationLng) : null,
            lunarYear: year ? parseInt(year) : null,
            lunarMonth: month ? parseInt(month) : null,
            lunarDay: day ? parseInt(day) : null,
            personId: null,
            suggestedPersonGraphJson: null,
            ignoreInCategory: $('#geotag-ignore-in-category').is(':checked'),
            suggestionNote: $('#geotag-note').val() || null,
            _uiKind: 'geo'
        };
    }

    // شخصیت-tag counterpart of readGeoDateTagFromForm above - deliberately never sets
    // locationId/suggestedLocationName/lunarYear/etc., so a person tag can never end up mixed with
    // a geo/date tag in one row (see the comment above geoDateTagSuggestions for why that matters)
    function readPersonTagFromForm(showErrorIfEmpty) {
        var coupletIndex = $('#persontag-couplet-select').val();
        var personId = $('#geotag-person-select').val();
        var newPersonName = $('#geotag-new-person-name').val();

        var hasPerson = (personId && personId != '') || (newPersonName && newPersonName.trim() != '');

        if (!hasPerson) {
            if (showErrorIfEmpty) {
                upToast('لطفاً یک نامبردۀ موجود را انتخاب کنید یا نامبردۀ جدیدی تعریف کنید.', 'error');
            }
            return null;
        }

        var suggestedPersonGraphJson = null;
        if ((!personId || personId == '') && newPersonName && newPersonName.trim() != '') {
            suggestedPersonGraphJson = buildPersonGraphJson();
            if (suggestedPersonGraphJson == null) {
                return null; // buildPersonGraphJson already showed the relevant error toast
            }
        }

        return {
            markForDelete: false,
            coupletIndex: (coupletIndex && coupletIndex != '') ? parseInt(coupletIndex) : null,
            locationId: null,
            suggestedLocationName: null,
            suggestedLatitude: null,
            suggestedLongitude: null,
            lunarYear: null,
            lunarMonth: null,
            lunarDay: null,
            personId: (personId && personId != '') ? parseInt(personId) : null,
            suggestedPersonGraphJson: suggestedPersonGraphJson,
            ignoreInCategory: false, // category-map aggregation is a geo/date-tag concept only
            suggestionNote: $('#persontag-note').val() || null,
            _uiKind: 'person'
        };
    }

    function resetGeoDateTagForm() {
        $('#geotag-couplet-select').val('');
        $('#geotag-location-select').val('');
        $('#geotag-location-search').val('');
        $('#geotag-location-results').hide().empty();
        $('#geotag-new-location-name').val('');
        $('#geotag-new-location-lat').val('');
        $('#geotag-new-location-lng').val('');
        $('#geotag-year').val('');
        $('#geotag-month').val('');
        $('#geotag-day').val('');
        $('#geotag-ignore-in-category').prop('checked', false);
        $('#geotag-note').val('');
        if (geoDateTagMarker != null && geoDateTagMap != null) {
            geoDateTagMap.removeLayer(geoDateTagMarker);
            geoDateTagMarker = null;
        }
    }

    // شخصیت-tag counterpart of resetGeoDateTagForm above
    function resetPersonTagForm() {
        $('#persontag-couplet-select').val('');
        $('#geotag-person-select').val('');
        $('#geotag-person-search').val('');
        $('#geotag-person-results').hide().empty();
        $('#geotag-new-person-name').val('');
        $('#geotag-new-person-description').val('');
        $('#geotag-new-person-wikiurl').val('');
        $('#geotag-new-person-familytreecaption').val('');
        $('#geotag-new-person-importance').val('Normal');
        $('#geotag-new-person-gender').val('Male');
        $('#geotag-person-relatives-list').empty();
