            @if (Model.ShowAdminOps)
            {
                <a href="/User/Editor?admin=1&id=@Model.PageInformation.Poem.Next.Id" role="button" class="up-btn up-btn--ghost">◀ شعر بعد</a>
            }
            else
            {
                <a href="/User/Editor?id=@Model.PageInformation.Poem.Next.Id" role="button" class="up-btn up-btn--ghost">◀ شعر بعد</a>
            }
        }
    </div>

    <p class="up-btn-group-label">لغزش سریع</p>
    <div class="up-btn-group">
        @if (Model.CanAssignRhythms)
        {
            <a role="button" href="#rhythms-section" class="up-btn up-btn--sm up-btn--ghost">🎵 بخش وزن، قافیه و قالب شعری</a>
        }
        else
        {
            <a role="button" href="#poem-sections" class="up-btn up-btn--sm up-btn--ghost">🧩 بخش قطعات</a>
        }
        <a role="button" href="#summaries" class="up-btn up-btn--sm up-btn--ghost">💬 بخش معنی</a>
        <a role="button" href="#geo-date-section" class="up-btn up-btn--sm up-btn--ghost">🗺️ بخش زمان و مکان</a>
        <a role="button" href="#person-tag-section" class="up-btn up-btn--sm up-btn--ghost">🧑‍🎓 بخش نامبردگان</a>
        <a role="button" href="#footer" class="up-btn up-btn--sm up-btn--ghost">⬇ پایین صفحه</a>
    </div>

    @if (Model.CanEdit && !Model.ShowAdminOps)
    {
        <div class="up-btn-group">
            <a role="button" href="/User/Editor?id=@Model.PageInformation.Id&admin=1" class="up-btn up-btn--ghost">⚙️ امکانات مدیریتی</a>
        </div>
    }

    @if (Model.TextSourceImage != null)
    {
        <div class="up-card">
            <p><strong>منبع کاغذی:</strong></p>
            <p class="up-hint">(متن پیشنهادی نمی‌بایست از نسخهٔ متفاوتی باشد)</p>
            <div class="related-images">
                <div class="related-image-container">
                    <a target="_blank" href="@Html.Raw(Model.TextSourceImage.TargetPageUrl)">
                        <img src="@Html.Raw(Model.TextSourceImage.ThumbnailImageUrl)" alt="@Model.TextSourceImage.AltText" loading="lazy" class="related-image-main">
                    </a>
                </div>
            </div>
        </div>
    }

    <div class="up-card">
        <h2 class="up-card__title">ویرایش متن</h2>

        <div class="up-field">
            <label for="id-0"><span class="up-field-icon" aria-hidden="true">🏷️</span> عنوان ویراستهٔ من</label>
            @if (Model.MyLastEdit != null && Model.MyLastEdit.Title != null)
            {
                <div id="id-0" name="id-0" contenteditable="true" class="up-editable">@Model.MyLastEdit.Title</div>
                <script>
                    $(document).ready(function () {
                        editorcompare(0);
                    });
                    document.getElementById("id-0").addEventListener("input", function () {
                        editorcompare(0)
                    }, false);
                </script>
            }
            else
            {
                <div type="text" id="id-0" name="id-0" contenteditable="true" class="up-editable">@Model.PageInformation.Poem.Title</div>
                <script>
                    document.getElementById("id-0").addEventListener("input", function () {
                        editorcompare(0)
                    }, false);
                </script>
            }
        </div>

        <div id="original-reveal-0" class="up-reveal" style="display:none">
            <div class="up-field">
                <label>عنوان فعلی</label>
                <p id="original-0" class="up-field-static">@Model.PageInformation.Poem.Title</p>
            </div>
        </div>

        <div id="compare-reveal-0" class="up-reveal" style="display:none">
            <div class="up-field">
                <label>تغییرات</label>
                <p id="compare-0" class="up-field-static">@Model.PageInformation.Poem.Title</p>
            </div>
        </div>
    </div>

    <div class="up-card">
        <h2 class="up-card__title">ویرایش مصرع‌ها</h2>

        @foreach (var verse in Model.PageInformation.Poem.Verses)
        {
            var verseCoupletNumber = Model.GetVerseCoupletNumber(verse);
            <div class="up-verse-row" id="tr-@verse.VOrder">
                <p>
                    <span class="up-verse-number">@verseCoupletNumber.ToPersianNumbers()</span>
                    @{ var verseProgressPercent = Model.GetCoupletProgressPercent(verseCoupletNumber); }
                    <span class="up-verse-progress" title="@verseCoupletNumber.ToPersianNumbers() از @Model.TotalCoupletsCount.ToPersianNumbers()"><span class="up-verse-progress-fill" style="width:@(verseProgressPercent)%;--up-progress-color:@(Model.GetCoupletProgressColor(verseProgressPercent))"></span></span>
                    <span class="up-hint">ترتیب مصرع یا خط از ابتدا: @verse.VOrder.ToPersianNumbers()</span>
                </p>

                <div class="up-field">
                    <label for="id-@($"{verse.VOrder}")"><span class="up-field-icon" aria-hidden="true">📝</span> ویراستهٔ من</label>
                    @if (Model.MyLastEdit != null && Model.MyLastEdit.VerseOrderText != null && Model.MyLastEdit.VerseOrderText.Where(v => v.VORder == verse.VOrder && !string.IsNullOrEmpty(v.Text)).Any())
                    {
                        <div id="id-@($"{verse.VOrder}")" name="name-@($"{verse.VOrder}")" contenteditable="true" class="up-editable">@Model.MyLastEdit.VerseOrderText.Where(v => v.VORder == verse.VOrder).First().Text</div>
                        <script>
                            document.getElementById("id-@($"{verse.VOrder}")").addEventListener("input", function () {
                                editorcompare(@verse.VOrder)
                            }, false);
                            $(document).ready(function () {
                                editorcompare(@verse.VOrder);
                            });
                        </script>
                    }
                    else
                    {
                        <div id="id-@($"{verse.VOrder}")" name="name-@($"{verse.VOrder}")" contenteditable="true" class="up-editable">@verse.Text</div>
                        <script>
                            document.getElementById("id-@($"{verse.VOrder}")").addEventListener("input", function () {
                                editorcompare(@verse.VOrder)
                            }, false);
                        </script>
                    }
                </div>

                <div id="original-reveal-@($"{verse.VOrder}")" class="up-reveal" style="display:none">
                    <div class="up-field">
                        <label>متن فعلی</label>
                        <p id="original-@($"{verse.VOrder}")" class="up-field-static">@verse.Text</p>
                    </div>
                </div>

                <div id="compare-reveal-@($"{verse.VOrder}")" class="up-reveal" style="display:none">
                    <div class="up-field">
                        <label>تغییرات</label>
                        <p id="compare-@($"{verse.VOrder}")" class="up-field-static">@verse.Text</p>
                    </div>
                </div>

                <div class="up-field-row">
                    <div class="up-field">
                        <label for="versepostion-@($"{verse.VOrder}")"><span class="up-field-icon" aria-hidden="true">🔀</span> نوع</label>
                        <select id="versepostion-@($"{verse.VOrder}")" name="versepostion-@($"{verse.VOrder}")">
                            @if (Model.MyLastEdit != null && Model.MyLastEdit.VerseOrderText != null && Model.MyLastEdit.VerseOrderText.Where(v => v.VORder == verse.VOrder && v.VersePosition != null).Any())
                            {
                                @foreach (var verseposition in RMuseum.Models.Ganjoor.VersePositionHelper.VersePositions)
                                    if (verseposition.VersePosition == Model.MyLastEdit.VerseOrderText.Where(v => v.VORder == verse.VOrder).First().VersePosition)
                                    {
                                        <option value="@verseposition.VersePosition" selected>@verseposition.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@verseposition.VersePosition">@verseposition.Text</option>
                                    }
                            }
                            else
                            {
                                @foreach (var verseposition in RMuseum.Models.Ganjoor.VersePositionHelper.VersePositions)
                                    if (verseposition.VersePosition == verse.VersePosition)
                                    {
                                        <option value="@verseposition.VersePosition" selected>@verseposition.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@verseposition.VersePosition">@verseposition.Text</option>
                                    }
                            }
                        </select>
                        @if (Model.MyLastEdit != null && Model.MyLastEdit.VerseOrderText != null && Model.MyLastEdit.VerseOrderText.Where(v => v.VORder == verse.VOrder).Any())
                        {
                            <input type="hidden" id="versepostion-original-@($"{verse.VOrder}")" name="versepostion-original-@($"{verse.VOrder}")" value="@Model.MyLastEdit.VerseOrderText.Where(v => v.VORder == verse.VOrder).First().VersePosition" />
                        }
                        else
                        {
                            <input type="hidden" id="versepostion-original-@($"{verse.VOrder}")" name="versepostion-original-@($"{verse.VOrder}")" value="@verse.VersePosition" />
                        }
                    </div>

                    <div class="up-field">
                        <label for="language-@verse.VOrder"><span class="up-field-icon" aria-hidden="true">🌐</span> زبان</label>
                        <select id="language-@verse.VOrder">
                            @foreach (var lang in Model.Languages)
                            {
                                @if (Model.MyLastEdit != null && Model.MyLastEdit.VerseOrderText != null && Model.MyLastEdit.VerseOrderText.Where(v => v.VORder == verse.VOrder && v.LanguageId == lang.Id).Any())
                                {
                                    <option value="@lang.Id" selected>@lang.Name</option>
                                }
                                else if (verse.LanguageId == null && lang.Id == 1)
                                {
                                    <option value="1" selected>فارسی</option>
                                }
                                else if (verse.LanguageId == lang.Id)
                                {
                                    <option value="@lang.Id" selected>@lang.Name</option>
                                }
                                else
                                {
                                    <option value="@lang.Id">@lang.Name</option>
                                }
                            }
                        </select>
                        @if (verse.LanguageId == null)
                        {
                            <span id="language-old-@verse.VOrder" class="hidden-recitation">1</span>
                        }
                        else
                        {
                            <span id="language-old-@verse.VOrder" class="hidden-recitation">@Model.Languages.Where(l => l.Id == verse.LanguageId).Single().Id</span>
                        }
                    </div>
                </div>

                <div class="up-check-row">
                    @if (Model.MyLastEdit != null && Model.MyLastEdit.VerseOrderText != null && Model.MyLastEdit.VerseOrderText.Where(v => v.VORder == verse.VOrder && v.MarkForDelete).Any())
                    {
                        <input type="checkbox" name="marked-for-delete-@verse.VOrder" id="marked-for-delete-@verse.VOrder" onchange="toggleMarkedForDelete(@verse.VOrder)" checked />
                    }
                    else
                    {
                        <input type="checkbox" name="marked-for-delete-@verse.VOrder" id="marked-for-delete-@verse.VOrder" onchange="toggleMarkedForDelete(@verse.VOrder)" />
                    }
                    <label for="marked-for-delete-@verse.VOrder">باید حذف شود</label>
                </div>
                <script>
                    $(document).ready(function () {
                        toggleMarkedForDelete(@verse.VOrder);
                    });
                </script>

                <div class="up-btn-group">
                    <a role="button" href="#savecorrections" class="up-btn up-btn--sm up-btn--save-jump up-btn--block">⬇ رفتن به ذخیره</a>
                    @if (Model.ShowAdminOps && verse.VOrder > 1 && verse.VersePosition != RMuseum.Models.Ganjoor.VersePosition.Left)
                    {
                        <a role="button" id="breakpoem-@verse.VOrder" class="up-btn up-btn--sm up-btn--danger" onclick="breakPoem(@Model.PageInformation.Poem.Id, @verse.VOrder, '@verse.Text')">✂️ شکستن از اینجا</a>
                    }
                </div>
            </div>
        }
    </div>

    @if (!Model.CanAssignRhythms)
    {
        <div class="up-alert up-alert--warning">این مورد شامل بیش از یک قطعه شعر یا دارای پاراگراف نثر است و امکان انتساب وزن و قالب شعری به آن و یا تعیین حروف قافیهٔ آن وجود ندارد.</div>
    }
    else
    {

        <div class="up-card" id="rhythms-section">
            <h2 class="up-card__title">وزن</h2>

            <div class="up-field">
                <label>وزن فعلی</label>
                <p id="rhythm-old" class="up-field-static">@(Model.GanjoorMetre1 == null ? "" : Model.GanjoorMetre1.Rhythm)</p>
            </div>

            <div class="up-alert up-alert--warning">
                <p class="up-mt-0">توجه داشته باشید که کارکرد برچسب‌گذاری اشعار در گنجور یافتن اشعار هم‌وزن است. از این جهت از پیشنهاد صورت‌های سلیقه‌ای و متفاوت یک وزن خودداری کنید تا این قابلیت مختل نشود. <a href="https://ganjoor.net/faq?id=14" target="_blank">این نکته</a> را هم مد نظر داشته باشید.</p>
            </div>

            <div class="up-field">
                <label for="select-search"><span class="up-field-icon" aria-hidden="true">🎵</span> جستجوی وزن</label>
                <input type="text" id="select-search" value="" oninput="doSearchInRhythmsCombo('select-search', 'rhythm-new')" list="inputRhythms" autocomplete="off" />
                <datalist id="inputRhythms">
                    @if (Model.RhythmsByVerseCount != null)
                        @foreach (var rhythm in Model.RhythmsByVerseCount)
                        {
                            <option value="@rhythm.Rhythm">@rhythm.Rhythm</option>
                        }
                </datalist>
            </div>

            <div class="up-field">
                <label for="rhythm-new"><span class="up-field-icon" aria-hidden="true">🎵</span> وزن ویراستهٔ من</label>
                <select id="rhythm-new" name="rhythm-new">
                    @foreach (var rhythm in Model.RhythmsAlphabetically)
                    {
                        if (Model.MyLastEdit != null && Model.MyLastEdit.Rhythm == rhythm.Rhythm)
                        {
                            <option value="@rhythm.Rhythm" selected>@rhythm.Rhythm</option>
                        }
                        else
                        {
                            if (Model.GanjoorMetre1 != null && Model.GanjoorMetre1.Rhythm == rhythm.Rhythm)
                            {
                                <option value="@rhythm.Rhythm" selected>@rhythm.Rhythm</option>
                            }
                            else
                            {
                                <option value="@rhythm.Rhythm">@rhythm.Rhythm</option>
                            }

                        }

                    }
                </select>
                <div class="up-btn-group up-mt-0">
                    <a role="button" onclick="resetRhythm('rhythm-new')" class="up-btn up-btn--sm up-btn--ghost">🧹 پاک کردن وزن</a>
                    <script>
                        function newRhythm() {
                            var rhythm = prompt("پیشنهاد وزن جدید", "");
                            if (rhythm != null) {
                                var select = document.getElementById('rhythm-new');
                                var options = select.options;
                                for (let i = 0; i < options.length; i++) {
                                    if (options[i].value == rhythm) {
                                        upToast('وزن پیشنهادی تکراری است.', 'error');
                                        return;
                                    }
                                }
                                var opt = document.createElement('option');
                                opt.value = rhythm;
                                opt.innerHTML = rhythm;
                                select.appendChild(opt);

                                var opt2 = document.createElement('option');
                                opt2.value = rhythm;
                                opt2.innerHTML = rhythm;
                                document.getElementById('rhythm-new2').appendChild(opt2);

                                upToast('وزن پیشنهادی به انتهای لیست وزن‌ها اضافه شده. لطفاً از لیست آن را انتخاب کنید.');
                            }
                        }
                    </script>
                    <a role="button" onclick="newRhythm()" class="up-btn up-btn--sm up-btn--ghost">➕ پیشنهاد وزن جدید</a>
                </div>
            </div>

            <div class="up-field">
                <label>حروف قافیه و ردیفِ فعلی</label>
                <p id="rhyme-letters-old" class="up-field-static">@Model.RhymeLetters</p>
            </div>

            <div class="up-field">
                <label for="rhyme-letters"><span class="up-field-icon" aria-hidden="true">🔤</span> حروف قافیه و ردیفِ ویراستهٔ من (بدون فاصله و حرکات)</label>
                <div class="up-btn-group up-mt-0">
                    @if (Model.MyLastEdit != null && !string.IsNullOrEmpty(Model.MyLastEdit.RhymeLetters))
                    {
                        <input type="text" id="rhyme-letters" name="rhyme-letters" value="@Model.MyLastEdit.RhymeLetters" style="flex:1;" />
                    }
                    else
                    {
                        <input type="text" id="rhyme-letters" name="rhyme-letters" value="@Model.RhymeLetters" style="flex:1;" />
                    }
                    <a role="button" onclick="computePoemRhyme(@Model.PageInformation.Id, '#rhyme-letters')" class="up-btn up-btn--ghost">🧮 محاسبه</a>
                </div>
                <p class="up-hint">
                    این فیلد قافیه و ردیف را با هم و بدون فاصله می‌خواهد، نه فقط قافیه. اگر بعد از حروف قافیه کلمه یا کلماتی عیناً در همهٔ ابیات تکرار شده باشند (ردیف)، آن‌ها هم باید در انتها بیایند.
                    برای نمونه در بیت «... اگر تو <b>یله کنی</b>» / «... اگر تو <b>گله کنی</b>» چون «کنی» عیناً در هر دو مصرع تکرار شده و ردیف شعر است، حروف قافیه و ردیف باید «<b>لهکنی</b>» نوشته شود؛ نه «له» (با نادیده گرفتن ردیف) و نه «ه کنی» (با فاصلهٔ اشتباه).
                    همچنین از حرکات (فتحه، ضمه، کسره) یا هر نشانهٔ اضافهٔ دیگر در این فیلد استفاده نشود.
                </p>
            </div>

            <div id="secondr-btn">
                <a role="button" onclick="secondR()" class="up-btn up-btn--sm up-btn--ghost">🎶 این شعر دو وزنی است</a>
            </div>

            <div id="secondr1" style="display:none">
                <h3 class="up-card__title">وزن دوم (شعرهای چندوزنی)</h3>
            </div>
            <div id="secondr2" class="up-alert up-alert--warning" style="display:none">
                <p class="up-mt-0">تعدادی کمی از شعرها دو وزنی هستند.</p>
            </div>
            <div id="secondr3" class="up-field" style="display:none">
                <label>وزن دوم فعلی</label>
                <p id="rhythm-old2" class="up-field-static">@(Model.GanjoorMetre2 == null ? "" : Model.GanjoorMetre2.Rhythm)</p>
            </div>
            <div id="secondr4" class="up-field" style="display:none">
                <label for="select-search2"><span class="up-field-icon" aria-hidden="true">🎵</span> جستجوی وزن (دوم)</label>
                <input type="text" id="select-search2" value="" oninput="doSearchInRhythmsCombo('select-search2', 'rhythm-new2')" list="inputRhythms2" autocomplete="off" />
                <datalist id="inputRhythms2">
                    @if (Model.RhythmsByVerseCount != null)
                        @foreach (var rhythm in Model.RhythmsByVerseCount)
                        {
                            <option value="@rhythm.Rhythm">@rhythm.Rhythm</option>
                        }
                </datalist>
            </div>
            <div id="secondr5" class="up-field" style="display:none">
                <label for="rhythm-new2"><span class="up-field-icon" aria-hidden="true">🎵</span> وزن (دوم) انتخاب شده</label>
                <select id="rhythm-new2" name="rhythm-new2">
                    @foreach (var rhythm in Model.RhythmsAlphabetically)
                    {
                        if (Model.MyLastEdit != null && Model.MyLastEdit.Rhythm2 == rhythm.Rhythm)
                        {
                            <option value="@rhythm.Rhythm" selected>@rhythm.Rhythm</option>
                        }
                        else
                        {
                            if (Model.GanjoorMetre2 != null && Model.GanjoorMetre2.Rhythm == rhythm.Rhythm)
                            {
                                <option value="@rhythm.Rhythm" selected>@rhythm.Rhythm</option>
                            }
                            else
                            {
                                <option value="@rhythm.Rhythm">@rhythm.Rhythm</option>
                            }

                        }

                    }
                </select>
                <a role="button" onclick="resetRhythm('rhythm-new2')" class="up-btn up-btn--sm up-btn--ghost">🧹 پاک کردن وزن</a>
            </div>
            <div id="secondr6" style="display:none"></div>

            <div class="up-field">
                <label>قالب شعری فعلی</label>
                <p class="up-field-static">
                    @RMuseum.Services.Implementation.GanjoorPoemFormatConvertor.GetString(Model.PoemFormat)
                    <span id="poemformat-old" class="hidden-recitation">@Model.PoemFormat</span>
                </p>
            </div>

            <div class="up-field">
                <label for="poemformat"><span class="up-field-icon" aria-hidden="true">📐</span> قالب شعری</label>
                <select id="poemformat">
                    @foreach (var poemFormat in System.Enum.GetValues(typeof(RMuseum.Models.Ganjoor.GanjoorPoemFormat)))
                    {
                        @if (Model.MyLastEdit != null && (Model.MyLastEdit.PoemFormat == (RMuseum.Models.Ganjoor.GanjoorPoemFormat)poemFormat))
                        {
                            <option value="@poemFormat" selected>@RMuseum.Services.Implementation.GanjoorPoemFormatConvertor.GetString((RMuseum.Models.Ganjoor.GanjoorPoemFormat)poemFormat)</option>
                        }
                        else if (Model.PoemFormat == (RMuseum.Models.Ganjoor.GanjoorPoemFormat)poemFormat)
                        {
                            <option value="@poemFormat" selected>@RMuseum.Services.Implementation.GanjoorPoemFormatConvertor.GetString((RMuseum.Models.Ganjoor.GanjoorPoemFormat)poemFormat)</option>
                        }
                        else
                        {
                            <option value="@poemFormat">@RMuseum.Services.Implementation.GanjoorPoemFormatConvertor.GetString((RMuseum.Models.Ganjoor.GanjoorPoemFormat)poemFormat)</option>
                        }

                    }
                </select>
            </div>
        </div>

    }

    <div class="up-card">
        <div class="up-field">
            <label for="note"><span class="up-field-icon" aria-hidden="true">🗒️</span> توضیح این ویرایش</label>
            @if (Model.MyLastEdit != null && !string.IsNullOrEmpty(Model.MyLastEdit.Note))
            {
                <input type="text" id="note" name="note" value="@Model.MyLastEdit.Note" />
            }
            else
            {
                <input type="text" id="note" name="note" value="" />
            }
        </div>
    </div>

    <div class="up-card" id="summaries">
        <h2 class="up-card__title">خلاصه و معنی</h2>
        <div class="up-alert up-alert--warning">
            <p>توجه فرمایید که هدف از این بخش، تفسیر متن اشعار <span style="color:red">نیست</span>. انتظار می‌رود در این بخش برای متون و اشعاری مثل داستان‌ها خلاصه یا لب مطلب را بنویسید (برای بعضی از انواع اشعار مثل غزل‌ها ممکن است خلاصهٔ کلی معنی نداشته باشد). برای خطوط یا ابیات نیز برگردان متن به نثر قابل فهم امروزی نوشته شود (لازم نیست برای همهٔ خطوط برگردان نثر نوشته شود). برای تفسیر یا درج عقاید شخصی خود راجع به اشعار از حاشیه‌ها استفاده کنید.</p>
            <p>متن باید خلاصه، به فارسی نوشتاری رسمی (غیرمحاوره‌ای)، خالی از لغات نامأنوس (زبان همه‌کس فهم) و بدون غلط املایی و تایپی باشد.</p>
            <p>اگر متن موجود به اندازهٔ کافی خوب باشد ممکن است متن خیلی متفاوت جایگزین تأیید نشود.</p>
            <p>نام و مشخصات نویسندهٔ متن در صفحهٔ شعر نمایش داده نمی‌شود اما در تاریخچهٔ تغییرات نگهداری می‌شود.</p>
            <p class="up-mt-0">در صورتی که متن تولید شده توسط <span style="color:red">هوش مصنوعی</span> را ویرایش می‌کنید عبارت نشان‌دهندهٔ تولید هوش مصنوعی بودن آن را <span style="color:red">حذف کنید</span>.</p>
        </div>

        <h3 class="up-card__title">خلاصه یا مفهوم کلی شعر یا متن</h3>
        <p class="up-hint">اگر متن یا شعر یک مفهوم و خلاصهٔ کلی ندارد (مثل خیلی از غزلیات حافظ) برای آن متن کلی وارد نکنید.</p>

        <div class="up-field">
            <label for="summary-0"><span class="up-field-icon" aria-hidden="true">💬</span> خلاصهٔ ویراستهٔ من (به زبان غیرمحاوره‌ای و همه‌کس فهم)</label>
            @if (Model.MyLastEdit != null && Model.MyLastEdit.PoemSummary != null)
            {
                <div id="summary-0" name="summary-0" contenteditable="true" class="up-editable">@Model.MyLastEdit.PoemSummary</div>
                <script>
                    document.getElementById("summary-0").addEventListener("input", function () {
                        summarycompare(0)
                    }, false);
                    $(document).ready(function () {
                        summarycompare(0);
                    });
                </script>
            }
            else
            {
                <div id="summary-0" name="summary-0" contenteditable="true" class="up-editable">@Model.PageInformation.Poem.PoemSummary</div>
                <script>
                    document.getElementById("summary-0").addEventListener("input", function () {
                        summarycompare(0)
                    }, false);
                </script>
            }
            @if (string.IsNullOrEmpty(Model.PageInformation.Poem.PoemSummary))
            {
                <p class="up-hint">هنوز متنی برای خلاصهٔ کلی نوشته نشده است.</p>
            }
        </div>

        <div id="originalsummary-reveal-0" class="up-reveal" style="display:none">
            <div class="up-field">
                <label>خلاصهٔ فعلی</label>
                <p id="originalsummary-0" class="up-field-static">@Model.PageInformation.Poem.PoemSummary</p>
            </div>
        </div>

        <div id="comparesummary-reveal-0" class="up-reveal" style="display:none">
            <div class="up-field">
                <label>تغییرات</label>
                <p id="comparesummary-0" class="up-field-static">@Model.PageInformation.Poem.PoemSummary</p>
            </div>
        </div>

        <a role="button" href="#savecorrections" class="up-btn up-btn--sm up-btn--save-jump up-btn--block">⬇ رفتن به ذخیره</a>
    </div>

    <div class="up-card">
        <h2 class="up-card__title">برگردان خطوط به زبان ساده</h2>

        @for (int verseIndex = 0; verseIndex < Model.PageInformation.Poem.Verses.Length; verseIndex++)
        {
            @if (
           Model.PageInformation.Poem.Verses[verseIndex].VersePosition == RMuseum.Models.Ganjoor.VersePosition.Right
           || Model.PageInformation.Poem.Verses[verseIndex].VersePosition == RMuseum.Models.Ganjoor.VersePosition.CenteredVerse1
           || Model.PageInformation.Poem.Verses[verseIndex].VersePosition == RMuseum.Models.Ganjoor.VersePosition.Paragraph
           )
            {
                var summaryCoupletNumber = Model.GetVerseCoupletNumber(Model.PageInformation.Poem.Verses[verseIndex]);
                <div class="up-verse-row">
                    <p>
                        <span class="up-verse-number">@summaryCoupletNumber.ToPersianNumbers()</span>
                        @{ var summaryProgressPercent = Model.GetCoupletProgressPercent(summaryCoupletNumber); }
                        <span class="up-verse-progress" title="@summaryCoupletNumber.ToPersianNumbers() از @Model.TotalCoupletsCount.ToPersianNumbers()"><span class="up-verse-progress-fill" style="width:@(summaryProgressPercent)%;--up-progress-color:@(Model.GetCoupletProgressColor(summaryProgressPercent))"></span></span>
                    </p>
                    <div class="up-field">
                        <label>متن</label>
                        @if (Model.PageInformation.Poem.Verses[verseIndex].VersePosition == RMuseum.Models.Ganjoor.VersePosition.Paragraph)
                        {
                            <p class="up-field-static">@Model.PageInformation.Poem.Verses[verseIndex].Text</p>
                        }
                        else
                        {
                            <div class="up-field-static">
                                @for (int nIndex = verseIndex; nIndex < Model.PageInformation.Poem.Verses.Length &&

                               (nIndex == verseIndex
                               ||
                               (
                               Model.PageInformation.Poem.Verses[nIndex].VersePosition != RMuseum.Models.Ganjoor.VersePosition.Right
                               && Model.PageInformation.Poem.Verses[nIndex].VersePosition != RMuseum.Models.Ganjoor.VersePosition.CenteredVerse1
                               && Model.PageInformation.Poem.Verses[nIndex].VersePosition != RMuseum.Models.Ganjoor.VersePosition.Paragraph
                               ))
                               ; nIndex++)
                                {
                                    <div>@Model.PageInformation.Poem.Verses[nIndex].Text</div>
                                }
                            </div>
                        }
                    </div>

                    <div class="up-alert up-alert--warning">
                        <p class="up-mt-0"><span style="color:red">تذکّر مهم:</span> از این کادر برای نوشتن چیزی جز معنی استفاده <span style="color:red">نکنید</span>.</p>
                        <p class="up-mt-0">در صورتی که متن تولید شده توسط هوش مصنوعی را ویرایش می‌کنید عبارت نشان‌دهندهٔ تولید <span style="color:red">هوش مصنوعی</span> بودن آن را <span style="color:red">حذف کنید</span>.</p>
                    </div>

                    <div class="up-field">
                        <label for="summary-@($"{Model.PageInformation.Poem.Verses[verseIndex].VOrder}")"><span class="up-field-icon" aria-hidden="true">💬</span> معنای ویراستهٔ من (به زبان غیرمحاوره‌ای و همه‌کس فهم)</label>
                        @if (Model.MyLastEdit != null && Model.MyLastEdit.VerseOrderText != null && Model.MyLastEdit.VerseOrderText.Where(v => v.VORder == Model.PageInformation.Poem.Verses[verseIndex].VOrder && !string.IsNullOrEmpty(v.CoupletSummary)).Any())
                        {
                            <div id="summary-@($"{Model.PageInformation.Poem.Verses[verseIndex].VOrder}")" name="summary-@($"{Model.PageInformation.Poem.Verses[verseIndex].VOrder}")" contenteditable="true" class="up-editable">@Model.MyLastEdit.VerseOrderText.Where(v => v.VORder == Model.PageInformation.Poem.Verses[verseIndex].VOrder).First().CoupletSummary</div>
                            <script>
                                document.getElementById("summary-@($"{Model.PageInformation.Poem.Verses[verseIndex].VOrder}")").addEventListener("input", function () {
                                    summarycompare(@Model.PageInformation.Poem.Verses[verseIndex].VOrder)
                                }, false);
                                $(document).ready(function () {
                                    summarycompare(@Model.PageInformation.Poem.Verses[verseIndex].VOrder);
                                });
                            </script>
                        }
                        else
                        {
                            <div id="summary-@($"{Model.PageInformation.Poem.Verses[verseIndex].VOrder}")" name="summary-@($"{Model.PageInformation.Poem.Verses[verseIndex].VOrder}")" contenteditable="true" class="up-editable">@Model.PageInformation.Poem.Verses[verseIndex].CoupletSummary</div>
                            <script>
                                document.getElementById("summary-@($"{Model.PageInformation.Poem.Verses[verseIndex].VOrder}")").addEventListener("input", function () {
                                    summarycompare(@Model.PageInformation.Poem.Verses[verseIndex].VOrder)
                                }, false);
                            </script>
                        }
                        @if (string.IsNullOrEmpty(Model.PageInformation.Poem.Verses[verseIndex].CoupletSummary))
                        {
                            <p class="up-hint">هنوز متنی برای معنی نوشته نشده است.</p>
                        }
                    </div>

                    <div id="originalsummary-reveal-@($"{Model.PageInformation.Poem.Verses[verseIndex].VOrder}")" class="up-reveal" style="display:none">
                        <div class="up-field">
                            <label>معنای فعلی</label>
                            <p id="originalsummary-@($"{Model.PageInformation.Poem.Verses[verseIndex].VOrder}")" class="up-field-static">@Model.PageInformation.Poem.Verses[verseIndex].CoupletSummary</p>
                        </div>
                    </div>

                    <div id="comparesummary-reveal-@($"{Model.PageInformation.Poem.Verses[verseIndex].VOrder}")" class="up-reveal" style="display:none">
                        <div class="up-field">
                            <label>تغییرات</label>
                            <p id="comparesummary-@($"{Model.PageInformation.Poem.Verses[verseIndex].VOrder}")" class="up-field-static">@Model.PageInformation.Poem.Verses[verseIndex].CoupletSummary</p>
                        </div>
                    </div>

                    <a role="button" href="#savecorrections" class="up-btn up-btn--sm up-btn--save-jump up-btn--block">⬇ رفتن به ذخیره</a>
                </div>
            }
        }
    </div>

    @if (Model.PageInformation.Poem.Sections.Count(s => s.SectionType == RMuseum.Models.Ganjoor.PoemSectionType.WholePoem && s.VerseType == RMuseum.Models.Ganjoor.VersePoemSectionType.First) > 1)
    {
        <div class="up-card" id="poem-sections">
            <h2 class="up-card__title">قطعات</h2>
            @foreach (var poemSetion in Model.PageInformation.Poem.Sections.Where(s => s.SectionType == RMuseum.Models.Ganjoor.PoemSectionType.WholePoem && s.VerseType == RMuseum.Models.Ganjoor.VersePoemSectionType.First).ToList())
            {
                <div class="up-verse-row">
                    <a href="/User/Section?poemId=@poemSetion.PoemId&index=@poemSetion.Index" role="button" class="up-btn up-btn--sm up-btn--ghost">
                        🧩 قطعهٔ @(poemSetion.Number.ToPersianNumbers()):
                    </a>
                    <p>@Html.Raw(poemSetion.HtmlText)</p>
                    <p class="up-hint">وزن: @(poemSetion.GanjoorMetre == null ? "تعیین نشده" : poemSetion.GanjoorMetre.Rhythm)</p>
                </div>
            }
        </div>
    }
    else
   if (Model.PageInformation.Poem.Sections.Count(s => s.SectionType == RMuseum.Models.Ganjoor.PoemSectionType.WholePoem && s.VerseType == RMuseum.Models.Ganjoor.VersePoemSectionType.First) == 1)
    {
        foreach (var poemSetion in Model.PageInformation.Poem.Sections.Where(s => s.SectionType == RMuseum.Models.Ganjoor.PoemSectionType.WholePoem && s.VerseType == RMuseum.Models.Ganjoor.VersePoemSectionType.First).ToList())
        {
            <p id="poem-sections">
                <a href="/User/Section?poemId=@poemSetion.PoemId&index=@poemSetion.Index" role="button" class="up-btn up-btn--ghost">
                    ✂️ شکستن شعر به قطعات مجزا
                </a>
            </p>
        }
    }

    <p class="up-btn-group-label">قطعات و مصرع‌ها</p>
    <div class="up-btn-group">
        <a href="/User/AllPoemSections?id=@Model.PageInformation.Id" role="button" class="up-btn up-btn--ghost">
            📚 همهٔ قطعات شعر
        </a>
        <a role="button" href="/User/VerseAdd/?id=@Model.PageInformation.Id" class="up-btn up-btn--ghost">➕ مصرع‌های جاافتاده</a>
    </div>

    <p class="up-btn-group-label">چینش مصرع‌ها</p>
    <div class="up-btn-group">
        <a role="button" onclick="resetVersePositions(@Model.PageInformation.Poem.Verses.Length)" class="up-btn up-btn--ghost">🔄 پیش‌فرض</a>
        <a role="button" onclick="tarkib3VersePositions(@Model.PageInformation.Poem.Verses.Length)" class="up-btn up-btn--ghost">3️⃣ مثلثی</a>
        <a role="button" onclick="tarkib4VersePositions(@Model.PageInformation.Poem.Verses.Length)" class="up-btn up-btn--ghost">4️⃣ مربعی</a>
        <a role="button" onclick="tarkib5VersePositions(@Model.PageInformation.Poem.Verses.Length)" class="up-btn up-btn--ghost">5️⃣ مخمسی</a>
        <a role="button" onclick="tarkib6VersePositions(@Model.PageInformation.Poem.Verses.Length)" class="up-btn up-btn--ghost">6️⃣ مسدسی</a>
        <a role="button" onclick="tarkib7VersePositions(@Model.PageInformation.Poem.Verses.Length)" class="up-btn up-btn--ghost">7️⃣ مسبعی</a>
        <a role="button" onclick="tarkib8VersePositions(@Model.PageInformation.Poem.Verses.Length)" class="up-btn up-btn--ghost">8️⃣ مثمنی</a>
    </div>

    <p class="up-btn-group-label">پیمایش</p>
    <div class="up-btn-group">
        @if (Model.PageInformation.Poem.Previous != null)
        {
            @if (Model.ShowAdminOps)
            {
                <a href="/User/Editor?admin=1&id=@Model.PageInformation.Poem.Previous.Id" role="button" class="up-btn up-btn--ghost">شعر قبل ▶</a>
            }
            else
            {
                <a href="/User/Editor?id=@Model.PageInformation.Poem.Previous.Id" role="button" class="up-btn up-btn--ghost">شعر قبل ▶</a>
            }
        }
        @if (Model.PageInformation.Poem.Next != null)
        {
            @if (Model.ShowAdminOps)
            {
                <a href="/User/Editor?admin=1&id=@Model.PageInformation.Poem.Next.Id" role="button" class="up-btn up-btn--ghost">◀ شعر بعد</a>
            }
            else
            {
                <a href="/User/Editor?id=@Model.PageInformation.Poem.Next.Id" role="button" class="up-btn up-btn--ghost">◀ شعر بعد</a>
            }
        }
    </div>

    @if (Model.ShowAdminOps)
    {
        <p class="up-btn-group-label">ابزارهای مدیریتی</p>
        <div class="up-btn-group">
            @if (Model.GanjoorMetre1 != null && !string.IsNullOrEmpty(Model.RhymeLetters))
            {
                <a role="button" onclick="updateRelatedSections(@Model.GanjoorMetre1.Id, '@Model.RhymeLetters')" class="up-btn up-btn--ghost">🔁 هم‌آهنگ‌های وزن اول</a>
            }
            @if (Model.GanjoorMetre2 != null && !string.IsNullOrEmpty(Model.RhymeLetters))
            {
                <a role="button" onclick="updateRelatedSections(@Model.GanjoorMetre2.Id, '@Model.RhymeLetters')" class="up-btn up-btn--ghost">🔁 هم‌آهنگ‌های وزن دوم</a>
            }
            <a role="button" onclick="updateCoupletIndices(@Model.PageInformation.Poem.Id)" class="up-btn up-btn--ghost">🔢 تصحیح اندیس‌های ابیات</a>
            <a role="button" onclick="regenerateSections(@Model.PageInformation.Poem.Id)" class="up-btn up-btn--ghost">♻️ قطعه‌بندی مجدد</a>
        </div>
    }

    @if (Model.CanEdit && !Model.ShowAdminOps)
    {
        <div class="up-btn-group">
            <a role="button" href="/User/Editor?id=@Model.PageInformation.Id&admin=1" class="up-btn up-btn--ghost">⚙️ امکانات مدیریتی</a>
        </div>
    }

    @if (Model.ShowAdminOps)
    {
        <p class="up-hint">برای حذف شعر از قسمت مدیریت بخش اقدام کنید.</p>
    }

    <div class="up-card" id="geo-date-section">
        <h2 class="up-card__title">🗺️ برچسب‌های زمان و مکان (پیشنهادی)</h2>
        <p class="up-hint">می‌توانید پیشنهاد دهید که این شعر به مکان یا تاریخ خاصی اشاره دارد. پیشنهادهای شما پس از بررسی ناظران اعمال خواهد شد. با دکمهٔ «ذخیره» بالا همراه با بقیهٔ تغییرات ثبت می‌شود.</p>

        @if (Model.PoemGeoDateTags != null && Model.PoemGeoDateTags.Any(t => t.PersonId == null))
        {
            <table>
                <tr>
                    <th>بیت</th>
                    <th>مکان</th>
                    <th>سال</th>
                    <th>ماه</th>
                    <th>روز</th>
                    <th>#</th>
                </tr>
                @* شخصیت tags are shown in their own section below, not mixed in with geo/date tags here - see #person-tag-section *@
                @foreach (var tag in Model.PoemGeoDateTags.Where(t => t.PersonId == null))
                {
                    <tr id="existing-geotag-@tag.Id">
                        <td>@(Model.Couplets.Where(c => c.Item1 == tag.CoupletIndex).Select(c => c.Item2).FirstOrDefault() ?? "— کل شعر —")</td>
                        <td>@($"{(tag.Location == null ? "" : tag.Location.Name)}")</td>
                        <td>@tag.LunarYear</td>
                        <td>
                            @{
                                switch (tag.LunarMonth)
                                {
                                    case 1:
                                        @("محرم")
                                        ;
                                        break;
                                    case 2:
                                        @("صفر")
                                        ;
                                        break;
                                    case 3:
                                        @("ربیع‌الاول")
                                        ;
                                        break;
                                    case 4:
                                        @("ربیع‌الثانی")
                                        ;
                                        break;
                                    case 5:
                                        @("جمادی‌الاول")
                                        ;
                                        break;
                                    case 6:
                                        @("جمادی‌الثانی")
                                        ;
                                        break;
                                    case 7:
                                        @("رجب")
                                        ;
                                        break;
                                    case 8:
                                        @("شعبان")
                                        ;
                                        break;
                                    case 9:
                                        @("رمضان")
                                        ;
                                        break;
                                    case 10:
                                        @("شوال")
                                        ;
                                        break;
                                    case 11:
                                        @("ذیقعده")
                                        ;
                                        break;
                                    case 12:
                                        @("ذیحجه")
                                        ;
                                        break;
                                }
                            }
                        </td>
                        <td>@tag.LunarDay</td>
                        <td>
                            <a role="button" class="up-btn up-btn--sm up-btn--ghost" onclick="requestDeleteExistingGeoDateTag(@tag.Id, this)">🗑️ درخواست حذف</a>
                        </td>
                    </tr>
                }
            </table>
        }

        <div id="pending-geotag-suggestions"></div>

        <div class="up-field">
            <label for="geotag-couplet-select">بیت</label>
            <select id="geotag-couplet-select">
                <option value="">— کل شعر —</option>
                @foreach (var couplet in Model.Couplets)
                {
                    <option value="@couplet.Item1">@($"{(couplet.Item1 + 1).ToPersianNumbers()} - {couplet.Item2}")</option>
                }
            </select>
            <p class="up-hint">اگر این برچسب به یک بیت مشخص اشاره دارد، آن را انتخاب کنید تا دیگران بتوانند شاهد آن را در متن پیدا کنند.</p>
        </div>

        <div class="up-field">
            <label for="geotag-location-search">مکان</label>
            <div class="up-autocomplete-wrap">
                <input type="text" id="geotag-location-search" autocomplete="off" placeholder="نام مکان را تایپ کنید..." />
                <input type="hidden" id="geotag-location-select" />
                <div id="geotag-location-results" class="up-autocomplete-results" style="display:none;"></div>
            </div>
            <p class="up-hint">شروع به تایپ کنید تا فهرست مکان‌های موجود بر اساس نام فیلتر شود؛ اگر مکان مورد نظر پیدا نشد، گزینهٔ تعریف آن به‌عنوان مکان جدید نمایش داده می‌شود.</p>
            <a role="button" class="up-btn up-btn--sm up-btn--ghost" onclick="toggleNewLocationWidget()">📍 مکان جدید پیشنهاد بده</a>
        </div>

        <div id="new-location-widget" style="display:none;">
            <div class="up-field">
                <label for="geotag-new-location-name">نام مکان پیشنهادی</label>
                <input type="text" id="geotag-new-location-name" />
            </div>
            <div class="up-field-row">
                <div class="up-field">
                    <label for="geotag-new-location-lat">عرض جغرافیایی (Latitude)</label>
                    <input type="text" id="geotag-new-location-lat" placeholder="مثلاً 32.6546" />
                </div>
                <div class="up-field">
                    <label for="geotag-new-location-lng">طول جغرافیایی (Longitude)</label>
                    <input type="text" id="geotag-new-location-lng" placeholder="مثلاً 51.6680" />
                </div>
                <a role="button" class="up-btn up-btn--sm up-btn--ghost" onclick="viewNewLocationOnMap()">🗺️ مشاهده روی نقشه</a>
            </div>
            <p class="up-hint">
                برای پیدا کردن مختصات دقیق یک مکان، به‌خصوص مکان‌های کمتر شناخته‌شده، لازم نیست حدس بزنید یا روی نقشهٔ زیر کلیک کنید:
                صفحهٔ آن مکان را در ویکی‌پدیا باز کنید؛ نزدیک عنوان صفحه یا در بخش اطلاعات (Infobox) لینکی به مختصات جغرافیایی وجود دارد
                (معمولاً به سایت <a href="https://geohack.toolforge.org" target="_blank" rel="noopener">geohack.toolforge.org</a> می‌رود).
                عرض جغرافیایی (Latitude / N) و طول جغرافیایی (Longitude / E) را از همان صفحه کپی کنید و در دو فیلد بالا وارد کنید،
                سپس با «🗺️ مشاهده روی نقشه» درست بودن نقطه را بررسی کنید.
                برای مکان‌های شناخته‌شده‌تر، به‌جای این کار می‌توانید مستقیماً روی نقشهٔ زیر هم کلیک کنید تا مختصات همان‌جا پر شود؛
                اما برای مکان‌های کم‌شناخته‌شده روش بالا معمولاً دقیق‌تر و سریع‌تر است.
            </p>
            <div id="geotag-map" style="height:300px;"></div>
        </div>

        <div class="up-field-row">
            <div class="up-field">
                <label for="geotag-year">سال (قمری)</label>
                <input type="text" id="geotag-year" />
            </div>
            <div class="up-field">
                <label for="geotag-month">ماه</label>
                <select id="geotag-month">
                    <option value="">هیچکدام</option>
                    <option value="1">محرم</option>
                    <option value="2">صفر</option>
                    <option value="3">ربیع‌الاول</option>
                    <option value="4">ربیع‌الثانی</option>
                    <option value="5">جمادی‌الاول</option>
                    <option value="6">جمادی‌الثانی</option>
                    <option value="7">رجب</option>
                    <option value="8">شعبان</option>
                    <option value="9">رمضان</option>
                    <option value="10">شوال</option>
                    <option value="11">ذیقعده</option>
                    <option value="12">ذیحجه</option>
                </select>
            </div>
            <div class="up-field">
                <label for="geotag-day">روز</label>
                <input type="text" id="geotag-day" />
            </div>
        </div>

        <div class="up-check-row">
            <input type="checkbox" id="geotag-ignore-in-category" />
            <label for="geotag-ignore-in-category">در نقشهٔ کلی مجموعه نادیده گرفته شود (مثلاً مکانی که فقط برای مقایسه ذکر شده)</label>
        </div>

        <div class="up-field">
            <label for="geotag-note">دلیل این برچسب (اختیاری، به‌ویژه برای اشاره‌های غیرمستقیم مثل ابجد یا تلمیح به رویدادی شناخته‌شده)</label>
            <textarea id="geotag-note" rows="2"></textarea>
        </div>

        <a role="button" class="up-btn up-btn--ghost" onclick="addGeoDateTagSuggestion()">➕ افزودن به فهرست پیشنهادها</a>
    </div>

    @* شخصیت (person) tags use the same GanjoorPoemGeoDateTagCorrection structure as the geo/date
       tags above (see the JS comment above geoDateTagSuggestions), but a couplet referring to a
       place/time and a couplet referring to a person are unrelated claims, so this is its own card
       with its own "existing tags" table, its own pending list, and its own add button - a
       suggestion coming out of this card never carries a location or a date. *@
    <div class="up-card" id="person-tag-section">
        <h2 class="up-card__title">🧑‍🎓 برچسب‌های نامبرده (پیشنهادی)</h2>
        <p class="up-hint">می‌توانید پیشنهاد دهید که این شعر به یک نامبرده (تاریخی یا داستانی) اشاره دارد. پیشنهادهای شما پس از بررسی ناظران اعمال خواهد شد. با دکمهٔ «ذخیره» بالا همراه با بقیهٔ تغییرات ثبت می‌شود.</p>

        @if (Model.PoemGeoDateTags != null && Model.PoemGeoDateTags.Any(t => t.PersonId != null))
        {
            <table>
                <tr>
                    <th>بیت</th>
                    <th>نامبرده</th>
                    <th>#</th>
                </tr>
                @foreach (var tag in Model.PoemGeoDateTags.Where(t => t.PersonId != null))
                {
                    <tr id="existing-geotag-@tag.Id">
                        <td>@(Model.Couplets.Where(c => c.Item1 == tag.CoupletIndex).Select(c => c.Item2).FirstOrDefault() ?? "— کل شعر —")</td>
                        <td>@(tag.Person != null ? tag.Person.Name : $"نامبرده #{tag.PersonId}")</td>
                        <td>
                            <a role="button" class="up-btn up-btn--sm up-btn--ghost" onclick="requestDeleteExistingPersonTag(@tag.Id, this)">🗑️ درخواست حذف</a>
                        </td>
                    </tr>
                }
            </table>
        }

        <div id="pending-persontag-suggestions"></div>

        <div class="up-field">
            <label for="persontag-couplet-select">بیت</label>
            <select id="persontag-couplet-select">
                <option value="">— کل شعر —</option>
                @foreach (var couplet in Model.Couplets)
                {
                    <option value="@couplet.Item1">@($"{(couplet.Item1 + 1).ToPersianNumbers()} - {couplet.Item2}")</option>
                }
            </select>
            <p class="up-hint">اگر این برچسب به یک بیت مشخص اشاره دارد، آن را انتخاب کنید تا دیگران بتوانند شاهد آن را در متن پیدا کنند.</p>
        </div>

        <div class="up-field">
            <label for="geotag-person-search">نامبرده</label>
            <div class="up-autocomplete-wrap">
                <input type="text" id="geotag-person-search" autocomplete="off" placeholder="نام نامبرده را تایپ کنید..." />
                <input type="hidden" id="geotag-person-select" />
                <div id="geotag-person-results" class="up-autocomplete-results" style="display:none;"></div>
            </div>
            <p class="up-hint">شروع به تایپ کنید تا فهرست نامبردگان بر اساس نام فیلتر شود؛ اگر نامبردۀ مورد نظر پیدا نشد، گزینهٔ تعریف او به‌عنوان نامبردۀ جدید نمایش داده می‌شود.</p>
            <a role="button" class="up-btn up-btn--sm up-btn--ghost" onclick="toggleNewPersonWidget()">👤 نامبردۀ جدید پیشنهاد بده</a>
        </div>

        <div id="new-person-widget" style="display:none;">
            <div class="up-field">
                <label for="geotag-new-person-name">نام</label>
                <input type="text" id="geotag-new-person-name" oninput="updateAllPersonRelativeHints()" />
            </div>
            <div class="up-field">
                <label for="geotag-new-person-description">توضیحات (اختیاری)</label>
                <textarea id="geotag-new-person-description" rows="2"></textarea>
            </div>
            <div class="up-field">
                <label for="geotag-new-person-wikiurl">لینک ویکی‌پدیا (اختیاری)</label>
                <input type="text" id="geotag-new-person-wikiurl" />
            </div>
            <div class="up-field">
                <label for="geotag-new-person-familytreecaption">عنوان تبارنامه (اختیاری، فقط اگر این نامبرده ریشهٔ یک خانواده/سلسله شناخته‌شده است - مثلاً «ساسانیان»)</label>
                <input type="text" id="geotag-new-person-familytreecaption" />
            </div>
            <div class="up-field">
                <label for="geotag-new-person-importance">درجهٔ اهمیت</label>
                <select id="geotag-new-person-importance">
                    <option value="Normal" selected="selected">معمولی</option>
                    <option value="Important">مهم</option>
                    <option value="VeryImportant">بسیار مهم</option>
                </select>
                <p class="up-hint"><small>فقط اندازهٔ نمایش این نامبرده را در نمودار شخصیت‌ها تعیین می‌کند.</small></p>
            </div>
            <div class="up-field">
                <label for="geotag-new-person-gender">جنسیت</label>
                <select id="geotag-new-person-gender">
                    <option value="Unknown">نامشخص</option>
                    <option value="Male" selected="selected">مرد</option>
                    <option value="Female">زن</option>
                </select>
                <p class="up-hint"><small>فقط در ترسیم نمودار تبارنامه استفاده می‌شود (برای تشخیص اینکه کدام والد به عنوان ادامهٔ اصلی شاخهٔ خانوادگی رسم شود).</small></p>
            </div>

            <p class="up-hint">
                اگر خویشاوندی یا وابستگی این نامبرده با نامبردۀ دیگری را می‌دانید، می‌توانید همین‌جا اضافه کنید (نامبردۀ دیگر باید از قبل در فهرست موجود باشد؛
                برای نامبرده‌ای که او هم تازه است، ابتدا این فرم را برای او هم به‌صورت جدا تکمیل و ثبت کنید، سپس این رابطه را اضافه کنید).
            </p>
            <div id="geotag-person-relatives-list"></div>
            <a role="button" class="up-btn up-btn--sm up-btn--ghost" onclick="addPersonRelativeRow()">➕ افزودن خویشاوند یا وابستگی</a>
        </div>

        <div class="up-field">
            <label for="persontag-note">دلیل این برچسب (اختیاری، به‌ویژه برای اشاره‌های غیرمستقیم به این نامبرده)</label>
            <textarea id="persontag-note" rows="2"></textarea>
        </div>

        <a role="button" class="up-btn up-btn--ghost" onclick="addPersonTagSuggestion()">➕ افزودن به فهرست پیشنهادها</a>
    </div>

    <div class="up-card">
        <div class="up-check-row">
            @if (Model.MyLastEdit != null && Model.MyLastEdit.HideMyName)
            {
                <input type="checkbox" name="hide-my-name" id="hide-my-name" checked />
            }
            else
            {
                <input type="checkbox" name="hide-my-name" id="hide-my-name" />
            }
            <label for="hide-my-name">مشخصات من در تاریخچهٔ ویرایش‌های این شعر نمایش داده نشود</label>
        </div>

        <div class="up-form-actions">
            <a role="button" id="savecorrections" class="up-btn up-btn--success up-btn--block" onclick="savePoemCorrections(@Model.PageInformation.Poem.Id, @Model.PageInformation.Poem.Verses.Length)">💾 ذخیره</a>
        </div>
        <p id="saving" class="up-hint">&nbsp;</p>
    </div>

    @if (Model.ShowAdminOps)
    {
        <div class="up-card">
            <h2 class="up-card__title">برچسب‌های زمان و مکان</h2>
            <table>
                <tr>
                    <th>مکان</th>
                    <th>سال</th>
                    <th>ماه</th>
                    <th>روز</th>
                    <th>تاریخ مستند</th>
                    <th>مختص شعر</th>
                    <th>#</th>
                </tr>
                @foreach (var tag in Model.PoemGeoDateTags)
                {
                    <tr id="tag-@tag.Id">
                        <td>@($"{(tag.Location == null ? "" : tag.Location.Name)}")</td>
                        <td>@tag.LunarYear</td>
                        <td>
                            @{
                                switch (tag.LunarMonth)
                                {
                                    case 1:
                                        @("محرم")
                                        ;
                                        break;
                                    case 2:
                                        @("صفر")
                                        ;
                                        break;
                                    case 3:
                                        @("ربیع‌الاول")
                                        ;
                                        break;
                                    case 4:
                                        @("ربیع‌الثانی")
                                        ;
                                        break;
                                    case 5:
                                        @("جمادی‌الاول")
                                        ;
                                        break;
                                    case 6:
                                        @("جمادی‌الثانی")
                                        ;
                                        break;
                                    case 7:
                                        @("رجب")
                                        ;
                                        break;
                                    case 8:
                                        @("شعبان")
                                        ;
                                        break;
                                    case 9:
                                        @("رمضان")
                                        ;
                                        break;
                                    case 10:
                                        @("شوال")
                                        ;
                                        break;
                                    case 11:
                                        @("ذیقعده")
                                        ;
                                        break;
                                    case 12:
                                        @("ذیحجه")
                                        ;
                                        break;
                                }
                            }
                        </td>
                        <td>@tag.LunarDay</td>
                        <td>
                            @if (tag.VerifiedDate)
                            {
                                <input type="checkbox" disabled checked />
                            }
                            else
                            {
                                <input type="checkbox" disabled />
                            }
                        </td>
                        <td>
                            @if (tag.IgnoreInCategory)
                            {
                                <input type="checkbox" disabled checked />
                            }
                            else
                            {
                                <input type="checkbox" disabled />
                            }
                        </td>
                        <td>
                            <a role="button" onclick="deletTag(@tag.Id)" class="actionlink" title="حذف"><i class="noindent-info-button delete-icon"></i></a>
                        </td>
                    </tr>
                }
                <tr>
                    <td>
                        <div class="up-autocomplete-wrap">
                            <input type="text" id="location-search" autocomplete="off" placeholder="نام مکان را تایپ کنید..." />
                            <input type="hidden" id="location" />
                            <div id="location-results" class="up-autocomplete-results" style="display:none;"></div>
                        </div>
                    </td>
                    <td>
                        <input type="text" id="year" />
                    </td>
                    <td>
                        <select id="month">
                            <option value="0">هیچکدام</option>
                            <option value="1">محرم</option>
                            <option value="2">صفر</option>
                            <option value="3">ربیع‌الاول</option>
                            <option value="4">ربیع‌الثانی</option>
                            <option value="5">جمادی‌الاول</option>
                            <option value="6">جمادی‌الثانی</option>
                            <option value="7">رجب</option>
                            <option value="8">شعبان</option>
                            <option value="9">رمضان</option>
                            <option value="10">شوال</option>
                            <option value="11">ذیقعده</option>
                            <option value="12">ذیحجه</option>
                        </select>
                    </td>
                    <td>
                        <input type="text" id="day" />
                    </td>
                    <td>
                        <input type="checkbox" id="verifiedDate" />
                    </td>
                    <td>
                        <input type="checkbox" id="ignoreInCategory" />
                    </td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="7">
                        <a role="button" class="up-btn up-btn--sm up-btn--ghost" onclick="newGeoDateTag(@Model.PageInformation.Id)">➕ برچسب جدید</a>
                    </td>
                </tr>
            </table>
            <a href="/Admin/Locations" role="button" class="up-btn up-btn--sm up-btn--ghost">📍 مکان‌ها</a>
        </div>
    }

    @if (Model.ShowAdminOps)
    {
        <div class="up-card">
            <h2 class="up-card__title">ابرداده‌های اضافه</h2>

            <div class="up-check-row">
                @if (Model.PageInformation.NoIndex)
                {
                    <input type="checkbox" id="chk_noindex" name="chk_noindex" checked />
                }
                else
                {
                    <input type="checkbox" id="chk_noindex" name="chk_noindex" />
                }
                <label for="chk_noindex">ایندکس نشود</label>
            </div>

            <div class="up-field up-field--ltr">
                <label for="redirect_from_url">از این نشانی (کامل) هم به این صفحه ری‌دایرکت شود</label>
                <input value="@Model.PageInformation.RedirectFromFullUrl" id="redirect_from_url" name="redirect_from_url" />
            </div>

            <div class="up-field">
                <label for="mixed_mode_order">ترتیب در فهرست‌ها</label>
                <input value="@Model.PageInformation.Poem.MixedModeOrder" id="mixed_mode_order" name="mixed_mode_order" />
            </div>

            <div class="up-form-actions">
                <a role="button" class="up-btn up-btn--success" onclick="savemeta(@Model.PageInformation.Id)">💾 ذخیرهٔ ابرداده‌ها</a>
            </div>
        </div>
    }

    <p id="footer" class="up-text-center">
        <a role="button" href="#" class="up-btn up-btn--sm up-btn--ghost">⬆ بالای صفحه</a>
    </p>
}
