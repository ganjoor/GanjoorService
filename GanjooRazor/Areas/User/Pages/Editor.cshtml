                                    <p class="green-color" id="verse-summary@verse.Id-lastedit-edited">@verse.CoupletSummary</p>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="2">
                                    <p id="verse-summary@verse.Id-lastedit-compare">@verse.OriginalText</p>
                                    <script>
                                        $(document).ready(function () {
                                            compareCorrectionBlocks('verse-summary@verse.Id-lastedit-original', 'verse-summary@verse.Id-lastedit-edited', 'verse-summary@verse.Id-lastedit-compare');
                                        });
                                    </script>
                                </td>
