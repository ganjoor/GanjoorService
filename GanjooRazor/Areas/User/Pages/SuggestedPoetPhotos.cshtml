@page
@model GanjooRazor.Areas.User.Pages.SuggestedPoetPhotosModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_UserPanelLayout";
    ViewData["Title"] = "تصاویر پیشنهادی برای تصاویر سخنوران";
    await GanjooRazor.Utils.GanjoorSessionChecker.ApplyPermissionsToViewData(Request, Response, ViewData);
}
<div class="up-page-header">
    <h1>@ViewData["Title"]</h1>
</div>
@if (Model.LastError != "")
{
    <div class="up-alert up-alert--danger">@Model.LastError</div>
}
else
{
    <div class="up-card">
        <form method="post" class="up-form">
            <div class="up-field">
                <label>سخنور</label>
                <div>
                    <a href="/photos?p=@Model.Poet.FullUrl.Substring(1)" target="_blank">@Model.Poet.Nickname</a>
                    <input type="hidden" asp-for="Suggestion.Id" />
                    <input type="hidden" asp-for="Suggestion.PoetId" />
                    <input type="hidden" asp-for="Suggestion.SuggestedById" />
                </div>
            </div>

            <div class="up-field">
                <label>پیشنهاد دهنده</label>
                <div><a href="/hashieha/?userid=@Model.Suggestion.SuggestedById" target="_blank">@Model.Suggestion.SuggestedById</a></div>
            </div>

            <img src="@Model.Suggestion.ImageUrl" style="max-width:100%;" />

            <div class="up-field">
                <label asp-for="Suggestion.Title">عنوان</label>
                <input asp-for="Suggestion.Title" />
            </div>

            <div class="up-field">
                <label asp-for="Suggestion.Description">توضیحات</label>
                <textarea asp-for="Suggestion.Description" class="editor"></textarea>
            </div>

            <div class="up-field">
                <label asp-for="Suggestion.PicOrder">ترتیب</label>
                <input asp-for="Suggestion.PicOrder" />
            </div>

            <div class="up-field">
                <label asp-for="Suggestion.RejectionCause">علت رد (در صورت رد)</label>
                <input asp-for="Suggestion.RejectionCause" />
            </div>

            <div class="up-form-actions">
                <button type="submit" name="approve" id="approve" class="up-btn up-btn--success">تأیید</button>
                <button type="submit" name="reject" id="reject" class="up-btn up-btn--danger">رد</button>
                <button type="submit" name="next" id="next" class="up-btn up-btn--ghost">بعدی</button>
            </div>

            <p class="up-hint">تعداد کل: @Model.TotalCount</p>
        </form>
    </div>
}
