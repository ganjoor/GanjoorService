@page
@model GanjooRazor.Areas.User.Pages.FinalizeImagesModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_UserPanelLayout";
    ViewData["Title"] = "نهایی‌سازی تصاویر پیشنهادی";
    await GanjooRazor.Utils.GanjoorSessionChecker.ApplyPermissionsToViewData(Request, Response, ViewData);
}
<div class="up-page-header">
    <h1>@ViewData["Title"]</h1>
</div>

@if (Model.LastError != "")
{
    <div class="up-alert up-alert--danger">@Model.LastError</div>
}

@if (Model.MainImage == null)
{
    <partial name="_EmptyState" model="@("تصویری برای نهایی‌سازی وجود ندارد.")" />
}
else
{
    <div class="up-card">
        <p><a href="@Model.MainImage.GanjoorUrl" target="_blank">@Model.MainImage.GanjoorTitle</a></p>

        <div style="display:flex;gap:var(--up-space-3);flex-wrap:wrap;">
            <div>
                <p class="up-hint">تصویر پیشنهادی</p>
                <img src="@Model.MainImage.ExternalNormalSizeImageUrl" style="max-width:100%;" />
            </div>
            @if (Model.PreviouslyLinkedImage != null)
            {
                <div>
                    <p class="up-hint">تصویر فعلی</p>
                    <img src="@Model.PreviouslyLinkedImage.ExternalNormalSizeImageUrl" style="max-width:100%;" />
                </div>
            }
        </div>

        <form method="post" class="up-form">
            <input type="hidden" asp-for="ImageLinkFinalizeModel.Id" />
            <div class="up-field">
                <label asp-for="ImageLinkFinalizeModel.DisplayOnPage"></label>
                <input asp-for="ImageLinkFinalizeModel.DisplayOnPage" />
            </div>
            <div class="up-form-actions">
                <button type="submit" name="approve" id="approve" class="up-btn up-btn--success">تأیید</button>
            </div>
        </form>

        <p class="up-hint">تعداد کل: @Model.TotalCount</p>
    </div>
}
