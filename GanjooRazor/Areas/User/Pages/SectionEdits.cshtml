@page
@model GanjooRazor.Areas.User.Pages.SectionEditsModel
@using RMuseum.Models.Ganjoor
@using RMuseum.Services.Implementation
@{
    Layout = "_UserPanelLayout";
    ViewData["Title"] = "ویرایش‌های قطعات من";
    await GanjooRazor.Utils.GanjoorSessionChecker.ApplyPermissionsToViewData(Request, Response, ViewData);
}
<div class="up-page-header">
    <h1>@ViewData["Title"]</h1>
</div>
@if (Model.LastError != "")
{
    <div class="up-alert up-alert--danger">@Model.LastError</div>
}
else
{
    if (@Model.CanEdit)
    {
        <div class="up-form-actions">
            <a role="button" href="/User/SectionEdits?AllUsers=1" class="up-btn up-btn--ghost">ویرایش‌های قطعات همه</a>
        </div>
    }

    <partial name="_Pagination" model="Model.PaginationLinks" />

    @if (Model.Corrections.Count == 0)
    {
        <partial name="_EmptyState" model="@("شما هنوز هیچ ویرایشی در گنجور انجام نداده‌اید. برای آشنایی با نحوهٔ ویرایش اشعار <a href=\"https://blog.ganjoor.net/1400/05/23/notes-for-suggesting-corrections/\" target=\"_blank\">اینجا</a> را ببینید.")" />
    }

    @foreach (var correction in Model.Corrections)
    {
        <div class="up-list-item" id="correction-@correction.Id">
            <table>
                <tr>
                    <td colspan="3"><a href="/User/Section?poemId=@correction.PoemId&index=@correction.SectionIndex" target="_blank">مشاهدهٔ متن شعر یا بخش</a></td>
                </tr>

                @if (Model.AllUsersEdits)
                {
                    <tr>
                        <td colspan="3"><a href="/hashieha/?userid=@correction.UserId" target="_blank">@correction.UserNickname</a></td>
                    </tr>
                }

                <tr>
                    <td>متن اولیه</td>
                    <td>تغییرات من</td>
                    <td>نتیجهٔ بررسی</td>
                </tr>

                @if (correction.Rhythm != null)
                {
                    <tr>
                        <td>
                            <p style="color:red">وزن: @correction.OriginalRhythm</p>
                        </td>
                        <td>
                            <p style="color:green">@correction.Rhythm</p>
                        </td>
                        <td>
                            <partial name="_ReviewResultBadge" model="correction.RhythmResult" />
                        </td>
                    </tr>
                    @if (!string.IsNullOrEmpty(correction.ReviewNote))
                    {
                        <tr>
                            <td colspan="3">
                                <p>@correction.ReviewNote</p>
                            </td>
                        </tr>
                    }
                }

                @if (correction.RhymeLetters != null)
                {
                    <tr>
                        <td>
                            <p style="color:red">قافیه: @correction.OriginalRhymeLetters</p>
                        </td>
                        <td>
                            <p style="color:green">@correction.RhymeLetters</p>
                        </td>
                        <td>
                            <partial name="_ReviewResultBadge" model="correction.RhymeLettersReviewResult" />
                        </td>
                    </tr>
                    @if (!string.IsNullOrEmpty(correction.ReviewNote))
                    {
                        <tr>
                            <td colspan="3">
                                <p>@correction.ReviewNote</p>
                            </td>
                        </tr>
                    }
                }

                @if (correction.Language != null)
                {
                    <tr>
                        <td>
                            <p style="color:red">زبان: @correction.OriginalLanguage</p>
                        </td>
                        <td>
                            <p style="color:green">@correction.Language</p>
                        </td>
                        <td>
                            <partial name="_ReviewResultBadge" model="correction.LanguageReviewResult" />
                        </td>
                    </tr>
                    @if (!string.IsNullOrEmpty(correction.ReviewNote))
                    {
                        <tr>
                            <td colspan="3">
                                <p>@correction.ReviewNote</p>
                            </td>
                        </tr>
                    }
                }

                @if (correction.PoemFormat != null)
                {
                    <tr>
                        <td>
                            <p style="color:red">قالب شعری: @RMuseum.Services.Implementation.GanjoorPoemFormatConvertor.GetString(correction.OriginalPoemFormat)</p>
                        </td>
                        <td>
                            <p style="color:green">@RMuseum.Services.Implementation.GanjoorPoemFormatConvertor.GetString(correction.PoemFormat)</p>
                        </td>
                        <td>
                            <partial name="_ReviewResultBadge" model="correction.PoemFormatReviewResult" />
                        </td>
                    </tr>
                    @if (!string.IsNullOrEmpty(correction.ReviewNote))
                    {
                        <tr>
                            <td colspan="3">
                                <p>@correction.ReviewNote</p>
                            </td>
                        </tr>
                    }
                }

                @if (
               correction.BreakFromVerse1VOrderResult == CorrectionReviewResult.Approved
               ||
               correction.BreakFromVerse2VOrderResult == CorrectionReviewResult.Approved
               ||
               correction.BreakFromVerse3VOrderResult == CorrectionReviewResult.Approved
               ||
               correction.BreakFromVerse4VOrderResult == CorrectionReviewResult.Approved
               ||
               correction.BreakFromVerse5VOrderResult == CorrectionReviewResult.Approved
               ||
               correction.BreakFromVerse6VOrderResult == CorrectionReviewResult.Approved
               ||
               correction.BreakFromVerse7VOrderResult == CorrectionReviewResult.Approved
               ||
               correction.BreakFromVerse8VOrderResult == CorrectionReviewResult.Approved
               ||
               correction.BreakFromVerse9VOrderResult == CorrectionReviewResult.Approved
               ||
               correction.BreakFromVerse10VOrderResult == CorrectionReviewResult.Approved
               )
                {
                    <tr>
                        <td colspan="3">
                            <p>پیشنهاد شما برای شکستن قطعه تأیید شده است.</p>
                        </td>
                    </tr>
                }

                @if (!string.IsNullOrEmpty(correction.Note))
                {
                    <tr>
                        <td>یادداشت:</td>
                        <td colspan="2">
                            @correction.Note
                        </td>
                    </tr>
                }

                @if (!string.IsNullOrEmpty(correction.ReviewNote))
                {
                    <tr>
                        <td>یادداشت بررسی:</td>
                        <td colspan="2">
                            @correction.ReviewNote
                        </td>
                    </tr>
                }

                <tr>
                    <td colspan="3">
                        @if (correction.Reviewed)
                        {
                            <a role="button" class="up-btn up-btn--danger up-btn--block" href="/User/Section?poemId=@correction.PoemId&index=@correction.SectionIndex">ویرایش مجدد</a>
                        }
                        else
                        {
                            <a role="button" class="up-btn up-btn--primary up-btn--block" href="/User/Section?poemId=@correction.PoemId&index=@correction.SectionIndex">مشاهده</a>
                        }
                    </td>
                </tr>

            </table>
        </div>
    }

    <partial name="_Pagination" model="Model.PaginationLinks" />
}
