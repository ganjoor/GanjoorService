@page
@model GanjooRazor.Areas.User.Pages.RelationsWithoutEvidenceModel
@using RMuseum.Models.Ganjoor
@using RMuseum.Models.Ganjoor.ViewModels
@{
    Layout = "_UserPanelLayout";
    ViewData["Title"] = "نسبت‌های بدون مستند";
    await GanjooRazor.Utils.GanjoorSessionChecker.ApplyPermissionsToViewData(Request, Response, ViewData);

    string RelationTypeName(GanjoorRelationWithoutEvidence r)
    {
        switch (r.RelationType)
        {
            case PersonRelationType.Parent: return "پدر/مادر و فرزند";
            case PersonRelationType.Sibling: return "خواهر/برادر";
            case PersonRelationType.Spouse: return "همسر";
            case PersonRelationType.Ancestor: return r.DegreeHint.HasValue ? $"نیا و نواده ({r.DegreeHint.Value} نسل)" : "نیا و نواده";
            default: return r.RelationType.ToString();
        }
    }
    string AffiliationTypeName(PersonAffiliationType? t)
    {
        switch (t)
        {
            case PersonAffiliationType.Minister: return "وزیر/کارگزار (اول زیردست دوم)";
            case PersonAffiliationType.Advisor: return "مشاور";
            case PersonAffiliationType.Courtier: return "درباری/همراه";
            case PersonAffiliationType.Patron: return "حامی";
            case PersonAffiliationType.Ally: return "متحد";
            case PersonAffiliationType.Rival: return "رقیب";
            case PersonAffiliationType.Servant: return "خدمتگزار";
            case PersonAffiliationType.Companion: return "همدم";
            case PersonAffiliationType.Successor: return "جانشین";
            case PersonAffiliationType.Panegyrized: return "مدح‌سرا و ممدوح";
            case PersonAffiliationType.Satirized: return "هجوگو و هجوشده";
            case PersonAffiliationType.MilitaryCommander: return "سردار";
            case PersonAffiliationType.Champion: return "پهلوان";
            case PersonAffiliationType.Contemporary: return "هم‌عصر";
            case PersonAffiliationType.Killer: return "قاتل و کشته";
            default: return "نوع دیگر";
        }
    }
    string personFilter = (Model.PersonId.HasValue ? $"&personId={Model.PersonId.Value}" : "") + (Model.Affiliations ? "&affiliations=true" : "");
    string kindWord = Model.Affiliations ? "وابستگی‌های غیرخویشاوندی" : "نسبت‌های خویشاوندی";
}
@if (!string.IsNullOrEmpty(Model.LastError))
{
    <div class="up-alert up-alert--danger">@Model.LastError</div>
}
else
{
    <div class="up-page-header">
        <h1>@kindWord بدون مستند</h1>
    </div>
    <p>
        <a href="/User/RelationsWithoutEvidence@(Model.PersonId.HasValue ? "?personId=" + Model.PersonId.Value : "")" class="up-btn up-btn--sm @(Model.Affiliations ? "up-btn--ghost" : "")">نسبت‌های خویشاوندی</a>
        <a href="/User/RelationsWithoutEvidence?affiliations=true@(Model.PersonId.HasValue ? "&personId=" + Model.PersonId.Value : "")" class="up-btn up-btn--sm @(Model.Affiliations ? "" : "up-btn--ghost")">وابستگی‌های غیرخویشاوندی</a>
    </p>
    <p class="up-hint">
        این موارد هنوز مستندی (بیتی از یک شعر که آنها را بیان می‌کند) ندارند. برای هر مورد می‌توانید مستند پیشنهاد دهید؛ پس از تأیید مدیران ثبت می‌شود.
        @Model.TotalCount.ToString("N0") مورد@(Model.PersonId.HasValue ? " برای این شخصیت" : "")
        @if (Model.PersonId.HasValue)
        {
            <a href="/User/RelationsWithoutEvidence@(Model.Affiliations ? "?affiliations=true" : "")">نمایش همه</a>
        }
    </p>

    <div class="up-card">
        <table>
            <tr>
                <th>#</th>
                <th>شخصیت اول</th>
                <th>نسبت</th>
                <th>شخصیت دوم</th>
                <th></th>
            </tr>
            @for (int i = 0; i < Model.Rows.Length; i++)
            {
                var r = Model.Rows[i];
                <tr>
                    <td>@(Model.Skip + i + 1)</td>
                    <td><a href="javascript:void(0)" onclick="PersonWindow.open(@r.Person1Id)">@r.Person1Name</a></td>
                    <td>@(r.IsAffiliation ? AffiliationTypeName(r.AffiliationType) : RelationTypeName(r))</td>
                    <td><a href="javascript:void(0)" onclick="PersonWindow.open(@r.Person2Id)">@r.Person2Name</a></td>
                    <td>
                        <a href="/User/SuggestPersonRelationEdit?@(r.IsAffiliation ? "affiliationId" : "relationId")=@r.RelationId" class="up-btn up-btn--ghost up-btn--sm">افزودن مستند</a>
                        @if (r.PendingEvidenceSuggestions > 0)
                        {
                            <small>(@r.PendingEvidenceSuggestions پیشنهاد در انتظار بررسی)</small>
                        }
                    </td>
                </tr>
            }
        </table>
    </div>

    <p>
        @if (Model.Skip > 0)
        {
            <a href="/User/RelationsWithoutEvidence?skip=@(Math.Max(Model.Skip - Model.PageSize, 0))@personFilter">« قبلی</a>
        }
        @if (Model.Skip + Model.PageSize < Model.TotalCount)
        {
            <a href="/User/RelationsWithoutEvidence?skip=@(Model.Skip + Model.PageSize)@personFilter">بعدی »</a>
        }
    </p>
}
