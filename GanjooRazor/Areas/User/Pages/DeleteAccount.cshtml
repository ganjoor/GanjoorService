@page
@model GanjooRazor.Areas.User.Pages.DeleteAccountModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_UserPanelLayout";
    ViewData["Title"] = "حذف حساب کاربری";
    await GanjooRazor.Utils.GanjoorSessionChecker.ApplyPermissionsToViewData(Request, Response, ViewData);
}
<div class="up-page-header">
    <h1>@ViewData["Title"]</h1>
</div>

@if (Model.Step1)
{
    <div class="up-card up-danger-zone">
        <h2 class="up-card__title">این عملیات غیرقابل بازگشت است</h2>
        <div class="up-alert up-alert--warning">
            در صورتی که کاربری تصمیم بگیرد حساب کاربری خود را در گنجور حذف کند تمام حاشیه‌ها و خوانش‌های منتشر شده‌اش در گنجور نیز حذف خواهد شد. علاوه بر آن رکوردهای بخش‌هایی از مشارکت کاربر که در گنجور اثر غیرقابل حذف گذاشته است (مثل ویرایش متن اشعار یا پیشنهاد تصاویر مرتبط با اشعار) به حساب کاربری سیستمی گنجور منتقل می‌شود. عملیات حذف کاربر غیرقابل برگشت است و در صورتی که کاربر با ایمیلی که پیشتر در گنجور حساب کاربری داشته و آن را حذف کرده مجدداً نام‌نویسی کند هیچ‌کدام از اطلاعات پیشتر واردشده‌اش بازنخواهد گشت.
        </div>
        <div class="up-alert up-alert--danger">
            <strong>تبصره:</strong> گنجور ممکن است فهرست کاربران بدرفتار (کاربرانی که به ارسال مداوم حاشیه‌های نامناسب یا خرابکاری در سایت می‌پردازند) را به همراه گزارشی از فعالیت‌های نامناسب آنها نگهداری کند تا برخی یا همهٔ فعالیت‌های آنها محدود شود. ایمیل کاربر در این فهرست با حذف حساب کاربری حذف نمی‌شود و در صورت ثبت‌نام مجدد این اطلاعات مجدداً مورد مراجعه قرار خواهد گرفت.
        </div>

        <form method="post" asp-page-handler="SendEmail" class="up-form">
            <p class="up-hint">برای حذف حساب کاربری باید گذرواژهٔ خود را در کادر زیر وارد کنید. پس از ورود گذرواژه یک رمز به ایمیلتان ارسال می‌شود که با ورود رمز دریافتی حساب کاربریتان حذف خواهد شد.</p>

            <div class="up-field">
                <label asp-for="DeleteViewModel.Password">گذرواژه</label>
                <input type="password" asp-for="DeleteViewModel.Password" />
            </div>

            @if (!string.IsNullOrEmpty(Model.FatalError))
            {
                <div class="up-alert up-alert--danger">@Model.FatalError</div>
            }

            <div class="up-form-actions">
                <button type="submit" name="approve" id="approve" class="up-btn up-btn--danger">بررسی گذرواژه و ارسال ایمیل تأیید</button>
            </div>
        </form>
    </div>
}
else
{
    <div class="up-card up-danger-zone">
        <h2 class="up-card__title">تأیید نهایی</h2>
        <p class="up-hint">لطفاً پست الکترونیکی خود را بررسی کنید. در صورتی که نشانی پست الکترونیکی خود را درست وارد کرده باشید نامه‌ای از گنجور دریافت کرده‌اید که حاوی یک رمز است. رمز دریافتی را در کادر زیر وارد کرده و روی دکمهٔ «حذف نهایی حساب کاربری» کلیک کنید.</p>
        <p class="up-hint up-hint--danger">تذکر: ممکن است نامه به پوشهٔ اسپم منتقل شده باشد.</p>

        <form method="post" asp-page-handler="FinalizeDelete" class="up-form">
            <div class="up-field up-field--ltr">
                <label asp-for="Secret">رمز دریافتی</label>
                <input asp-for="Secret" placeholder="رمز دریافتی" />
            </div>

            @if (!string.IsNullOrEmpty(Model.FatalError))
            {
                <div class="up-alert up-alert--danger">@Model.FatalError</div>
            }

            <div class="up-form-actions">
                <button type="submit" name="submit" id="submit" class="up-btn up-btn--danger">حذف نهایی حساب کاربری</button>
            </div>
        </form>
    </div>
}
