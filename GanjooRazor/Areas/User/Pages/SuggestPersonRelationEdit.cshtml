@page
@model GanjooRazor.Areas.User.Pages.SuggestPersonRelationEditModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using RMuseum.Models.Ganjoor
@{
    Layout = "_UserPanelLayout";
    bool isAffiliation = Model.Kind == PersonRelationSuggestionKind.Affiliation;
    var currentEvidence = isAffiliation ? Model.Affiliation.Evidence : Model.Relation.Evidence;
    ViewData["Title"] = isAffiliation ? "پیشنهاد ویرایش وابستگی" : "پیشنهاد ویرایش نسبت خویشاوندی";
    await GanjooRazor.Utils.GanjoorSessionChecker.ApplyPermissionsToViewData(Request, Response, ViewData);
    // "meaning" sentence of every type, {a} = first person, {b} = second person (same direction convention as the stored edge)
    var affiliationOptions = new (PersonAffiliationType Type, string Tpl)[]
    {
        (PersonAffiliationType.Minister, "«{a}» وزیر/کارگزار «{b}» بوده است"),
        (PersonAffiliationType.Advisor, "«{a}» مشاور «{b}» بوده است"),
        (PersonAffiliationType.Courtier, "«{a}» درباری/همراه «{b}» بوده است"),
        (PersonAffiliationType.Servant, "«{a}» خدمتگزار «{b}» بوده است"),
        (PersonAffiliationType.Patron, "«{a}» حامی «{b}» بوده است"),
        (PersonAffiliationType.Successor, "«{a}» جانشین «{b}» شده است"),
        (PersonAffiliationType.Panegyrized, "«{a}» «{b}» را مدح کرده است"),
        (PersonAffiliationType.Satirized, "«{a}» «{b}» را هجو کرده است"),
        (PersonAffiliationType.MilitaryCommander, "«{a}» سردار «{b}» بوده است"),
        (PersonAffiliationType.Champion, "«{a}» پهلوان «{b}» بوده است"),
        (PersonAffiliationType.Ally, "«{a}» و «{b}» متحد/هم‌پیمان‌اند"),
        (PersonAffiliationType.Rival, "«{a}» و «{b}» رقیب/دشمن یکدیگرند"),
        (PersonAffiliationType.Companion, "«{a}» و «{b}» همراه/همدم یکدیگرند"),
        (PersonAffiliationType.Contemporary, "«{a}» و «{b}» هم‌عصرند (بدون نسبت دیگر)"),
        (PersonAffiliationType.Killer, "«{a}» «{b}» را کشته است"),
        (PersonAffiliationType.Other, "نوع دیگر (در یادداشت توضیح دهید)"),
    };
    var relationOptions = new (PersonRelationType Type, string Tpl)[]
    {
        (PersonRelationType.Parent, "«{a}» پدر/مادر «{b}» است"),
        (PersonRelationType.Sibling, "«{a}» و «{b}» خواهر/برادرند"),
        (PersonRelationType.Spouse, "«{a}» و «{b}» همسرند"),
        (PersonRelationType.Ancestor, "«{a}» نیای «{b}» است"),
    };
    string FillNames(string tpl) => tpl.Replace("{a}", Model.Person1Name).Replace("{b}", Model.Person2Name);
    string formAction = isAffiliation
        ? $"/User/SuggestPersonRelationEdit?affiliationId={Model.Affiliation.Id}&Handler=SuggestEdit"
        : $"/User/SuggestPersonRelationEdit?relationId={Model.Relation.Id}&Handler=SuggestEdit";
}
@if (!string.IsNullOrEmpty(Model.LastError))
{
    <div class="up-alert up-alert--danger">@Model.LastError</div>
}
else
{
    <div class="up-page-header">
        <h1>
            @(isAffiliation ? "پیشنهاد ویرایش وابستگی:" : "پیشنهاد ویرایش نسبت:")
            <a href="javascript:void(0)" onclick="PersonWindow.open(@Model.Person1Id)">@Model.Person1Name</a>
            و
            <a href="javascript:void(0)" onclick="PersonWindow.open(@Model.Person2Id)">@Model.Person2Name</a>
        </h1>
    </div>

    <p class="up-hint">
        این پیشنهاد مستقیماً اعمال نمی‌شود؛ پس از بررسی و تأیید توسط مدیران اعمال خواهد شد.
    </p>

    @if (!string.IsNullOrEmpty(Model.LastResult))
    {
        <p>@Html.Raw(Model.LastResult)</p>
    }

    <div class="up-card">
        <form method="post" action="@formAction">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Suggestion.ExistingRelationId" />
            <input type="hidden" asp-for="Suggestion.ExistingAffiliationId" />
            <input type="hidden" asp-for="Suggestion.Person1Id" />
            <input type="hidden" asp-for="Suggestion.Person2Id" />

            <table>
                <tr>
                    <td>نوع درخواست:</td>
                    <td>
                        <label><input type="radio" name="Action" value="Modify" checked="checked" /> @(isAffiliation ? "ویرایش این وابستگی" : "ویرایش این نسبت")</label>
                        &nbsp;
                        <label><input type="radio" name="Action" value="Remove" /> @(isAffiliation ? "حذف این وابستگی (اشتباه ثبت شده است)" : "حذف این نسبت (اشتباه ثبت شده است)")</label>
                        <br />
                        <label><input type="radio" name="Action" value="AddEvidence" /> افزودن مستند (بیتی از یک شعر که @(isAffiliation ? "این وابستگی" : "این نسبت") را بیان می‌کند)</label>
                        @if (currentEvidence != null && currentEvidence.Count > 0)
                        {
                            <br />
                            <label><input type="radio" name="Action" value="RemoveEvidence" /> حذف یکی از مستندهای ثبت‌شده (@(isAffiliation ? "وابستگی" : "نسبت") باقی می‌ماند)</label>
                        }
                    </td>
                </tr>
                @if (isAffiliation)
                {
                    <tr>
                        <td>نوع وابستگی:</td>
                        <td>
                            <select asp-for="Suggestion.SuggestedAffiliationType" id="edgeTypeSelect">
                                @foreach (var o in affiliationOptions)
                                {
                                    <option value="@((int)o.Type)" data-tpl="@o.Tpl">@FillNames(o.Tpl)</option>
                                }
                            </select>
                            <p class="up-hint"><small>هر گزینه با نام همین دو نفر و با جهتی که اکنون ثبت شده نوشته شده است. اگر جهت اشتباه ثبت شده است، گزینهٔ «جهت را برعکس کن» را در همین ردیف بزنید.</small></p>
                            @* reverse the stored direction instead of delete + add (directional types only; hidden by script for symmetric ones) *@
                            <div id="reverseRow">
                                <label><input type="checkbox" asp-for="Suggestion.ReverseDirection" id="reverseDirection" /> جهت را برعکس کن (جای «@Model.Person1Name» و «@Model.Person2Name» عوض شود)</label>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td>نوع نسبت:</td>
                        <td>
                            <select asp-for="Suggestion.SuggestedRelationType" id="edgeTypeSelect">
                                @foreach (var o in relationOptions)
                                {
                                    <option value="@((int)o.Type)" data-tpl="@o.Tpl">@FillNames(o.Tpl)</option>
                                }
                            </select>
                            <div id="reverseRow">
                                <label><input type="checkbox" asp-for="Suggestion.ReverseDirection" id="reverseDirection" /> جهت را برعکس کن (جای «@Model.Person1Name» و «@Model.Person2Name» عوض شود)</label>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            درجه (فقط برای نیا/نواده):
                            <p class="up-hint"><small>مثلاً برای پدربزرگ/مادربزرگ عدد ۲ را وارد کنید. اگر نمی‌دانید خالی بگذارید.</small></p>
                        </td>
                        <td><input asp-for="Suggestion.SuggestedDegreeHint" /></td>
                    </tr>
                    <tr>
                        <td>
                            تأیید سومین پدر/مادر:
                            <p class="up-hint"><small>فقط وقتی نوع نسبت را به «پدر/مادر و فرزند» تغییر می‌دهید و طرف فرزند هم‌اکنون دو پدر/مادر دارد کاربرد دارد.</small></p>
                        </td>
                        <td>
                            <label><input type="checkbox" asp-for="Suggestion.ConfirmedExtraParent" /> این سومین رابطهٔ پدر/مادری است و عمداً اضافه می‌شود</label>
                        </td>
                    </tr>
                }
                    <tr>
                        <td>
                            مستندهای ثبت‌شده:
                            <p class="up-hint"><small>هر نسبت یا وابستگی می‌تواند چند مستند داشته باشد؛ مستندها نشان می‌دهند این نسبت در کدام کتاب‌ها آمده است.</small></p>
                        </td>
                        <td>
                            @if (currentEvidence == null || currentEvidence.Count == 0)
                            {
                                <small>هنوز مستندی ثبت نشده است.</small>
                            }
                            else
                            {
                                foreach (var ev in currentEvidence)
                                {
                                    <div>
                                        <label>
                                            <input type="radio" name="Suggestion.ExistingEvidenceId" value="@ev.Id" />
                                            <a href="/?p=@ev.PoemId#bn@(ev.CoupletIndex + 1)" target="_blank">@(string.IsNullOrEmpty(ev.MasterCatTitle) ? "شعر " + ev.PoemId : ev.MasterCatTitle)</a>
                                            @if (ev.Inferred) { <span class="up-badge">حدسی</span> }
                                            <br /><small>@ev.CoupletText</small>
                                        </label>
                                    </div>
                                }
                                <p class="up-hint"><small>برای حذف مستند، گزینهٔ «حذف یکی از مستندها» را در بالا انتخاب و یکی از موارد بالا را علامت بزنید.</small></p>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td>
                            افزودن مستند جدید:
                            <p class="up-hint"><small>فقط برای گزینهٔ «افزودن مستند» کاربرد دارد: شعر را گزینش کنید و سپس بیت مورد نظر را از فهرست برگزینید.</small></p>
                        </td>
                        <td>
                            <partial name="_EvidencePicker" model="@("Suggestion.")" />
                        </td>
                    </tr>
                <tr>
                    <td>یادداشت (مستندسازی):</td>
                    <td><textarea asp-for="Suggestion.SuggestedNote" rows="3" cols="60"></textarea></td>
                </tr>
                <tr>
                    <td>یادداشت برای مدیر بررسی‌کننده:</td>
                    <td><textarea asp-for="Suggestion.SuggestionNote" rows="3" cols="60"></textarea></td>
                </tr>
            </table>

            <input type="submit" value="ثبت پیشنهاد" class="up-btn up-btn--success" />
            <a role="button" href="javascript:void(0)" onclick="history.back()" class="up-btn up-btn--ghost">انصراف</a>
        </form>
    </div>
    <script>
        (function () {
            var name1 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Person1Name));
            var name2 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Person2Name));
            var isAffiliation = @(isAffiliation ? "true" : "false");
            // symmetric types: Sibling, Spouse (family) / Ally, Rival, Companion, Contemporary (affiliation) - reversing makes no sense
            var symmetric = isAffiliation ? [4, 5, 7, 13] : [1, 2];
            var select = document.getElementById('edgeTypeSelect');
            var reverse = document.getElementById('reverseDirection');
            var row = document.getElementById('reverseRow');
            if (!select || !reverse || !row) return;
            function refresh() {
                var first = reverse.checked ? name2 : name1;
                var second = reverse.checked ? name1 : name2;
                for (var i = 0; i < select.options.length; i++) {
                    var tpl = select.options[i].getAttribute('data-tpl');
                    if (tpl) select.options[i].text = tpl.split('{a}').join(first).split('{b}').join(second);
                }
                var isSymmetric = symmetric.indexOf(parseInt(select.value, 10)) >= 0;
                row.style.display = isSymmetric ? 'none' : '';
                if (isSymmetric) reverse.checked = false;
            }
            select.addEventListener('change', refresh);
            reverse.addEventListener('change', refresh);
            refresh();
        })();
    </script>
}
