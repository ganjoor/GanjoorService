@page "{id:int}"
@model GanjooRazor.Pages.PersonWindowModel
@using DNTPersianUtils.Core
@{
    Layout = null;
}
@if (!string.IsNullOrEmpty(Model.LastError))
{
    <p>@Model.LastError</p>
}
else
{
    <div class="up-modal-person">
        <h2>
            @Model.Person.Name
            @if (Model.LoggedIn)
            {
                <a href="/User/SuggestPersonEdit?id=@Model.Person.Id" class="up-icon-btn" title="پیشنهاد ویرایش این نامبرده" aria-label="پیشنهاد ویرایش این نامبرده">✎</a>
            }
        </h2>

        @if (!string.IsNullOrEmpty(Model.Person.FamilyTreeCaption))
        {
            <p><strong>تبارنامه: @Model.Person.FamilyTreeCaption</strong></p>
        }

        @if (!string.IsNullOrEmpty(Model.Person.Aliases))
        {
            <p>نام‌های دیگر: @Model.Person.Aliases</p>
        }

        @if (Model.Person.BirthYearInLHijri != 0 || Model.Person.DeathYearInLHijri != 0)
        {
            <p>
                @if (Model.Person.BirthYearInLHijri != 0)
                {
                    <text>تولد: @Model.Person.BirthYearInLHijri.ToPersianNumbers() (قمری) @(Model.Person.ValidBirthDate ? "" : "- تخمینی")</text>
                }
                @if (Model.Person.DeathYearInLHijri != 0)
                {
                    <text> — وفات: @Model.Person.DeathYearInLHijri.ToPersianNumbers() (قمری) @(Model.Person.ValidDeathDate ? "" : "- تخمینی")</text>
                }
            </p>
        }

        @if (!string.IsNullOrEmpty(Model.Person.Description))
        {
            <p>@Model.Person.Description</p>
        }

        @if (!string.IsNullOrEmpty(Model.Person.WikiUrl))
        {
            <p><a href="@Model.Person.WikiUrl" target="_blank" rel="noopener">صفحهٔ ویکی‌پدیا</a></p>
        }

        @if (Model.EvidenceBooks.Count > 0)
        {
            <p class="pw-book-bar">
                <label>
                    فقط آنچه این کتاب می‌گوید:
                    <select onchange="PersonWindow.filterBook(this.value)">
                        <option value="">همهٔ کتاب‌ها</option>
                        @foreach (var b in Model.EvidenceBooks)
                        {
                            <option value="@b.Key">@b.Value</option>
                        }
                    </select>
                </label>
                <small class="up-hint">مواردی که مستندی ندارند همچنان نمایش داده می‌شوند.</small>
            </p>
        }

        @if (Model.RelationRows.Count > 0)
        {
            <h3>
                خویشاوندان
                <a href="javascript:void(0)" onclick="FamilyTreeWindow.open(@Model.Person.Id)" class="up-btn up-btn--ghost up-btn--sm">نمایش نمودار تبارنامه</a>
                <a href="javascript:void(0)" onclick="ContemporariesWindow.open(@Model.Person.Id)" class="up-btn up-btn--ghost up-btn--sm">هم‌عصران</a>
                @if (Model.LoggedIn)
                {
                    <a href="/User/SuggestNewPersonRelation?personId=@Model.Person.Id" class="up-btn up-btn--ghost up-btn--sm">افزودن خویشاوند جدید</a>
                }
            </h3>
            <ul>
                @foreach (var row in Model.RelationRows)
                {
                    <li data-pw-books="@PersonWindowModel.BooksAttr(row.Evidence)">
                        @row.Label — <a href="javascript:void(0)" onclick="PersonWindow.open(@row.OtherPersonId)">@row.OtherPersonName</a>
                        @if (!string.IsNullOrEmpty(row.Note))
                        {
                            <text> (@row.Note)</text>
                        }
                        @if (Model.LoggedIn)
                        {
                            <a href="/User/SuggestPersonRelationEdit?relationId=@row.RelationId" class="up-icon-btn" title="پیشنهاد ویرایش/حذف این نسبت" aria-label="پیشنهاد ویرایش/حذف این نسبت">✎</a>
                        }
                        @if (row.Evidence.Count > 0)
                        {
                            <details>
                                <summary><small>مستند (@row.Evidence.Count)</small></summary>
                                @foreach (var ev in row.Evidence)
                                {
                                    <div>
                                        <small>
                                            <a href="/?p=@ev.PoemId#bn@(ev.CoupletIndex + 1)" target="_blank">@(string.IsNullOrEmpty(ev.MasterCatTitle) ? "شعر " + ev.PoemId : ev.MasterCatTitle)</a>
                                            @if (ev.Inferred) { <text> (حدسی)</text> }
                                            — @ev.CoupletText
                                        </small>
                                    </div>
                                }
                            </details>
                        }
                    </li>
                }
            </ul>
        }
        else if (Model.LoggedIn)
        {
            <h3>
                خویشاوندان
                <a href="/User/SuggestNewPersonRelation?personId=@Model.Person.Id" class="up-btn up-btn--ghost up-btn--sm">افزودن خویشاوند جدید</a>
            </h3>
        }

        @if (Model.AffiliationRows.Count > 0)
        {
            <h3>
                وابستگی‌های غیرخویشاوندی
                @if (Model.RelationRows.Count == 0)
                {
                    <a href="javascript:void(0)" onclick="ContemporariesWindow.open(@Model.Person.Id)" class="up-btn up-btn--ghost up-btn--sm">هم‌عصران</a>
                }
                @if (Model.LoggedIn)
                {
                    <a href="/User/SuggestNewPersonRelation?personId=@Model.Person.Id&amp;kind=affiliation" class="up-btn up-btn--ghost up-btn--sm">افزودن وابستگی جدید</a>
                }
            </h3>
            <ul>
                @foreach (var row in Model.AffiliationRows)
                {
                    <li data-pw-books="@PersonWindowModel.BooksAttr(row.Evidence)">
                        @row.SentenceBeforeOtherName<a href="javascript:void(0)" onclick="PersonWindow.open(@row.OtherPersonId)">@row.OtherPersonName</a>@row.SentenceAfterOtherName
                        @if (!string.IsNullOrEmpty(row.Note))
                        {
                            <text> (@row.Note)</text>
                        }
                        @if (Model.LoggedIn)
                        {
                            <a href="/User/SuggestPersonRelationEdit?affiliationId=@row.AffiliationId" class="up-icon-btn" title="پیشنهاد ویرایش/حذف این وابستگی" aria-label="پیشنهاد ویرایش/حذف این وابستگی">✎</a>
                        }
                        @if (row.Evidence.Count > 0)
                        {
                            <details>
                                <summary><small>مستند (@row.Evidence.Count)</small></summary>
                                @foreach (var ev in row.Evidence)
                                {
                                    <div>
                                        <small>
                                            <a href="/?p=@ev.PoemId#bn@(ev.CoupletIndex + 1)" target="_blank">@(string.IsNullOrEmpty(ev.MasterCatTitle) ? "شعر " + ev.PoemId : ev.MasterCatTitle)</a>
                                            — @ev.CoupletText
                                        </small>
                                    </div>
                                }
                            </details>
                        }
                    </li>
                }
            </ul>
        }
        else if (Model.LoggedIn)
        {
            <h3>
                وابستگی‌های غیرخویشاوندی
                <a href="/User/SuggestNewPersonRelation?personId=@Model.Person.Id&amp;kind=affiliation" class="up-btn up-btn--ghost up-btn--sm">افزودن وابستگی جدید</a>
            </h3>
        }

        @if (Model.Poems != null && Model.Poems.Length > 0)
        {
            <h3>
                @(Model.CatId != null ? "اشعار این بخش که این نامبرده در آن‌ها برچسب خورده" : "اشعار برچسب‌خورده با این نامبرده")
                @if (Model.CatId != null)
                {
                    <a href="javascript:void(0)" onclick="PersonWindow.open(@Model.Person.Id)" class="up-btn up-btn--ghost up-btn--sm">نمایش اشعار همهٔ کتاب‌ها</a>
                }
            </h3>
            var allusionTags = Model.Poems.Where(t => t.Poem != null && t.PersonMention == RMuseum.Models.Ganjoor.PersonMentionKind.Allusion).ToList();
            <ul>
                @foreach (var tag in Model.Poems.Where(t => t.PersonMention != RMuseum.Models.Ganjoor.PersonMentionKind.Allusion))
                {
                    if (tag.Poem != null)
                    {
                        <li>
                            <a href="@(tag.CoupletIndex > 0 ? tag.Poem.FullUrl + "#bn" + (tag.CoupletIndex + 1) : tag.Poem.FullUrl)">@tag.Poem.FullTitle</a>
                            @if (!string.IsNullOrEmpty(tag.CoupletText))
                            {
                                <p>@tag.CoupletText</p>
                            }
                            @if (!string.IsNullOrEmpty(tag.Note))
                            {
                                <p class="up-hint"><small>یادداشت: @tag.Note</small></p>
                            }
                        </li>
                    }
                }
            </ul>
            @if (allusionTags.Count > 0)
            {
                <details>
                    <summary><small>اشعاری که فقط به این نامبرده اشاره دارند (@allusionTags.Count)</small></summary>
                    <ul>
                        @foreach (var tag in allusionTags)
                        {
                            <li>
                                <a href="@(tag.CoupletIndex > 0 ? tag.Poem.FullUrl + "#bn" + (tag.CoupletIndex + 1) : tag.Poem.FullUrl)">@tag.Poem.FullTitle</a>
                                @if (!string.IsNullOrEmpty(tag.CoupletText))
                                {
                                    <p>@tag.CoupletText</p>
                                }
                            </li>
                        }
                    </ul>
                </details>
            }
        }
        else
        {
            <p><small>@(Model.CatId != null ? "در این بخش شعری با این نامبرده برچسب‌گذاری نشده است." : "هنوز شعری با این نامبرده برچسب‌گذاری نشده است.")</small></p>
            @if (Model.CatId != null)
            {
                <p><a href="javascript:void(0)" onclick="PersonWindow.open(@Model.Person.Id)" class="up-btn up-btn--ghost up-btn--sm">نمایش اشعار همهٔ کتاب‌ها</a></p>
            }
        }
    </div>
}
