@model GanjooRazor.Pages._LiteraryStatsPartialModel
@using DNTPersianUtils.Core
@if (Model.Failed || Model.Overview == null)
{
    @if (!Model.Scoped)
    {
        <p>در دریافت آمار آرایه‌های ادبی خطایی رخ داد.</p>
    }
    return;
}
@if (Model.Overview.TotalTags == 0)
{
    @if (!Model.Scoped)
    {
        <div id="literary-stats-section">
            <h2>آرایه‌های ادبی</h2>
            <p>هنوز آرایه‌ای ثبت نشده است.</p>
        </div>
    }
    return;
}
<div id="literary-stats-section" class="lit-stats-section">
    @if (Model.Scoped)
    {
        <h3>آرایه‌های ادبی</h3>
    }
    else
    {
        <h2>آرایه‌های ادبی</h2>
    }
    <p>
        تاکنون @Model.Overview.TotalTags.ToPersianNumbers() آرایه در @Model.Overview.TotalPoems.ToPersianNumbers() شعر برچسب‌گذاری شده است.
        روی نام هر آرایه یا مفهوم بزنید تا نمونه‌هایش را ببینید.
    </p>

    <table class="lit-stats-table">
        <tr><th>آرایه</th><th>تعداد</th><th>شعر</th></tr>
        @foreach (var d in Model.Overview.Devices)
        {
            @if (Model.DevicesById.TryGetValue(d.DeviceId, out var device))
            {
                <tr>
                    <td><a href="/literary?device=@d.DeviceId@Model.FilterQuery" title="@device.Definition">@device.Name</a></td>
                    <td>@d.TagCount.ToPersianNumbers()</td>
                    <td>@d.PoemCount.ToPersianNumbers()</td>
                </tr>
            }
        }
    </table>

    @if (Model.Overview.TopConcepts != null && Model.Overview.TopConcepts.Length > 0)
    {
        <h3>پرکاربردترین مفهوم‌ها</h3>
        <ul class="lit-stats-concepts">
            @foreach (var c in Model.Overview.TopConcepts)
            {
                <li><a href="/literary?concept=@c.ConceptId@Model.FilterQuery">@c.Name</a> <span>@c.UsageCount.ToPersianNumbers()</span></li>
            }
        </ul>
    }
</div>
