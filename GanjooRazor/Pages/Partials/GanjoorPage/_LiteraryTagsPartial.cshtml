@model GanjooRazor.Pages._LiteraryTagsPartialModel
@if (Model.Failed)
{
    <p data-lit-failed="1">در دریافت آرایه‌ها خطایی رخ داد.</p>
    return;
}
@if (Model.Couplets.Count == 0)
{
    <div class="lit-guide" data-lit-empty="1">
        <p>برای این شعر هنوز آرایه‌ای ثبت نشده است. اگر آرایه‌ای در آن می‌بینید، می‌توانید آن را پیشنهاد دهید:</p>
        <ol>
            <li>پس از ورود به حساب کاربری، <a href="/User/Editor?id=@Model.PoemId#literary-section">ویرایشگر همین شعر</a> را باز کنید و به بخش «آرایه‌های ادبی» بروید.</li>
            <li>بیت مورد نظر و نوع آرایه (مثلاً تشبیه، استعاره، کنایه یا جناس) را از فهرست انتخاب کنید.</li>
            <li>برای هر جایگاه آرایه (مثلاً مشبّه و مشبّه‌به)، در متن بیت ابتدا اولین و سپس آخرین واژهٔ بخش مربوط را انتخاب کنید؛ جایگاه‌های مفهومی را با نامی کوتاه و عمومی پر کنید.</li>
            <li>«افزودن به فهرست پیشنهادها» را بزنید و در پایان با دکمهٔ «ذخیره» پیشنهادتان را ثبت کنید.</li>
            <li>اگر آرایه‌ای که می‌خواهید در فهرست نیست، آخرین گزینهٔ فهرست آرایه‌ها («تعریف آرایهٔ جدید») را بزنید و آن را تعریف کنید.</li>
        </ol>
        <p>پیشنهادها پس از بررسی ناظران در همین بخش نمایش داده می‌شوند.</p>
    </div>
    return;
}
<div class="lit-reader" id="lit-reader-@Model.PoemId">
    @foreach (var couplet in Model.Couplets)
    {
        <div class="lit-couplet">
            @if (couplet.Number > 0)
            {
                <div class="lit-text">
                    <a href="#bn@(couplet.Number)" class="lit-num">@couplet.Number</a>
                    @if (couplet.Words1.Count > 0)
                    {
                        <span class="lit-m">
                            @foreach (var w in couplet.Words1)
                            {
                                <span class="lit-w" data-m="1" data-i="@w.Index">@w.Text</span>@:&#32;
                            }
                        </span>
                        <span class="lit-m">
                            @foreach (var w in couplet.Words2)
                            {
                                <span class="lit-w" data-m="2" data-i="@w.Index">@w.Text</span>@:&#32;
                            }
                        </span>
                    }
                </div>
            }
            else
            {
                <div class="lit-text"><strong>کل شعر</strong></div>
            }
            @foreach (var tag in couplet.Tags)
            {
                <div class="lit-tag" data-spans="@tag.Spans" tabindex="0" role="button">
                    <span class="lit-dev" title="@tag.Definition">@tag.DeviceName</span>
                    @if (tag.Uncertain)
                    {
                        <span class="lit-unc">(نامطمئن)</span>
                    }
                    @if (!string.IsNullOrEmpty(tag.SourceKey))
                    {
                        <a class="lit-src" href="javascript:void(0)" title="منبع این آرایه" data-src="@tag.SourceKey" onclick="event.stopPropagation(); LiteraryTagSourceWindow.open(this.getAttribute('data-src')); return false;">@tag.SourceName</a>
                    }
                    <div class="lit-lines">
                        @foreach (var line in tag.Lines)
                        {
                            <div><span class="lit-slot">@line.Slot:</span> @line.Value</div>
                        }
                        @if (!string.IsNullOrEmpty(tag.Note))
                        {
                            <div class="lit-note">@tag.Note</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    @foreach (var source in Model.Sources)
    {
        <p class="lit-hint">بخشی از آرایه‌ها از «<a href="javascript:void(0)" data-src="@source.Key" onclick="LiteraryTagSourceWindow.open(this.getAttribute('data-src')); return false;">@source.Title</a>» برگرفته شده است.</p>
    }
</div>
