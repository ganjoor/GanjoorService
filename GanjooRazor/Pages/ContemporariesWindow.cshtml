@page "{id:int}"
@model GanjooRazor.Pages.ContemporariesWindowModel
@{
    Layout = null;
}
@if (!string.IsNullOrEmpty(Model.LastError))
{
    <p>@Model.LastError</p>
}
else
{
    <div class="up-modal-contemporaries">
        <h2>
            هم‌عصران @(string.IsNullOrEmpty(Model.RootPerson.FamilyTreeCaption) ? Model.RootPerson.Name : Model.RootPerson.FamilyTreeCaption)
            <a href="javascript:void(0)" onclick="PersonWindow.open(@Model.RootPerson.Id)" class="up-btn up-btn--ghost up-btn--sm">مشاهدهٔ اطلاعات این شخصیت</a>
        </h2>

        <div class="ct-controls">
            @if (Model.Timeline != null && Model.Timeline.Books != null && Model.Timeline.Books.Count > 1)
            {
                <select id="ctw-book" onchange="ContemporariesWindow.open(@Model.RootPerson.Id, this.value)">
                    @foreach (var b in Model.Timeline.Books)
                    {
                        <option value="@b.MasterCatId" selected="@(b.MasterCatId == Model.Timeline.MasterCatId)">@b.Title</option>
                    }
                </select>
            }
            <label><input type="checkbox" id="ctw-all" /> نمایش همهٔ شخصیت‌های این کتاب</label>
            <span id="ctw-note" class="ct-note"></span>
        </div>

        <div id="ctw-container" class="ct-scroll"></div>

        <style>
            .ct-controls { margin: 8px 0; font-size: 13px; display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
            .ct-note { color: #7a6a50; }
            .ct-scroll { width: 100%; max-height: 70vh; overflow: auto; border: 1px solid #d8cdb8; border-radius: 6px; background: #faf7f0; box-sizing: border-box; -webkit-overflow-scrolling: touch; }
            table.ct-table { border-collapse: separate; border-spacing: 0; font-size: 12px; }
            .ct-table th, .ct-table td { padding: 0; border-bottom: 1px solid #efe6d2; }
            .ct-table thead th { position: sticky; top: 0; z-index: 2; background: #f1e9d6; height: 110px; min-width: 30px; width: 30px; vertical-align: bottom; border-left: 1px solid #e0d5bc; }
            .ct-table thead th span { display: block; writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; margin: 4px auto; font-weight: 700; color: #5b4a2e; max-height: 100px; overflow: hidden; }
            .ct-table th.ct-name, .ct-table td.ct-name { position: sticky; right: 0; z-index: 3; background: #faf7f0; min-width: 120px; max-width: 160px; padding: 3px 8px; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-left: 1px solid #e0d5bc; }
            .ct-table thead th.ct-name { background: #f1e9d6; z-index: 4; }
            .ct-table td.ct-cell { min-width: 30px; width: 30px; height: 26px; position: relative; border-left: 1px solid #f3ecdb; }
            .ct-table td.ct-cell.band { background: #f4ead0; }
            .ct-table td.ct-cell i { position: absolute; left: 0; right: 0; top: 50%; border-top: 3px solid transparent; transform: translateY(-50%); }
            .ct-table td.ct-cell.on i { border-top: 4px solid var(--c); }
            .ct-table td.ct-cell.on i::after { content: ''; position: absolute; top: -6px; width: 8px; height: 8px; border-radius: 50%; background: var(--c); right: calc(50% - 4px); }
            .ct-table td.ct-cell.gap i { border-top: 2px dashed var(--c); opacity: .6; }
            .ct-table td.ct-cell.end-left i { left: 50%; }
            .ct-table td.ct-cell.start-right i { right: 50%; }
            .ct-table tr.focus td.ct-name { font-weight: 700; }
            .ct-tree { text-decoration: none; margin-right: 4px; cursor: pointer; }
        </style>

        <script type="application/json" id="ctw-data">@Html.Raw(Model.TimelineJson)</script>
        <input type="hidden" id="ctw-root-id" value="@Model.RootPerson.Id" />
    </div>
}
