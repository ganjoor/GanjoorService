@page "{id:int}"
@model GanjooRazor.Pages.SuggestPersonEditModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "گنجور » پیشنهاد ویرایش شخصیت";
}
@section Head {
    <meta name="robots" content="noindex, nofollow" />
}
@if (!string.IsNullOrEmpty(Model.LastError))
{
    @Model.LastError
}
else
{
    <!-- #hdr2 -->

    <div id="fa">

        <div id="maincnt">

            <partial name="_InlineLoginPartial" model="Model" />

            <div class="spacer">&nbsp;</div>

            <div class="poem">
                <h1>پیشنهاد ویرایش: @Model.Person.Name</h1>

                <p class="up-hint">
                    این پیشنهاد مستقیماً اعمال نمی‌شود؛ پس از بررسی و تأیید توسط مدیران، در مشخصات
                    <a href="/person/@Model.Person.Id">@Model.Person.Name</a> اعمال خواهد شد.
                </p>

                @if (!string.IsNullOrEmpty(Model.LastResult))
                {
                    <p>@Html.Raw(Model.LastResult)</p>
                }

                <form method="post" action="/SuggestPersonEdit/@Model.Person.Id?Handler=SuggestEdit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Suggestion.PersonId" />

                    <table>
                        <tr>
                            <td>نام:</td>
                            <td><input asp-for="Suggestion.SuggestedName" size="40" /></td>
                        </tr>
                        <tr>
                            <td>نشانی ویکی‌پدیا:</td>
                            <td><input style="text-align:left;direction:ltr;" asp-for="Suggestion.SuggestedWikiUrl" size="60" /></td>
                        </tr>
                        <tr>
                            <td>زاده:</td>
                            <td><input asp-for="Suggestion.SuggestedBirthYearInLHijri" /> (قمری)</td>
                        </tr>
                        <tr>
                            <td>تاریخ تولد مستند است:</td>
                            <td><input asp-for="Suggestion.SuggestedValidBirthDate" /></td>
                        </tr>
                        <tr>
                            <td>زادگاه:</td>
                            <td>
                                <select asp-for="Suggestion.SuggestedBirthLocationId">
                                    @foreach (var location in Model.Locations)
                                    {
                                        <option value="@(location.Id == 0 ? "" : location.Id.ToString())">@location.Name</option>
                                    }
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td>درگذشته:</td>
                            <td><input asp-for="Suggestion.SuggestedDeathYearInLHijri" /> (قمری)</td>
                        </tr>
                        <tr>
                            <td>تاریخ وفات مستند است:</td>
                            <td><input asp-for="Suggestion.SuggestedValidDeathDate" /></td>
                        </tr>
                        <tr>
                            <td>آرامگاه:</td>
                            <td>
                                <select asp-for="Suggestion.SuggestedDeathLocationId">
                                    @foreach (var location in Model.Locations)
                                    {
                                        <option value="@(location.Id == 0 ? "" : location.Id.ToString())">@location.Name</option>
                                    }
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                عنوان شجره‌نامه:
                                <p class="up-hint"><small>پُر کنید تا این شخصیت روی <a href="/people" target="_blank">صفحهٔ شجره‌نامه‌ها</a> با این عنوان فهرست شود.</small></p>
                            </td>
                            <td><input asp-for="Suggestion.SuggestedFamilyTreeCaption" size="40" /></td>
                        </tr>
                        <tr>
                            <td>توضیحات:</td>
                            <td><textarea asp-for="Suggestion.SuggestedDescription" rows="10" cols="60"></textarea></td>
                        </tr>
                        <tr>
                            <td>یادداشت برای مدیر بررسی‌کننده:</td>
                            <td><textarea asp-for="Suggestion.SuggestionNote" rows="3" cols="60"></textarea></td>
                        </tr>
                    </table>

                    <input type="submit" value="ثبت پیشنهاد" class="up-btn up-btn--success" />
                    <a role="button" href="/person/@Model.Person.Id" class="up-btn up-btn--ghost">انصراف</a>
                </form>
            </div>

            <div class="spacer">&nbsp;</div>

        </div>

        <partial name="_FooterPartial" model=@(new _FooterPartialModel(){StickyEnabled = true}) />

    </div>

    @if (ViewData["TrackingScript"] != null && !string.IsNullOrEmpty(ViewData["TrackingScript"].ToString()))
    {
        @Html.Raw(ViewData["TrackingScript"])
    }
}
