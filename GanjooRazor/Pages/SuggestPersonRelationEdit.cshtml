@page "{relationId:int}"
@model GanjooRazor.Pages.SuggestPersonRelationEditModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using RMuseum.Models.Ganjoor
@{
    Layout = "_Layout";
    ViewData["Title"] = "گنجور » پیشنهاد ویرایش نسبت خویشاوندی";
}
@section Head {
    <meta name="robots" content="noindex, nofollow" />
}
@if (!string.IsNullOrEmpty(Model.LastError))
{
    @Model.LastError
}
else
{
    <!-- #hdr2 -->

    <div id="fa">

        <div id="maincnt">

            <partial name="_InlineLoginPartial" model="Model" />

            <div class="spacer">&nbsp;</div>

            <div class="poem">
                <h1>
                    پیشنهاد ویرایش نسبت:
                    <a href="/person/@Model.Relation.Person1Id">@(Model.Relation.Person1 != null ? Model.Relation.Person1.Name : Model.Relation.Person1Id.ToString())</a>
                    و
                    <a href="/person/@Model.Relation.Person2Id">@(Model.Relation.Person2 != null ? Model.Relation.Person2.Name : Model.Relation.Person2Id.ToString())</a>
                </h1>

                <p class="up-hint">
                    این پیشنهاد مستقیماً اعمال نمی‌شود؛ پس از بررسی و تأیید توسط مدیران اعمال خواهد شد.
                </p>

                @if (!string.IsNullOrEmpty(Model.LastResult))
                {
                    <p>@Html.Raw(Model.LastResult)</p>
                }

                <form method="post" action="/SuggestPersonRelationEdit/@Model.Relation.Id?Handler=SuggestEdit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Suggestion.ExistingRelationId" />
                    <input type="hidden" asp-for="Suggestion.Person1Id" />
                    <input type="hidden" asp-for="Suggestion.Person2Id" />

                    <table>
                        <tr>
                            <td>نوع درخواست:</td>
                            <td>
                                <label><input type="radio" name="Action" value="Modify" checked="checked" /> ویرایش این نسبت</label>
                                &nbsp;
                                <label><input type="radio" name="Action" value="Remove" /> حذف این نسبت (اشتباه ثبت شده است)</label>
                            </td>
                        </tr>
                        <tr>
                            <td>نوع نسبت:</td>
                            <td>
                                <select asp-for="Suggestion.SuggestedRelationType">
                                    <option value="@((int)PersonRelationType.Parent)">پدر/مادر و فرزند (طرف اول، پدر/مادر است)</option>
                                    <option value="@((int)PersonRelationType.Sibling)">خواهر/برادر</option>
                                    <option value="@((int)PersonRelationType.Spouse)">همسر</option>
                                    <option value="@((int)PersonRelationType.Ancestor)">نیا و نواده (طرف اول، نیاست)</option>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                درجه (فقط برای نیا/نواده):
                                <p class="up-hint"><small>مثلاً برای پدربزرگ/مادربزرگ عدد ۲ را وارد کنید. اگر نمی‌دانید خالی بگذارید.</small></p>
                            </td>
                            <td><input asp-for="Suggestion.SuggestedDegreeHint" /></td>
                        </tr>
                        <tr>
                            <td>یادداشت (مستندسازی):</td>
                            <td><textarea asp-for="Suggestion.SuggestedNote" rows="3" cols="60"></textarea></td>
                        </tr>
                        <tr>
                            <td>یادداشت برای مدیر بررسی‌کننده:</td>
                            <td><textarea asp-for="Suggestion.SuggestionNote" rows="3" cols="60"></textarea></td>
                        </tr>
                    </table>

                    <input type="submit" value="ثبت پیشنهاد" class="up-btn up-btn--success" />
                    <a role="button" href="/person/@Model.Relation.Person1Id" class="up-btn up-btn--ghost">انصراف</a>
                </form>
            </div>

            <div class="spacer">&nbsp;</div>

        </div>

        <partial name="_FooterPartial" model=@(new _FooterPartialModel(){StickyEnabled = true}) />

    </div>

    @if (ViewData["TrackingScript"] != null && !string.IsNullOrEmpty(ViewData["TrackingScript"].ToString()))
    {
        @Html.Raw(ViewData["TrackingScript"])
    }
}
